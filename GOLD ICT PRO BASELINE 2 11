GRP_M11_1 = "Module 11.1 - Live Recommendation Panel"
bool show_m11_1_panel = input.bool(true, "Show Live Recommendation Panel", group=GRP_M11_1)

var table m11_1_table = table.new(position.top_center, 2, 8, bgcolor=color.new(color.black, 10), border_width=1, border_color=color.new(color.gray, 60))

f_m11_1_status_from_exit(bool registryEmpty, string exitReasonVal) =>
    string result = "WAIT"
    if registryEmpty
        result := "WAIT"
    else if exitReasonVal == ""
        result := "ACTIVE"
    else if exitReasonVal == "TP_HIT"
        result := "TP_HIT"
    else if exitReasonVal == "SL_HIT"
        result := "SL_HIT"
    else if exitReasonVal == "EXPIRED_NO_RESOLUTION"
        result := "EXPIRED"
    else
        result := "UNKNOWN"
    result

f_m11_1_status_color(string statusVal) =>
    color result = color.gray
    if statusVal == "ACTIVE"
        result := color.green
    else if statusVal == "TP_HIT"
        result := color.new(color.teal, 0)
    else if statusVal == "SL_HIT"
        result := color.red
    else
        result := color.gray
    result

f_m11_1_action_color(string actionVal) =>
    actionVal == "BUY" ? color.green : actionVal == "SELL" ? color.red : color.gray

f_m11_1_risk_color(string riskVal) =>
    riskVal == "Low" ? color.green : riskVal == "Medium" ? color.yellow : riskVal == "High" ? color.red : color.gray

f_m11_1_render(EngineState st) =>
    if show_m11_1_panel and barstate.islast
        bool registryEmpty = array.size(g_trade_rec_registry) == 0
        string exitReasonVal = ""
        if not registryEmpty
            TradeRecommendationInstance latestRec = array.get(g_trade_rec_registry, array.size(g_trade_rec_registry) - 1)
            exitReasonVal := latestRec.exitReason

