        array.shift(g_mss_registry)

f_compute_mss() =>
    bool integ = f_check_p8_integ() and f_mtf_all_ok()
    if integ and barstate.islastconfirmedhistory
        float disp_close_pct = 0.25
        float min_swing_atr = 0.5
        
        if str.contains(struct_logs, "CHoCH (Bullish)")
            float trig_px = g_last_swing_high_price
            float trig_rg = high - low
            float disp_dist = math.abs(close - trig_px)
            float disp_str = g_current_context.atr == 0 ? 0.0 : disp_dist / g_current_context.atr
            
            bool valid_disp = close >= (low + (trig_rg * disp_close_pct))
            bool valid_dist = disp_dist >= (min_swing_atr * g_current_context.atr)
            
            if valid_disp and valid_dist
                bool brk_cand = f_check_breaker_candidate(bar_index, TD_LONG)
                f_mss_create(TD_LONG, trig_px, trig_rg, disp_str, brk_cand)
                
        else if str.contains(struct_logs, "CHoCH (Bearish)")
            float trig_px = g_last_swing_low_price
            float trig_rg = high - low
            float disp_dist = math.abs(close - trig_px)
            float disp_str = g_current_context.atr == 0 ? 0.0 : disp_dist / g_current_context.atr
            
            bool valid_disp = close <= (high - (trig_rg * disp_close_pct))
            bool valid_dist = disp_dist >= (min_swing_atr * g_current_context.atr)
            
            if valid_disp and valid_dist
                bool brk_cand = f_check_breaker_candidate(bar_index, TD_SHORT)
                f_mss_create(TD_SHORT, trig_px, trig_rg, disp_str, brk_cand)
                
        int sz = array.size(g_mss_base_id)
        if sz > 0
            for i = 0 to sz - 1
                string state = array.get(g_mss_state, i)
                if state == "Active"
                    int dir = array.get(g_mss_dir, i)
                    float trig_px = array.get(g_mss_trigger_px, i)
                    string new_state = state
                    
                    if dir == TD_LONG
                        if close < trig_px
                            new_state := "Invalidated"
                    else if dir == TD_SHORT
                        if close > trig_px
                            new_state := "Invalidated"
                            
                    if new_state != state
                        f_mss_emit(i, new_state)

f_compute_mss()
