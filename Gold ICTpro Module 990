    _ = f_emit_engine_event(st, 0, "DBG-M6", MOD_LIQ, EVENT_EMIT, SEV_INFO, "DEBUG", "M6", "ENTERED M6", "{}", true)
    
    st.current_trace.pool_str += "\nCurrBar=" + str.tostring(bar_index) + " SWING_LB=" + str.tostring(SWING_LOOKBACK)
