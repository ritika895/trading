// --- Helpers ---
f_mtf_find(string baseId) =>
    int idx = -1
    int sz = array.size(g_mtf_base)
    if sz > 0
        for i = 0 to sz - 1
            if array.get(g_mtf_base, i) == baseId
                idx := i
                break
    idx

f_mtf_emit(string tf, int bias, int bos, int choch, bool integ) =>
    int  sb  = na(bias)  ? TD_NEUTRAL : bias
    int  sbo = na(bos)   ? 0          : bos
    int  sc  = na(choch) ? 0          : choch
    bool si  = integ and not na(bias) and not na(bos) and not na(choch)

    string baseId = "MTF-" + tf
    int idx = f_mtf_find(baseId)

    bool   changed = false
    string prevId  = ""
    int    newVer  = 1

    if idx == -1
        changed := true
        array.push(g_mtf_base,  baseId)
        array.push(g_mtf_ver,   1)
        array.push(g_mtf_tf,    tf)
        array.push(g_mtf_bias,  sb)
        array.push(g_mtf_bos,   sbo)
        array.push(g_mtf_choch, sc)
        array.push(g_mtf_ts,    bar_index)
        array.push(g_mtf_integ, si)
    else
        int  cb  = array.get(g_mtf_bias,  idx)
        int  cbo = array.get(g_mtf_bos,   idx)
        int  cc  = array.get(g_mtf_choch, idx)
        bool ci  = array.get(g_mtf_integ, idx)

        if cb != sb or cbo != sbo or cc != sc or ci != si
            changed := true
            prevId  := baseId + "-v" + str.tostring(array.get(g_mtf_ver, idx))
            newVer  := array.get(g_mtf_ver, idx) + 1

            array.set(g_mtf_ver,   idx, newVer)
            array.set(g_mtf_bias,  idx, sb)
            array.set(g_mtf_bos,   idx, sbo)
            array.set(g_mtf_choch, idx, sc)
            array.set(g_mtf_ts,    idx, bar_index)
            array.set(g_mtf_integ, idx, si)

    MTFStructureInstance inst = na
    if changed
        string instId = baseId + "-v" + str.tostring(newVer)
        inst := MTFStructureInstance.new(
             baseId, instId, prevId,
             "MTFStructure", P9_MTF_MODULE,
             bar_index, "Active", si,
             P9_MTF_CVER,
             tf, sb, sbo, sc, time)
        array.push(g_mtf_registry, inst)

        string ref = instId + (prevId == "" ? "" : "|supersedes:" + prevId)
        f_p9_log(P9_MTF_MODULE, "MTF_EMIT", ref, si)

    inst

f_mtf_prune() =>
    int sz = array.size(g_mtf_registry)
    if sz > P9_MTF_RETAIN
        int rm = sz - P9_MTF_RETAIN
        for i = 0 to rm - 1
            array.shift(g_mtf_registry)

// --- HTF Detection Function ---
f_htf_structure() =>
    float ph = ta.pivothigh(high, SWING_LOOKBACK, SWING_LOOKBACK)
    float pl = ta.pivotlow(low, SWING_LOOKBACK, SWING_LOOKBACK)

    var int   htf_trend   = TD_NEUTRAL
    var int   htf_bos     = 0
    var int   htf_choch   = 0
    var float htf_last_hi = na
    var float htf_last_lo = na
    var float bos_price   = na
    var float choch_price = na

    if not na(htf_last_hi) and close > htf_last_hi
        if htf_trend == TD_SHORT
            htf_choch := TD_LONG
            choch_price := htf_last_hi
        else
            htf_bos := TD_LONG
            bos_price := htf_last_hi
        htf_trend := TD_LONG

    if not na(htf_last_lo) and close < htf_last_lo
        if htf_trend == TD_LONG
            htf_choch := TD_SHORT
            choch_price := htf_last_lo
        else
            htf_bos := TD_SHORT
            bos_price := htf_last_lo
        htf_trend := TD_SHORT

    if not na(ph)
        htf_last_hi := ph
    if not na(pl)
        htf_last_lo := pl

    [htf_trend, htf_bos, htf_choch, bos_price, choch_price]

// --- Main Compute ---
f_compute_mtf_structure() =>
    int t0 = timenow

    [b1, bo1, c1, bp1, cp1] = request.security(syminfo.tickerid, P9_HTF_1, f_htf_structure())
    [b2, bo2, c2, bp2, cp2] = request.security(syminfo.tickerid, P9_HTF_2, f_htf_structure())
    [b3, bo3, c3, bp3, cp3] = request.security(syminfo.tickerid, P9_HTF_3, f_htf_structure())
    [b4, bo4, c4, bp4, cp4] = request.security(syminfo.tickerid, P9_HTF_4, f_htf_structure())

    bool i1 = not na(b1) and not na(bo1) and not na(c1)
    bool i2 = not na(b2) and not na(bo2) and not na(c2)
    bool i3 = not na(b3) and not na(bo3) and not na(c3)
    bool i4 = not na(b4) and not na(bo4) and not na(c4)

    MTFStructureInstance e1 = f_mtf_emit(P9_HTF_1, b1, bo1, c1, i1)
    MTFStructureInstance e2 = f_mtf_emit(P9_HTF_2, b2, bo2, c2, i2)
    MTFStructureInstance e3 = f_mtf_emit(P9_HTF_3, b3, bo3, c3, i3)
    MTFStructureInstance e4 = f_mtf_emit(P9_HTF_4, b4, bo4, c4, i4)

    f_mtf_prune()

    array<MTFStructureInstance> emitted = array.new<MTFStructureInstance>()
    if not na(e1)
        array.push(emitted, e1)
    if not na(e2)
        array.push(emitted, e2)
    if not na(e3)
        array.push(emitted, e3)
    if not na(e4)
        array.push(emitted, e4)

    if bar_index % 50 == 0
        int elapsed = timenow - t0
        HealthPing hp = HealthPing.new(
             P9_MTF_MODULE,
             array.size(g_mtf_registry),
             P9_MTF_CAP,
             elapsed,
             0, 0, 0, 4)
        array.push(g_p9_health_pings, hp)

    [emitted, bp1, cp1]

