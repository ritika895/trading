type SweepValidationResult
    bool          isSwept
    int           sweepDirection
    float         sweepConfidence
    string        sweepReason
    LiquidityPool sweptPool

f_validate_sweep(SelectionResult sel, ContextSnapshot snap) =>
    bool isSwept = false
    int sweepDir = TD_NEUTRAL
    float sweepConf = 0.0
    string sweepReason = "NO_SWEEP_DETECTED"
    LiquidityPool sweptPool = na
    
    if not na(sel.bestOverallPool) and not na(snap)
        LiquidityPool p = sel.bestOverallPool
        float level = p.priceLevel
        float atr_val = snap.atr
        float max_depth = atr_val * SWEEP_THRESHOLD
        
        if p.poolType == LT_SELL_SIDE
            if low <= level and close > level 
                float sweep_depth = level - low
                if sweep_depth <= max_depth
                    isSwept := true
                    sweepDir := TD_LONG
                    sweepConf := 0.8 - (sweep_depth / max_depth * 0.3) 
                    sweepReason := "BULLISH_SWEEP_WICK"
                    sweptPool := p
                else
                    sweepReason := "SWEEP_TOO_DEEP"
                    
        else if p.poolType == LT_BUY_SIDE
            if high >= level and close < level 
                float sweep_depth = high - level
                if sweep_depth <= max_depth
                    isSwept := true
                    sweepDir := TD_SHORT
                    sweepConf := 0.8 - (sweep_depth / max_depth * 0.3)
                    sweepReason := "BEARISH_SWEEP_WICK"
                    sweptPool := p
                else
                    sweepReason := "SWEEP_TOO_DEEP"
                    
    SweepValidationResult.new(isSwept, sweepDir, sweepConf, sweepReason, sweptPool)

