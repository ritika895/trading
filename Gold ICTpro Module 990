f_format_id(string prefix, int seq, int ver) =>
    string seq_str = str.tostring(seq)
    while str.length(seq_str) < 6
        seq_str := "0" + seq_str
    if ver > 0
        string ver_str = str.tostring(ver)
        while str.length(ver_str) < 2
            ver_str := "0" + ver_str
        prefix + "-" + seq_str + "-v" + ver_str
    else
        prefix + "-" + seq_str

