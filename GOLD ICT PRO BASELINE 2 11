float M10_SL_BUFFER_ATR_MULT   = 0.5
float M10_TP_RR_MULT           = 2.0
float M10_MIN_RR               = 1.5
int   M10_MIN_CONFIDENCE       = 50
int   M10_REC_EXPIRY_BARS      = 100
int   MAX_M10_DEDUP_REGISTRY   = 500
float M10_TIGHT_STOP_ATR_MULT  = 1.0

var array<string> g_m10_dedup_keys = array.new<string>()
var map<string, bool> g_m10_dedup_map = map.new<string, bool>()

f_m10_dedup_exists(string dedupKey) =>
    map.contains(g_m10_dedup_map, dedupKey)

f_m10_record_audit(EngineState st, string corr_id, string object_id, string status, string message, string recommendation) =>
    int audit_id = st.audit.next_audit_id
    st.audit.next_audit_id += 1
    st.audit.audit_total_emitted += 1

    if status == AUDIT_PASS
        st.audit.lifetime_audit_passed += 1
        st.audit.m12_cycle_passed += 1
    else if status == AUDIT_WARNING
        st.audit.lifetime_audit_warnings += 1
        st.audit.m12_cycle_warnings += 1
    else if status == AUDIT_FAIL
        st.audit.lifetime_audit_failures += 1
        st.audit.m12_cycle_failures += 1
        st.audit.audit_last_failure_msg := message
    else if status == AUDIT_SKIPPED
        st.audit.m12_cycle_skipped += 1
    st.audit.m12_last_summary := message

    AuditResultInstance audit_result = AuditResultInstance.new(audit_id, AUDIT_REGISTRY, status == AUDIT_FAIL ? SEV_ERROR : status == AUDIT_WARNING ? SEV_WARNING : SEV_INFO, status, object_id, "Module 10", corr_id, message, recommendation, status != AUDIT_FAIL, AUDIT_SCHEMA_VERSION, time, bar_index)
    AuditResultInstance _shifted = f_push_audit(g_audit_registry, audit_result, MAX_AUDIT_REGISTRY)
    _shifted

f_m10_push_recommendation(EngineState st, TradeRecommendationInstance inst, string baseId, string action, string rating, int score) =>
    array.push(g_trade_rec_registry, inst)
    array.push(g_trade_rec_base_id, baseId)
    array.push(g_trade_rec_action, action)
    array.push(g_trade_rec_rating, rating)
    array.push(g_trade_rec_score, score)
    TradeRecommendationInstance evicted = na
    if array.size(g_trade_rec_registry) > MAX_TRADE_REC_REGISTRY
        evicted := array.shift(g_trade_rec_registry)
        _ = array.shift(g_trade_rec_base_id)
        _ = array.shift(g_trade_rec_action)
        _ = array.shift(g_trade_rec_rating)
        _ = array.shift(g_trade_rec_score)
    evicted

f_m10_risk_engine(TradeCandidate cand, float atr, bool poi_found, bool poi_integrity) =>
    float entryPrice = (cand.entryZoneHigh + cand.entryZoneLow) / 2.0
    float stopLoss = na
    float takeProfit = na
    if cand.direction == TD_LONG
        stopLoss := cand.entryZoneLow - (atr * M10_SL_BUFFER_ATR_MULT)
        takeProfit := entryPrice + (entryPrice - stopLoss) * M10_TP_RR_MULT
    else
        stopLoss := cand.entryZoneHigh + (atr * M10_SL_BUFFER_ATR_MULT)
        takeProfit := entryPrice - (stopLoss - entryPrice) * M10_TP_RR_MULT

    float expectedRR = math.abs(takeProfit - entryPrice) / math.abs(entryPrice - stopLoss)

    bool poi_unresolved = (not poi_found) or (not poi_integrity)
    bool weak_qual = cand.qualificationScore < 70

    float riskScoreF = 50.0
    riskScoreF += poi_unresolved ? 25.0 : 0.0
    riskScoreF += (expectedRR < M10_MIN_RR * 1.25 ? 15.0 : -15.0)
    riskScoreF += (weak_qual ? 10.0 : -10.0)
    int riskScore = int(math.max(0.0, math.min(100.0, riskScoreF)))

    [entryPrice, stopLoss, takeProfit, expectedRR, riskScore, poi_unresolved]

f_m10_build_reasons_penalties(bool structureConfirmed, float expectedRR, int confidence, bool poi_unresolved, float entryPrice, float stopLoss, float atr) =>
    string reasons = ""
    string penalties = ""

    if structureConfirmed
        reasons := reasons + (reasons == "" ? "" : ",") + "STRUCTURE_CONFIRMED"

    if expectedRR >= M10_MIN_RR * 1.25
        reasons := reasons + (reasons == "" ? "" : ",") + "RR_ABOVE_MIN"
    else
        penalties := penalties + (penalties == "" ? "" : ",") + "MARGINAL_RR"

    if confidence >= 80
        reasons := reasons + (reasons == "" ? "" : ",") + "HIGH_QUAL_SCORE"
    else
        penalties := penalties + (penalties == "" ? "" : ",") + "MODERATE_QUAL_SCORE"

    if not poi_unresolved
        reasons := reasons + (reasons == "" ? "" : ",") + "POI_INTEGRITY_OK"
    else
        penalties := penalties + (penalties == "" ? "" : ",") + "POI_UNRESOLVED"

    if math.abs(entryPrice - stopLoss) < (atr * M10_TIGHT_STOP_ATR_MULT)
        penalties := penalties + (penalties == "" ? "" : ",") + "TIGHT_ATR_STOP"

    if penalties == ""
        penalties := "NONE"

    [reasons, penalties]

f_m10_stage0_4(EngineState st) =>
    if barstate.isconfirmed and array.size(g_m9_registry) > 0
        map<string, int> poiIdx = map.new<string, int>()
        if array.size(g_poi_registry) > 0
            for j = 0 to array.size(g_poi_registry) - 1
                INSTR.cur_m10PoiIdxScan += 1
                map.put(poiIdx, array.get(g_poi_registry, j).baseId, j)

        for i = 0 to array.size(g_m9_registry) - 1
            INSTR.cur_m10s04LoopIter += 1
            TradeCandidate cand = array.get(g_m9_registry, i)

            if cand.status == M9_TRIGGERED
                string dedupKey = cand.baseId
                INSTR.cur_m10DedupScan += 1
                bool is_dup = f_m10_dedup_exists(dedupKey)

                if not is_dup
                    string evicted_key = f_push_string(g_m10_dedup_keys, dedupKey, MAX_M10_DEDUP_REGISTRY)
                    if not na(evicted_key)
                        map.remove(g_m10_dedup_map, evicted_key)
                    map.put(g_m10_dedup_map, dedupKey, true)

                    string corr_id = "M10-" + str.tostring(bar_index)

                    bool geom_ok = cand.entryZoneHigh > cand.entryZoneLow
                    bool atr_ok = not na(st.current_context.atr) and st.current_context.atr > 0

                    if not geom_ok
                        st.diag.m10_latest_action := "WAIT"
                        st.diag.m10_reject_reason := "DEGENERATE_ZONE"
                        _ = f_emit_engine_event(st, 0, corr_id, MOD_TR, EVENT_WARNING, SEV_WARNING, "REJECTED", cand.baseId, "TradeRecommendation rejected: DEGENERATE_ZONE", "{}", false)
                        _ = f_m10_record_audit(st, corr_id, cand.baseId, AUDIT_FAIL, "TradeRecommendation rejected: DEGENERATE_ZONE", "Verify source geometry")
                    else if not atr_ok
                        st.diag.m10_latest_action := "WAIT"
                        st.diag.m10_reject_reason := "ATR_INVALID"
                        _ = f_emit_engine_event(st, 0, corr_id, MOD_TR, EVENT_WARNING, SEV_WARNING, "REJECTED", cand.baseId, "TradeRecommendation rejected: ATR_INVALID", "{}", false)
                        _ = f_m10_record_audit(st, corr_id, cand.baseId, AUDIT_WARNING, "TradeRecommendation rejected: ATR_INVALID", "No action required")
                    else
                        bool poi_found = map.contains(poiIdx, cand.baseId)
                        int poi_idx = poi_found ? map.get(poiIdx, cand.baseId) : -1
                        POIInstance poi = poi_found ? array.get(g_poi_registry, poi_idx) : na
                        POIExtension ext = poi_found ? array.get(g_poi_ext_registry, poi_idx) : na
                        bool poi_integrity = poi_found ? poi.integrity : false

                        string fvgLinkVal = poi_found ? poi.fvgLink : ""
                        string obLinkVal  = poi_found ? poi.obLink  : ""
                        string mssLinkVal = poi_found ? poi.mssLink : ""
                        string brkLinkVal = poi_found ? poi.brkLink : ""
                        string liqLinkVal = poi_found ? ext.liqPoolLink : "N/A"

                        [entryPrice, stopLoss, takeProfit, expectedRR, riskScore, poi_unresolved] = f_m10_risk_engine(cand, st.current_context.atr, poi_found, poi_integrity)

                        int confidence = int(math.round(math.max(0.0, math.min(100.0, cand.qualificationScore))))
                        bool rr_ok = expectedRR >= M10_MIN_RR
                        bool conf_ok = confidence >= M10_MIN_CONFIDENCE

                        if not rr_ok
                            st.diag.m10_latest_action := "WAIT"
                            st.diag.m10_latest_rating := "Reject"
                            st.diag.m10_reject_reason := "RR_BELOW_MINIMUM"
                            _ = f_emit_engine_event(st, 0, corr_id, MOD_TR, EVENT_WARNING, SEV_WARNING, "REJECTED", cand.baseId, "TradeRecommendation rejected: RR_BELOW_MINIMUM", "{}", false)
                            _ = f_m10_record_audit(st, corr_id, cand.baseId, AUDIT_WARNING, "TradeRecommendation rejected: RR_BELOW_MINIMUM", "No action required")
                        else if not conf_ok
                            st.diag.m10_latest_action := "WAIT"
                            st.diag.m10_latest_rating := "Reject"
                            st.diag.m10_reject_reason := "CONFIDENCE_BELOW_MINIMUM"
                            _ = f_emit_engine_event(st, 0, corr_id, MOD_TR, EVENT_WARNING, SEV_WARNING, "REJECTED", cand.baseId, "TradeRecommendation rejected: CONFIDENCE_BELOW_MINIMUM", "{}", false)
                            _ = f_m10_record_audit(st, corr_id, cand.baseId, AUDIT_WARNING, "TradeRecommendation rejected: CONFIDENCE_BELOW_MINIMUM", "No action required")
                        else
                            string action = cand.direction == TD_LONG ? "BUY" : "SELL"
                            string rating = confidence >= 90 ? "A+" : confidence >= 80 ? "A" : confidence >= 70 ? "B" : "C"

                            [reasonsStr, penaltiesStr] = f_m10_build_reasons_penalties(cand.structureConfirmed, expectedRR, confidence, poi_unresolved, entryPrice, stopLoss, st.current_context.atr)

                            string confFactors = "M9_QUAL:" + str.tostring(cand.qualificationScore, "#.#") + ",POI_INTEGRITY:" + (poi_integrity ? "true" : "false") + ",RR:" + str.tostring(expectedRR, "#.##")

                            int trade_id = st.counters.next_trade_rec_id
                            st.counters.next_trade_rec_id += 1
                            st.counters.trade_rec_total_emitted += 1

                            string base_id = f_format_id("M10-TR", trade_id, 0)
                            string inst_id = base_id + "_v1"

                            TradeRecommendationInstance new_inst = TradeRecommendationInstance.new(base_id, inst_id, 1, action, cand.direction, rating, confidence, confidence, 0, riskScore, expectedRR, entryPrice, stopLoss, takeProfit, cand.baseId, brkLinkVal, mssLinkVal, obLinkVal, fvgLinkVal, liqLinkVal, "N/A", confFactors, reasonsStr, penaltiesStr, true, bar_index, corr_id, "", 0)

                            TradeRecommendationInstance evicted = f_m10_push_recommendation(st, new_inst, base_id, action, rating, confidence)

                            if not na(evicted)
                                if evicted.exitReason == ""
                                    string ev_corr = "M10-EVICT-" + str.tostring(bar_index)
                                    _ = f_emit_engine_event(st, 0, ev_corr, MOD_TR, EVENT_WARNING, SEV_WARNING, "EVICTED_OVERFLOW", evicted.baseId, "TradeRecommendation evicted on overflow, exitReason at eviction: NONE", "{}", false)
                                    _ = f_m10_record_audit(st, ev_corr, evicted.baseId, AUDIT_WARNING, "TradeRecommendation evicted on overflow, exitReason at eviction: NONE", "No action required — registry at capacity")

                            st.diag.m10_latest_action := action
                            st.diag.m10_latest_rating := rating
                            st.diag.m10_latest_score := confidence
                            st.diag.m10_latest_risk := riskScore < 34 ? "Low" : riskScore <= 66 ? "Medium" : "High"
                            st.diag.m10_latest_risk_score := riskScore
                            st.diag.m10_latest_rr := expectedRR
                            st.diag.m10_latest_entry := entryPrice
                            st.diag.m10_latest_sl := stopLoss
                            st.diag.m10_latest_tp := takeProfit
                            st.diag.m10_latest_reasons := reasonsStr
                            st.diag.m10_latest_penalties := penaltiesStr
                            st.diag.m10_reject_reason := "None"

                            _ = f_emit_engine_event(st, 0, corr_id, MOD_TR, EVENT_CREATE, SEV_INFO, "SUCCESS", base_id, "TradeRecommendation created: " + base_id, "{}", true)
                            _ = f_m10_record_audit(st, corr_id, base_id, AUDIT_PASS, "TradeRecommendation created: " + base_id, "No action required")
    bool _done = true
    _done

f_m10_stage5_lifecycle(EngineState st) =>
    if barstate.isconfirmed and array.size(g_trade_rec_registry) > 0
        for i = 0 to array.size(g_trade_rec_registry) - 1
            INSTR.cur_m10s5LoopIter += 1
            TradeRecommendationInstance inst = array.get(g_trade_rec_registry, i)

            if inst.exitReason == "" and bar_index != inst.createdAt
                bool transitioned = false

                bool sl_hit = inst.direction == TD_LONG ? (low <= inst.stopLoss) : (high >= inst.stopLoss)
                if sl_hit
                    inst.exitReason := "SL_HIT"
                    inst.pipelineBars := bar_index - inst.createdAt
                    transitioned := true
                    array.set(g_trade_rec_registry, i, inst)
                    string sl_corr = "M10-SL-" + str.tostring(bar_index)
                    _ = f_emit_engine_event(st, 0, sl_corr, MOD_TR, EVENT_INVALID, SEV_WARNING, "SL_HIT", inst.baseId, "TradeRecommendation transitioned -> STOPPED (SL_HIT)", "{}", true)
                    _ = f_m10_record_audit(st, sl_corr, inst.baseId, AUDIT_PASS, "TradeRecommendation transitioned -> STOPPED (SL_HIT)", "No action required")

                if not transitioned
                    bool tp_hit = inst.direction == TD_LONG ? (high >= inst.takeProfit) : (low <= inst.takeProfit)
                    if tp_hit
                        inst.exitReason := "TP_HIT"
                        inst.pipelineBars := bar_index - inst.createdAt
                        transitioned := true
                        array.set(g_trade_rec_registry, i, inst)
                        string tp_corr = "M10-TP-" + str.tostring(bar_index)
                        _ = f_emit_engine_event(st, 0, tp_corr, MOD_TR, EVENT_CREATE, SEV_INFO, "TP_HIT", inst.baseId, "TradeRecommendation transitioned -> FULFILLED (TP_HIT)", "{}", true)
                        _ = f_m10_record_audit(st, tp_corr, inst.baseId, AUDIT_PASS, "TradeRecommendation transitioned -> FULFILLED (TP_HIT)", "No action required")

                if not transitioned
                    if bar_index - inst.createdAt > M10_REC_EXPIRY_BARS
                        inst.exitReason := "EXPIRED_NO_RESOLUTION"
                        inst.pipelineBars := bar_index - inst.createdAt
                        transitioned := true
                        array.set(g_trade_rec_registry, i, inst)
                        string exp_corr = "M10-EXP-" + str.tostring(bar_index)
                        _ = f_emit_engine_event(st, 0, exp_corr, MOD_TR, EVENT_INVALID, SEV_WARNING, "EXPIRED", inst.baseId, "TradeRecommendation transitioned -> EXPIRED", "{}", true)
                        _ = f_m10_record_audit(st, exp_corr, inst.baseId, AUDIT_PASS, "TradeRecommendation transitioned -> EXPIRED", "No action required")
    bool _done = true
    _done

f_m10_coordinator(EngineState st) =>
    _ = f_m10_stage0_4(st)
    _ = f_m10_stage5_lifecycle(st)
    bool _done = true
    _done

