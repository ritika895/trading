f_compute_fvg() =>
    bool integ = f_check_p8_integ() and f_mtf_all_ok()
    if integ and barstate.islastconfirmedhistory
        if not na(high[3]) and not na(low[3])
            if low[1] > high[3]
                f_fvg_create(TD_LONG, low[1], high[3])
            else if high[1] < low[3]
                f_fvg_create(TD_SHORT, low[3], high[1])
                
        int sz = array.size(g_fvg_base_id)
        if sz > 0
            for i = 0 to sz - 1
                string state = array.get(g_fvg_state, i)
                if state != "Full"
                    int dir = array.get(g_fvg_dir, i)
                    float top = array.get(g_fvg_top, i)
                    float bot = array.get(g_fvg_bot, i)
                    
                    if (dir == TD_LONG and low < top + g_current_context.atr) or (dir == TD_SHORT and high > bot - g_current_context.atr)
                        float cur_mit = array.get(g_fvg_mit_pct, i)
                        float new_mit = cur_mit
                        string new_state = state
                        
                        if dir == TD_LONG
                            if low <= bot
                                new_mit := 100.0
                                new_state := "Full"
                            else if low < top
                                float gap_size = top - bot
                                float pct = gap_size == 0 ? 0.0 : (top - low) / gap_size * 100.0
                                if pct > new_mit
                                    new_mit := pct
                                    new_state := "Partial"
                        else if dir == TD_SHORT
                            if high >= top
                                new_mit := 100.0
                                new_state := "Full"
                            else if high > bot
                                float gap_size = top - bot
                                float pct = gap_size == 0 ? 0.0 : (high - bot) / gap_size * 100.0
                                if pct > new_mit
                                    new_mit := pct
                                    new_state := "Partial"
                                    
                        if new_mit != cur_mit
                            f_fvg_emit(i, new_state, new_mit)

f_compute_fvg()


