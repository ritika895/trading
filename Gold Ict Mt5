f_format_id(string prefix, int seq, int ver) =>
    string seq_str = str.tostring(seq)
    while str.length(seq_str) < 6
        seq_str := "0" + seq_str
    if ver > 0
        string ver_str = str.tostring(ver)
        while str.length(ver_str) < 2
            ver_str := "0" + ver_str
        prefix + "-" + seq_str + "-v" + ver_str
    else
        prefix + "-" + seq_str

string EVENT_SCHEMA_VERSION = "1.0"

f_bus_emit(int evtId, int pEvtId, string corrId, int modId, string eType, int sev, string outc, string objId, string desc, string meta, bool integ) =>
    EventRegistryInstance bus_evt = EventRegistryInstance.new(evtId, pEvtId, corrId, modId, eType, sev, outc, objId, time, bar_index, str.tostring(time, "HH:mm"), ENGINE_VERSION, EVENT_SCHEMA_VERSION, meta, desc, integ, bar_index)
    array.push(g_event_registry, bus_evt)
    if array.size(g_event_registry) > 250
        array.shift(g_event_registry)
    string sev_str = sev == SEV_INFO ? "INFO" : sev == SEV_WARNING ? "WARN" : sev == SEV_ERROR ? "ERROR" : "SUCCESS"
    array.push(g_event_log, str.tostring(time, "HH:mm") + " [" + sev_str + "/" + outc + "] " + desc)
    bus_evt

f_is_in_range(int cur_mins, int start_mins, int end_mins) =>
    if start_mins <= end_mins
        cur_mins >= start_mins and cur_mins < end_mins
    else
        cur_mins >= start_mins or cur_mins < end_mins

f_compute_phase8(EngineState state) =>
    EngineState st = state
    int bus_evt_id = 0

    st.current_selection := SelectionResult.new(na, na, na, "NOT_EVALUATED", 0.0)
    st.current_sweep_validation := SweepValidationResult.new(false, TD_NEUTRAL, 0.0, "NOT_EVALUATED", na)
    st.current_validation := ValidationSummary.new(false, "NOT_EVALUATED", "Not evaluated", "NOT_EVALUATED", na, st.current_selection, st.current_sweep_validation, TD_NEUTRAL)
    st.current_strategy := StrategyResult.new(false, TD_NEUTRAL, na, na, na, 0.0, 0.0, "NOT_EVALUATED")
    st.current_arbitration := ArbitrationResult.new(false, TD_NEUTRAL, na, na, na, "NOT_EVALUATED")

    int cur_hour = hour(time, syminfo.timezone)
    int cur_min = minute(time, syminfo.timezone)
    int cur_mins = cur_hour * 60 + cur_min
    int cur_day = dayofweek(time, syminfo.timezone)
    bool is_weekend = false
    if cur_day == 1
        if cur_mins < (17 * 60)
            is_weekend := true
    else if cur_day == 6
        if cur_mins >= (17 * 60)
            is_weekend := true
    int g_current_session = ST_OFF_SESSION
    string ctx_market_status = "CLOSED"
    if not is_weekend
        bool is_ny = f_is_in_range(cur_mins, ny_start, ny_end)
        bool is_london = f_is_in_range(cur_mins, london_start, london_end)
        bool is_asian = f_is_in_range(cur_mins, asian_start, asian_end)
        ctx_market_status := "OPEN"
        if is_ny
            g_current_session := ST_NEW_YORK
        else if is_london
            g_current_session := ST_LONDON
        else if is_asian
            g_current_session := ST_ASIAN
        else
            g_current_session := ST_OFF_SESSION
            ctx_market_status := "CLOSED"
    string h_str = cur_hour < 10 ? "0" + str.tostring(cur_hour) : str.tostring(cur_hour)
    string m_str = cur_min < 10 ? "0" + str.tostring(cur_min) : str.tostring(cur_min)
    string ctx_time_str = h_str + ":" + m_str
    
    if barstate.isconfirmed and enable_validation
        st.analytics.val_evals += 1
        
    if ctx_market_status == "OPEN"
        st.bus.current_correlation_id := "FLOW-" + str.tostring(st.bus.next_flow_id)
        st.bus.next_flow_id += 1

    float ph = ta.pivothigh(high, SWING_LOOKBACK, SWING_LOOKBACK)
    float pl = ta.pivotlow(low, SWING_LOOKBACK, SWING_LOOKBACK)
    st.diag.struct_logs := ""
    if barstate.isconfirmed
        if not na(st.structure.last_swing_high_price) and close > st.structure.last_swing_high_price
            if st.structure.current_trend == TD_SHORT
                st.structure.last_choch_dir := TD_LONG
                st.structure.current_trend := TD_LONG
                st.diag.struct_logs += "CHoCH (Bullish) detected. "
                if enable_validation
                    st.analytics.val_bull_choch += 1
            else
                st.structure.last_bos_dir := TD_LONG
                st.structure.current_trend := TD_LONG
                st.diag.struct_logs += "BOS (Bullish) detected. "
        if not na(st.structure.last_swing_low_price) and close < st.structure.last_swing_low_price
            if st.structure.current_trend == TD_LONG
                st.structure.last_choch_dir := TD_SHORT
                st.structure.current_trend := TD_SHORT
                st.diag.struct_logs += "CHoCH (Bearish) detected. "
                if enable_validation
                    st.analytics.val_bear_choch += 1
            else
                st.structure.last_bos_dir := TD_SHORT
                st.structure.current_trend := TD_SHORT
                st.diag.struct_logs += "BOS (Bearish) detected. "
        if not na(ph)
            if array.size(g_registry) < MAX_POOLS
                int newId = st.counters.next_pool_id
                st.counters.next_pool_id += 1
                LiquidityPool newPool = f_create_liquidity_pool(newId, LT_BUY_SIDE, LS_ACTIVE, ph, 0, 1.0, false, bar_index, 0, 0, "INIT", array.new<SwingPoint>())
                array.push(g_registry, newPool)
                array.push(g_event_log, str.tostring(time, "HH:mm") + " Pool Created: ID-" + str.tostring(newId))
                if enable_validation
                    st.analytics.val_pools_created += 1
            st.structure.last_swing_high_price := ph
            st.structure.last_swing_high_bar := bar_index - SWING_LOOKBACK
            st.diag.struct_logs += "Confirmed Swing High: " + str.tostring(ph) + ". "
        if not na(pl)
            if array.size(g_registry) < MAX_POOLS
                int newId = st.counters.next_pool_id
                st.counters.next_pool_id += 1
                LiquidityPool newPool = f_create_liquidity_pool(newId, LT_SELL_SIDE, LS_ACTIVE, pl, 0, 1.0, false, bar_index, 0, 0, "INIT", array.new<SwingPoint>())
                array.push(g_registry, newPool)
                array.push(g_event_log, str.tostring(time, "HH:mm") + " Pool Created: ID-" + str.tostring(newId))
                if enable_validation
                    st.analytics.val_pools_created += 1
            st.structure.last_swing_low_price := pl
            st.structure.last_swing_low_bar := bar_index - SWING_LOOKBACK
            st.diag.struct_logs += "Confirmed Swing Low: " + str.tostring(pl) + ". "
        if st.diag.struct_logs != ""
            array.push(g_event_log, str.tostring(time, "HH:mm") + " STRUCT: " + st.diag.struct_logs)
    float atr_val = ta.atr(ATR_LENGTH)
    float high50 = ta.highest(high, 50)
    float low50 = ta.lowest(low, 50)
    float priceRange = high50 - low50
    float eq = low50 + (priceRange * 0.5)
    float premium = low50 + (priceRange * 0.7)
    float discount = low50 + (priceRange * 0.3)
    st.current_context := ContextSnapshot.new(bar_index, time, close, atr_val, g_current_session, st.structure.current_trend, premium, discount, ctx_time_str, ctx_market_status)
    int POOL_EXPIRY_BARS = 200
    
    LiquidityPool _sweptPool = na
    bool _isSwept = false
    int _sweepDir = TD_NEUTRAL
    float _sweepConf = 0.0
    string _sweepReason = "NO_SWEEP_DETECTED"
    
    while array.size(g_pool_trackers) < array.size(g_registry)
        int new_idx = array.size(g_pool_trackers)
        LiquidityPool p_new = array.get(g_registry, new_idx)
        PoolTracker newT = PoolTracker.new(p_new.id, p_new.state, bar_index, 0, 0)
        array.push(g_pool_trackers, newT)
    if array.size(g_registry) > 0 and array.size(g_pool_trackers) == array.size(g_registry)
        for i = 0 to array.size(g_registry) - 1
            LiquidityPool pool = array.get(g_registry, i)
            if pool.state == LS_ACTIVE or pool.state == 2
                if bar_index - pool.createdAtBar > POOL_EXPIRY_BARS
                    int prevState = pool.state
                    pool.state := LS_EXPIRED
                    array.push(_lc_logs, str.tostring(time, "HH:mm") + " Pool " + str.tostring(pool.id) + " " + f_state_to_string(prevState) + "->" + f_state_to_string(LS_EXPIRED))
            if pool.state == LS_ACTIVE or pool.state == 2
                if pool.poolType == LT_BUY_SIDE
                    if low < pool.priceLevel and close > pool.priceLevel
                        float sweep_depth = pool.priceLevel - low
                        float max_depth = st.current_context.atr * SWEEP_THRESHOLD
                        if sweep_depth <= max_depth
                            int prevState = pool.state
                            pool.state := LS_SWEPT
                            pool.isSwept := true
                            pool.sweptAtBar := bar_index
                            pool.sweepReasonCode := "BULLISH_SWEEP_WICK"
                            array.push(_lc_logs, str.tostring(time, "HH:mm") + " Pool " + str.tostring(pool.id) + " " + f_state_to_string(prevState) + "->" + f_state_to_string(LS_SWEPT))
                            _sweptPool := pool
                            _isSwept := true
                            _sweepDir := TD_LONG
                            _sweepConf := 0.8 - (sweep_depth / max_depth * 0.3)
                            _sweepReason := "BULLISH_SWEEP_WICK"
                        else
                            _sweepReason := "SWEEP_TOO_DEEP"
                    else if close < pool.priceLevel
                        int prevState = pool.state
                        pool.state := LS_INVALIDATED
                        pool.invalidatedAtBar := bar_index
                        pool.sweepReasonCode := "BEARISH_BREAK"
                        array.push(_lc_logs, str.tostring(time, "HH:mm") + " Pool " + str.tostring(pool.id) + " " + f_state_to_string(prevState) + "->" + f_state_to_string(LS_INVALIDATED))
                else if pool.poolType == LT_SELL_SIDE
                    if high > pool.priceLevel and close < pool.priceLevel
                        float sweep_depth = high - pool.priceLevel
                        float max_depth = st.current_context.atr * SWEEP_THRESHOLD
                        if sweep_depth <= max_depth
                            int prevState = pool.state
                            pool.state := LS_SWEPT
                            pool.isSwept := true
                            pool.sweptAtBar := bar_index
                            pool.sweepReasonCode := "BEARISH_SWEEP_WICK"
                            array.push(_lc_logs, str.tostring(time, "HH:mm") + " Pool " + str.tostring(pool.id) + " " + f_state_to_string(prevState) + "->" + f_state_to_string(LS_SWEPT))
                            _sweptPool := pool
                            _isSwept := true
                            _sweepDir := TD_SHORT
                            _sweepConf := 0.8 - (sweep_depth / max_depth * 0.3)
                            _sweepReason := "BEARISH_SWEEP_WICK"
                        else
                            _sweepReason := "SWEEP_TOO_DEEP"
                    else if close > pool.priceLevel
                        int prevState = pool.state
                        pool.state := LS_INVALIDATED
                        pool.invalidatedAtBar := bar_index
                        pool.sweepReasonCode := "BULLISH_BREAK"
                        array.push(_lc_logs, str.tostring(time, "HH:mm") + " Pool " + str.tostring(pool.id) + " " + f_state_to_string(prevState) + "->" + f_state_to_string(LS_INVALIDATED))
            if pool.state == LS_SWEPT and pool.sweptAtBar < bar_index
                int prevState = pool.state
                pool.state := LS_INVALIDATED
                pool.invalidatedAtBar := bar_index
                array.push(_lc_logs, str.tostring(time, "HH:mm") + " Pool " + str.tostring(pool.id) + " " + f_state_to_string(prevState) + "->" + f_state_to_string(LS_INVALIDATED))
            if i < array.size(g_pool_trackers)
                PoolTracker t = array.get(g_pool_trackers, i)
                if t.lastState != pool.state
                    int prev = t.lastState
                    int curr = pool.state
                    string transStr = f_state_to_string(prev) + " -> " + f_state_to_string(curr)
                    int activeDur = 0
                    int reinDur = 0
                    int sweptDur = 0
                    if prev == LS_ACTIVE
                        activeDur := bar_index - t.activeStartBar
                    else if prev == 2
                        reinDur := bar_index - t.reinforcedStartBar
                    else if prev == LS_SWEPT
                        sweptDur := bar_index - t.sweptStartBar
                    LifecycleAuditEntry entry = LifecycleAuditEntry.new(pool.id, prev, curr, transStr, pool.sweepReasonCode, bar_index, activeDur, reinDur, sweptDur)
                    array.push(g_lifecycle_audit_log, entry)
                    if curr == LS_ACTIVE
                        t.activeStartBar := bar_index
                    else if curr == 2
                        t.reinforcedStartBar := bar_index
                    else if curr == LS_SWEPT
                        t.sweptStartBar := bar_index
                    t.lastState := curr
    if array.size(g_lifecycle_audit_log) > 10
        array.shift(g_lifecycle_audit_log)
    if array.size(_lc_logs) > 0
        string final_log = array.join(_lc_logs, " | ")
        array.push(g_event_log, str.tostring(time, "HH:mm") + " " + final_log)
        array.clear(_lc_logs)
    if array.size(g_registry) > 0 and array.size(g_registry) == array.size(g_pool_trackers)
        for i = array.size(g_registry) - 1 to 0
            LiquidityPool pool = array.get(g_registry, i)
            if pool.state == LS_EXPIRED or pool.state == LS_INVALIDATED
                array.remove(g_registry, i)
                array.remove(g_pool_trackers, i)
                
    float _bestBullScore = -1.0
    float _bestBearScore = -1.0
    LiquidityPool _bestBull = na
    LiquidityPool _bestBear = na
    if array.size(g_registry) > 0
        for i = 0 to array.size(g_registry) - 1
            LiquidityPool pool = array.get(g_registry, i)
            if pool.state == LS_ACTIVE or pool.state == 2
                float score = f_score_pool(pool)
                if pool.poolType == LT_BUY_SIDE and score > _bestBullScore
                    _bestBullScore := score
                    _bestBull := pool
                else if pool.poolType == LT_SELL_SIDE and score > _bestBearScore
                    _bestBearScore := score
                    _bestBear := pool
    LiquidityPool _bestOverall = na
    string _selReason = "No eligible pools found."
    float _selConf = 0.0
    if not na(_bestBull) and not na(_bestBear)
        if _bestBullScore >= _bestBearScore
            _bestOverall := _bestBull
            _selReason := "Bullish selected (Highest Score)."
            _selConf := _bestBull.confidence
        else
            _bestOverall := _bestBear
            _selReason := "Bearish selected (Highest Score)."
            _selConf := _bestBear.confidence
    else if not na(_bestBull)
        _bestOverall := _bestBull
        _selReason := "Bullish selected (No Bearish competition)."
        _selConf := _bestBull.confidence
    else if not na(_bestBear)
        _bestOverall := _bestBear
        _selReason := "Bearish selected (No Bullish competition)."
        _selConf := _bestBear.confidence
    
    int _tBull = 0
    int _tBear = 0
    int _eBull = 0
    int _eBear = 0
    if array.size(g_registry) > 0
        for i = 0 to array.size(g_registry) - 1
            LiquidityPool pool = array.get(g_registry, i)
            if pool.poolType == LT_BUY_SIDE
                _tBull += 1
            else
                _tBear += 1
            if pool.state == LS_ACTIVE or pool.state == 2
                if pool.poolType == LT_BUY_SIDE
                    _eBull += 1
                else
                    _eBear += 1

    st.current_selection := SelectionResult.new(_bestBull, _bestBear, _bestOverall, _selReason, _selConf)
    if st.current_selection.selectionReason != "No eligible pools found."
        array.push(g_event_log, str.tostring(time, "HH:mm") + " SELECT: " + st.current_selection.selectionReason)
    string _filterBull = "PASS"
    string _filterBear = "PASS"
    if _eBull == 0 and _tBull > 0
        _filterBull := "FAIL: No eligible bull pools"
    if _eBear == 0 and _tBear > 0
        _filterBear := "FAIL: No eligible bear pools"
    st.current_audit := SelectionAuditData.new(_tBull, _tBear, _eBull, _eBear, _filterBull, _filterBear, na(_bestBull) ? -1 : _bestBull.id, na(_bestBear) ? -1 : _bestBear.id, na(_bestOverall) ? -1 : _bestOverall.id, na(_bestOverall) ? "No eligible liquidity pools" : "Selected (No conflicts)")
    if st.current_audit.selectedOverallId == -1
        array.push(g_event_log, str.tostring(time, "HH:mm") + " AUDIT: " + st.current_audit.finalRejectionReason)
    
    if _isSwept and enable_validation
        st.analytics.val_sweeps += 1
        
    st.current_sweep_validation := SweepValidationResult.new(_isSwept, _sweepDir, _sweepConf, _sweepReason, _sweptPool)
    if st.current_sweep_validation.isSwept
        string liq_id = f_format_id("LIQ", _sweptPool.id, 1)
        bus_evt_id := st.bus.next_event_id
        st.bus.next_event_id += 1
        st.bus.event_total_emitted += 1
        _ = f_bus_emit(bus_evt_id, st.bus.last_event_id, st.bus.current_correlation_id, MOD_LIQ, EVENT_EMIT, SEV_INFO, "SUCCESS", liq_id, "Liquidity Swept: " + _sweepReason, "Dir=" + str.tostring(_sweepDir) + "|Conf=" + str.tostring(_sweepConf, "#.##"), true)
        st.bus.last_event_id := bus_evt_id

    bool _isReady = not na(_bestOverall) and _isSwept and st.structure.current_trend != TD_NEUTRAL
    string _valResult = _isReady ? "PASS" : "FAIL"
    string _failReason = na(_bestOverall) ? "No Active Pool Target" : not _isSwept ? "Sweep Failed (" + _sweepReason + ")" : st.structure.current_trend == TD_NEUTRAL ? "Trend Neutral" : "None"
    string _valStatus = _isReady ? "VALIDATED" : "REJECTED"
    
    st.current_validation := ValidationSummary.new(
         _isReady,
         _valResult,
         _failReason,
         _valStatus,
         st.current_context,
         st.current_selection,
         st.current_sweep_validation,
         st.structure.current_trend
     )

    PipelineTrace trace = PipelineTrace.new(bar_index, "WAIT", "SKIPPED", "SKIPPED", "SKIPPED", "SKIPPED", "FAIL", "None")
    string _exitReason = EXIT_NONE
    
    if st.current_context.market_status != "OPEN"
        trace.pool_str := "SKIPPED"
        trace.final_str := "FAIL"
        trace.reason_str := EXIT_MARKET_CLOSED
        _exitReason := EXIT_MARKET_CLOSED
        bus_evt_id := st.bus.next_event_id
        st.bus.next_event_id += 1
        st.bus.event_total_emitted += 1
        _ = f_bus_emit(bus_evt_id, st.bus.last_event_id, st.bus.current_correlation_id, MOD_BUS, "PIPELINE", SEV_INFO, "SKIPPED", "PIPELINE", "Market Closed", "Reason=Market Closed", true)
        st.bus.last_event_id := bus_evt_id
    else
        if na(_bestOverall)
            trace.pool_str := "FAIL: No Pool"
            trace.final_str := "FAIL"
            trace.reason_str := EXIT_NO_POOL
            _exitReason := EXIT_NO_POOL
            bus_evt_id := st.bus.next_event_id
            st.bus.next_event_id += 1
            st.bus.event_total_emitted += 1
            _ = f_bus_emit(bus_evt_id, st.bus.last_event_id, st.bus.current_correlation_id, MOD_LIQ, "SELECTION", SEV_WARNING, "FAILED", "SELECTION", "No Active Pool Target", "Trace=FAIL", true)
            st.bus.last_event_id := bus_evt_id
        else
            trace.pool_str := "PASS: ID-" + str.tostring(_bestOverall.id)
            trace.sweep_str := "WAIT"
            bus_evt_id := st.bus.next_event_id
            st.bus.next_event_id += 1
            st.bus.event_total_emitted += 1
            _ = f_bus_emit(bus_evt_id, st.bus.last_event_id, st.bus.current_correlation_id, MOD_LIQ, "SELECTION", SEV_INFO, "SUCCESS", "SELECTION", "Pool Selected: ID-" + str.tostring(_bestOverall.id), "Conf=" + str.tostring(_selConf, "#.##"), true)
            st.bus.last_event_id := bus_evt_id
            
            if not _isSwept
                trace.sweep_str := "FAIL: " + _sweepReason
                trace.final_str := "FAIL"
                trace.reason_str := EXIT_NO_SWEEP
                _exitReason := EXIT_NO_SWEEP
                bus_evt_id := st.bus.next_event_id
                st.bus.next_event_id += 1
                st.bus.event_total_emitted += 1
                _ = f_bus_emit(bus_evt_id, st.bus.last_event_id, st.bus.current_correlation_id, MOD_LIQ, "VALIDATION", SEV_WARNING, "FAILED", "VALIDATION", "Sweep Failed", "Reason=" + _sweepReason, true)
                st.bus.last_event_id := bus_evt_id
            else
                trace.sweep_str := "PASS: " + _sweepReason
                trace.trend_str := "WAIT"
                bus_evt_id := st.bus.next_event_id
                st.bus.next_event_id += 1
                st.bus.event_total_emitted += 1
                _ = f_bus_emit(bus_evt_id, st.bus.last_event_id, st.bus.current_correlation_id, MOD_LIQ, "VALIDATION", SEV_INFO, "SUCCESS", "VALIDATION", "Sweep Confirmed", "Reason=" + _sweepReason, true)
                st.bus.last_event_id := bus_evt_id
                
                if st.structure.current_trend == TD_NEUTRAL
                    trace.trend_str := "FAIL: Neutral"
                    trace.final_str := "FAIL"
                    trace.reason_str := EXIT_VAL_FAIL
                    _exitReason := EXIT_VAL_FAIL
                    bus_evt_id := st.bus.next_event_id
                    st.bus.next_event_id += 1
                    st.bus.event_total_emitted += 1
                    _ = f_bus_emit(bus_evt_id, st.bus.last_event_id, st.bus.current_correlation_id, MOD_MTF, "VALIDATION", SEV_WARNING, "FAILED", "VALIDATION", "Trend Neutral", "Reason=Trend Neutral", true)
                    st.bus.last_event_id := bus_evt_id
                else
                    trace.trend_str := "PASS: " + (st.structure.current_trend == TD_LONG ? "Bullish" : "Bearish")
                    trace.strategy_str := "WAIT"
                    bus_evt_id := st.bus.next_event_id
                    st.bus.next_event_id += 1
                    st.bus.event_total_emitted += 1
                    _ = f_bus_emit(bus_evt_id, st.bus.last_event_id, st.bus.current_correlation_id, MOD_MTF, "VALIDATION", SEV_INFO, "SUCCESS", "VALIDATION", "Trend Confirmed", "Trend=" + (st.structure.current_trend == TD_LONG ? "LONG" : "SHORT"), true)
                    st.bus.last_event_id := bus_evt_id
                    
                    bool _approved = false
                    int _dir = TD_NEUTRAL
                    float _entry = na
                    float _sl = na
                    float _tp = na
                    float _rr = 0.0
                    float _conf = 0.0
                    string _stratReason = "N/A"
                    
                    SweepValidationResult sweep_val = st.current_sweep_validation
                    ContextSnapshot snap = st.current_context
                    LiquidityPool pool = _sweptPool
                    
                    if sweep_val.sweepDirection == TD_LONG
                        _approved := true
                        _dir := TD_LONG
                        _entry := close
                        _sl := pool.priceLevel - (snap.atr * 0.2)
                        _tp := _entry + (snap.atr * 2.0)
                        if _entry != _sl
                            _rr := (_tp - _entry) / (_entry - _sl)
                        _conf := (sweep_val.sweepConfidence * 0.6) + (pool.confidence * 0.4)
                    else if sweep_val.sweepDirection == TD_SHORT
                        _approved := true
                        _dir := TD_SHORT
                        _entry := close
                        _sl := pool.priceLevel + (snap.atr * 0.2)
                        _tp := _entry - (snap.atr * 2.0)
                        if _entry != _sl
                            _rr := (_entry - _tp) / (_sl - _entry)
                        _conf := (sweep_val.sweepConfidence * 0.6) + (pool.confidence * 0.4)
                    else
                        _stratReason := "Invalid Sweep Direction"
                        
                    st.current_strategy := StrategyResult.new(_approved, _dir, _entry, _sl, _tp, _rr, _conf, _stratReason)
                    if _approved and enable_validation
                        st.analytics.val_strat_approved += 1
                    
                    if not _approved
                        trace.strategy_str := "FAIL: " + _stratReason
                        trace.final_str := "FAIL"
                        trace.reason_str := EXIT_STRAT_REJ
                        _exitReason := EXIT_STRAT_REJ
                        bus_evt_id := st.bus.next_event_id
                        st.bus.next_event_id += 1
                        st.bus.event_total_emitted += 1
                        _ = f_bus_emit(bus_evt_id, st.bus.last_event_id, st.bus.current_correlation_id, MOD_TR, "STRATEGY", SEV_WARNING, "FAILED", "STRATEGY", "Strategy Rejected", "Reason=" + _stratReason, true)
                        st.bus.last_event_id := bus_evt_id
                    else
                        trace.strategy_str := "PASS: " + (_dir == TD_LONG ? "LONG" : "SHORT")
                        trace.arb_str := "WAIT"
                        bus_evt_id := st.bus.next_event_id
                        st.bus.next_event_id += 1
                        st.bus.event_total_emitted += 1
                        _ = f_bus_emit(bus_evt_id, st.bus.last_event_id, st.bus.current_correlation_id, MOD_TR, "STRATEGY", SEV_INFO, "SUCCESS", "STRATEGY", "Strategy Ready", "Dir=" + (_dir == TD_LONG ? "LONG" : "SHORT"), true)
                        st.bus.last_event_id := bus_evt_id
                        
                        bool _arbApproved = false
                        int _arbDir = TD_NEUTRAL
                        float _arbEntry = na
                        float _arbSl = na
                        float _arbTp = na
                        string _arbReason = "N/A"
                        
                        if st.current_strategy.direction == TD_LONG and st.current_context.marketBias == TD_SHORT
                            _arbReason := "Conflict: Long vs Bearish Trend"
                        else if st.current_strategy.direction == TD_SHORT and st.current_context.marketBias == TD_LONG
                            _arbReason := "Conflict: Short vs Bullish Trend"
                        else
                            _arbApproved := true
                            _arbDir := st.current_strategy.direction
                            _arbEntry := st.current_strategy.entryPrice
                            _arbSl := st.current_strategy.stopLoss
                            _arbTp := st.current_strategy.takeProfit
                            _arbReason := "Approved (No Conflicts)"
                            
                        st.current_arbitration := ArbitrationResult.new(_arbApproved, _arbDir, _arbEntry, _arbSl, _arbTp, _arbReason)
                        
                        if not _arbApproved
                            trace.arb_str := "FAIL: " + _arbReason
                            trace.final_str := "FAIL"
                            trace.reason_str := EXIT_ARB_REJ
                            _exitReason := EXIT_ARB_REJ
                            bus_evt_id := st.bus.next_event_id
                            st.bus.next_event_id += 1
                            st.bus.event_total_emitted += 1
                            _ = f_bus_emit(bus_evt_id, st.bus.last_event_id, st.bus.current_correlation_id, MOD_BUS, "ARBITRATION", SEV_WARNING, "FAILED", "ARBITRATION", "Arbitration Rejected", "Reason=" + _arbReason, true)
                            st.bus.last_event_id := bus_evt_id
                        else
                            trace.arb_str := "PASS: Approved"
                            trace.final_str := "PASS"
                            trace.reason_str := "Approved"
                            bus_evt_id := st.bus.next_event_id
                            st.bus.next_event_id += 1
                            st.bus.event_total_emitted += 1
                            _ = f_bus_emit(bus_evt_id, st.bus.last_event_id, st.bus.current_correlation_id, MOD_BUS, "ARBITRATION", SEV_INFO, "SUCCESS", "ARBITRATION", "Arbitration Approved", "Dir=" + (_arbDir == TD_LONG ? "LONG" : "SHORT"), true)
                            st.bus.last_event_id := bus_evt_id
                            
    st.current_trace := trace
    st.diag.m10_reject_reason := trace.reason_str
    array.push(g_event_log, str.tostring(time, "HH:mm") + " TRACE: Pool=" + trace.pool_str + " | Sweep=" + trace.sweep_str + " | Trend=" + trace.trend_str + " | Strat=" + trace.strategy_str + " | Arb=" + trace.arb_str + " | Final=" + trace.final_str + " | Reason=" + trace.reason_str)

    if array.size(g_recommendations) > 0
        for i = 0 to array.size(g_recommendations) - 1
            Recommendation rec = array.get(g_recommendations, i)
            if rec.status == RS_ACTIVE
                if rec.candidate.direction == TD_LONG and low <= rec.actualStop
                    rec.status := 2
                else if rec.candidate.direction == TD_SHORT and high >= rec.actualStop
                    rec.status := 2
                else if rec.candidate.direction == TD_LONG and high >= rec.candidate.takeProfit
                    rec.status := 3
                else if rec.candidate.direction == TD_SHORT and low <= rec.candidate.takeProfit
                    rec.status := 3
                else if bar_index - rec.createdBarIndex > 100
                    rec.status := 4
    bool has_active_rec = false
    st.active_rec := na
    if array.size(g_recommendations) > 0
        for i = array.size(g_recommendations) - 1 to 0
            Recommendation r = array.get(g_recommendations, i)
            if r.status == RS_ACTIVE
                has_active_rec := true
                st.active_rec := r
                break

    bool hasArbitration = not na(st.current_arbitration)
    bool arbitrationApproved = hasArbitration and st.current_arbitration.isApproved

    if not arbitrationApproved
        bus_evt_id := st.bus.next_event_id
        st.bus.next_event_id += 1
        st.bus.event_total_emitted += 1
        string diag_reason = not hasArbitration ? "Arbitration not evaluated" : st.current_arbitration.reason
        _ = f_bus_emit(bus_evt_id, st.bus.last_event_id, st.bus.current_correlation_id == "INIT" ? "FLOW-SYS" : st.bus.current_correlation_id, MOD_BUS, EVENT_WARNING, SEV_INFO, "SKIPPED", "RECOMMENDATION", "Recommendation Stage: SKIPPED | Reason: " + diag_reason, "Bar=" + str.tostring(bar_index) + "|Trace=" + st.current_trace.final_str, true)
        st.bus.last_event_id := bus_evt_id

    if arbitrationApproved and not has_active_rec
        int recId = st.counters.next_rec_id
        st.counters.next_rec_id += 1
        StrategyCandidate cand = StrategyCandidate.new(recId, st.current_selection.bestOverallPool, st.current_context, st.current_arbitration.direction, st.current_arbitration.entryPrice, st.current_arbitration.stopLoss, st.current_arbitration.takeProfit, "ICT_Liquidity_Sweep")
        Recommendation newRec = Recommendation.new(recId, cand, RS_ACTIVE, bar_index, st.current_arbitration.entryPrice, st.current_arbitration.stopLoss)
        array.push(g_recommendations, newRec)
        st.active_rec := newRec
        array.push(g_event_log, str.tostring(time, "HH:mm") + " REC_CREATE: Approved " + (st.current_arbitration.direction == TD_LONG ? "LONG" : "SHORT"))
    st

