f_compute_m10(EngineState state) =>
    EngineState st = state
    int bus_evt_id = 0
    if barstate.isconfirmed and not na(st.current_arbitration) and not na(st.current_strategy) and not na(st.current_validation)
        string action = "WAIT"
        int dir = st.current_arbitration.direction
        float entry = st.current_arbitration.entryPrice
        float sl = st.current_arbitration.stopLoss
        float tp = st.current_arbitration.takeProfit
        float rr = st.current_strategy.riskReward
        string rating = st.diag.poi_latest_grade
        int score = st.diag.poi_latest_score
        int risk_score = rr <= 0 ? 100 : math.max(0, math.min(100, int((4.0 - rr) / 4.0 * 100.0)))
        string reasons = ""
        string penalties = ""
        array<string> _conf_factors_arr = array.new<string>()
        int htf_b = f_get_latest_mtf_bias(P9_HTF_3)
        if htf_b == dir
            reasons += "HTF Aligned "
            array.push(_conf_factors_arr, "HTF Alignment")
        else if htf_b != TD_NEUTRAL
            penalties += "HTF Conflict "
        if (dir == TD_LONG and st.counters.pd_zone == "Discount") or (dir == TD_SHORT and st.counters.pd_zone == "Premium")
            reasons += "PD Aligned "
            array.push(_conf_factors_arr, "Discount Zone")
        else if (dir == TD_LONG and st.counters.pd_zone == "Premium") or (dir == TD_SHORT and st.counters.pd_zone == "Discount")
            penalties += "PD Conflict "
        if st.current_sweep_validation.isSwept
            reasons += "Liq Sweep "
            array.push(_conf_factors_arr, "Sweep")
        else
            penalties += "No Sweep "
        bool poi_valid = array.size(g_poi_base_id) > 0 and array.get(g_poi_state, array.size(g_poi_base_id)-1) == "Active"
        if poi_valid
            reasons += "POI Active "
            array.push(_conf_factors_arr, "POI")
        else
            penalties += "No POI "
        if poi_valid and array.size(g_poi_registry) > 0
            POIInstance last_poi = array.get(g_poi_registry, array.size(g_poi_registry)-1)
            if last_poi.baseId == array.get(g_poi_base_id, array.size(g_poi_base_id)-1)
                if last_poi.brkLink != ""
                    array.push(_conf_factors_arr, "Breaker")
                if last_poi.mssLink != ""
                    array.push(_conf_factors_arr, "MSS")
                if last_poi.obLink != ""
                    array.push(_conf_factors_arr, "OB")
                if last_poi.fvgLink != ""
                    array.push(_conf_factors_arr, "FVG")
        if st.current_arbitration.isApproved and score >= 60
            action := dir == TD_LONG ? "BUY" : "SELL"
            st.diag.m10_reject_reason := "Approved"
        else if not st.current_validation.isReady
            action := "AVOID"
            penalties += "Validation Failed "
            st.diag.m10_reject_reason := "Validation: " + st.current_validation.failureReason
        else if not st.current_arbitration.isApproved
            action := "WAIT"
            penalties += "Arb Rejected "
            st.diag.m10_reject_reason := "Arbitration: " + st.current_arbitration.reason
        else if score < 60
            action := "AVOID"
            penalties += "Low Confidence "
            st.diag.m10_reject_reason := "Score < 60 (" + str.tostring(score) + ")"
        bool should_emit = true
        string current_poi_id = array.size(g_poi_base_id) > 0 ? array.get(g_poi_base_id, array.size(g_poi_base_id)-1) : "N/A"
        if array.size(g_trade_rec_registry) > 0
            TradeRecommendationInstance last_rec = array.get(g_trade_rec_registry, array.size(g_trade_rec_registry)-1)
            if last_rec.action == action and last_rec.confidence == score and last_rec.poiLink == current_poi_id
                should_emit := false
        if should_emit
            string p_poi = current_poi_id
            string p_brk = "N/A"
            string p_mss = "N/A"
            string p_ob = "N/A"
            string p_fvg = "N/A"
            if p_poi != "N/A" and array.size(g_poi_registry) > 0
                POIInstance last_poi = array.get(g_poi_registry, array.size(g_poi_registry)-1)
                if last_poi.baseId == p_poi
                    p_brk := last_poi.brkLink == "" ? "N/A" : last_poi.brkLink
                    p_mss := last_poi.mssLink == "" ? "N/A" : last_poi.mssLink
                    p_ob := last_poi.obLink == "" ? "N/A" : last_poi.obLink
                    p_fvg := last_poi.fvgLink == "" ? "N/A" : last_poi.fvgLink
            string p_liq = "N/A"
            if not na(st.current_selection.bestOverallPool)
                p_liq := "LIQ-" + str.tostring(st.current_selection.bestOverallPool.id)
            string p_htf = "N/A"
            if array.size(g_mtf_registry) > 0
                for i = array.size(g_mtf_registry) - 1 to 0
                    MTFStructureInstance mtf_m = array.get(g_mtf_registry, i)
                    if mtf_m.timeframe == P9_HTF_3
                        p_htf := mtf_m.baseId
                        break
            string conf_factors_str = array.join(_conf_factors_arr, "|")
            bool rec_integrity = (st.mtf.integ_1 and st.mtf.integ_2 and st.mtf.integ_3) and st.current_arbitration.isApproved and st.current_validation.isReady and score >= 60 and poi_valid
            string newBaseId = na
            int newVer = 1
            int prevScore = 0
            int scoreDelta = score
            if array.size(g_trade_rec_registry) > 0
                TradeRecommendationInstance last_rec = array.get(g_trade_rec_registry, array.size(g_trade_rec_registry)-1)
                bool is_same_opp = (last_rec.action == action) and (last_rec.direction == dir) and (last_rec.poiLink == p_poi) and (action == "BUY" or action == "SELL")
                if is_same_opp
                    newBaseId := last_rec.baseId
                    newVer := last_rec.version + 1
                    prevScore := last_rec.confidence
                    scoreDelta := score - prevScore
                else
                    newBaseId := f_format_id("TR", st.counters.next_trade_rec_id, 1)
                    st.counters.next_trade_rec_id += 1
                    newVer := 1
                    prevScore := 0
                    scoreDelta := score
            else
                newBaseId := f_format_id("TR", st.counters.next_trade_rec_id, 1)
                st.counters.next_trade_rec_id += 1
                newVer := 1
                prevScore := 0
                scoreDelta := score
            string instId = newBaseId + "-v" + str.tostring(newVer)
            string tr_corr = st.bus.current_correlation_id == "INIT" ? "FLOW-SYS" : st.bus.current_correlation_id
            
            int pipe_bars = bar_index - st.current_context.barIndex + 1
            string exit_reason = EXIT_NONE
            if action == "WAIT" or action == "AVOID"
                if not st.current_validation.isReady
                    exit_reason := st.current_trace.reason_str
                else if not st.current_arbitration.isApproved
                    exit_reason := st.current_trace.reason_str
                else if score < 60
                    exit_reason := EXIT_LOW_SCORE

            if enable_validation
                if action == "BUY"
                    st.analytics.val_buys += 1
                    st.analytics.val_sum_conf += score
                    st.analytics.val_sum_rr += rr
                    st.analytics.val_sum_pipe_bars += pipe_bars
                else if action == "SELL"
                    st.analytics.val_sells += 1
                    st.analytics.val_sum_conf += score
                    st.analytics.val_sum_rr += rr
                    st.analytics.val_sum_pipe_bars += pipe_bars
                    
                if action != "BUY" and action != "SELL"
                    if st.current_trace.reason_str == EXIT_NO_POOL
                        st.analytics.val_rej_pool += 1
                    else if st.current_trace.reason_str == EXIT_NO_SWEEP or st.current_trace.reason_str == EXIT_VAL_FAIL
                        st.analytics.val_rej_val += 1
                    else if st.current_trace.reason_str == EXIT_STRAT_REJ
                        st.analytics.val_rej_strat += 1
                    else if st.current_trace.reason_str == EXIT_ARB_REJ
                        st.analytics.val_rej_arb += 1
                    
            TradeRecommendationInstance inst = TradeRecommendationInstance.new(newBaseId, instId, newVer, action, dir, rating, score, prevScore, scoreDelta, risk_score, rr, entry, sl, tp, p_poi, p_brk, p_mss, p_ob, p_fvg, p_liq, p_htf, conf_factors_str, reasons, penalties, rec_integrity, bar_index, tr_corr, exit_reason, pipe_bars)
            
            array.push(g_trade_rec_registry, inst)
            array.push(g_trade_rec_base_id, instId)
            array.push(g_trade_rec_action, action)
            array.push(g_trade_rec_rating, rating)
            array.push(g_trade_rec_score, score)
            if array.size(g_trade_rec_registry) > 500
                array.shift(g_trade_rec_registry)
                array.shift(g_trade_rec_base_id)
                array.shift(g_trade_rec_action)
                array.shift(g_trade_rec_rating)
                array.shift(g_trade_rec_score)
                
            st.counters.trade_rec_total_emitted += 1
            st.diag.m10_latest_action := action
            st.diag.m10_latest_rating := rating
            st.diag.m10_latest_score := score
            st.diag.m10_latest_risk_score := risk_score
            st.diag.m10_latest_risk := risk_score <= 30 ? "Low" : risk_score <= 70 ? "Medium" : "High"
            st.diag.m10_latest_rr := rr
            st.diag.m10_latest_entry := entry
            st.diag.m10_latest_sl := sl
            st.diag.m10_latest_tp := tp
            st.diag.m10_latest_reasons := reasons
            st.diag.m10_latest_penalties := penalties
            int tr_sev = action == "BUY" or action == "SELL" ? SEV_INFO : SEV_WARNING
            string tr_out = action == "BUY" or action == "SELL" ? "SUCCESS" : action == "AVOID" ? "REJECTED" : "SKIPPED"
            bus_evt_id := st.bus.next_event_id
            st.bus.next_event_id += 1
            st.bus.event_total_emitted += 1
            _ = f_bus_emit(bus_evt_id, st.bus.last_event_id, tr_corr, MOD_TR, EVENT_EMIT, tr_sev, tr_out, instId, action + " " + rating + " (Score:" + str.tostring(score) + ", Δ" + str.tostring(scoreDelta) + ")", "RR=" + str.tostring(rr, "#.#") + "|Score=" + str.tostring(score) + "|Risk=" + str.tostring(risk_score), rec_integrity)
            st.bus.last_event_id := bus_evt_id
            
            if action == "BUY" or action == "SELL"
                log.info("--- TRADE GENERATED ---")
                log.info("Action: " + action + " | Score: " + str.tostring(score) + " | RR: " + str.tostring(rr, "#.#"))
                log.info("Entry: " + str.tostring(entry, "#.##") + " | SL: " + str.tostring(sl, "#.##") + " | TP: " + str.tostring(tp, "#.##"))
                log.info("Pool: " + p_liq + " | POI: " + p_poi + " | HTF: " + p_htf)
                log.info("Correlation: " + tr_corr + " | Exit Reason: " + exit_reason)
    st

f_record_audit_result(EngineState state, string type, int sev, string status, string objId, string mod, string corrId, string msg, string rec) =>
    EngineState st = state
    int bus_evt_id = 0
    int aId = st.audit.next_audit_id
    st.audit.next_audit_id += 1
    st.audit.audit_total_emitted += 1
    AuditResultInstance audit_inst = AuditResultInstance.new(aId, type, sev, status, objId, mod, corrId, msg, rec, status == AUDIT_PASS, AUDIT_SCHEMA_VERSION, time, bar_index)
    array.push(g_audit_registry, audit_inst)
    if array.size(g_audit_registry) > 250
        array.shift(g_audit_registry)
    if status == AUDIT_FAIL
        st.audit.m12_cycle_failures += 1
        st.audit.lifetime_audit_failures += 1
        if sev == SEV_ERROR or sev == SEV_CRITICAL
            st.audit.audit_last_failure_msg := type + ": " + msg
    else if status == AUDIT_WARNING
        st.audit.m12_cycle_warnings += 1
        st.audit.lifetime_audit_warnings += 1
    else if status == AUDIT_PASS
        st.audit.m12_cycle_passed += 1
        st.audit.lifetime_audit_passed += 1
    else if status == AUDIT_SKIPPED
        st.audit.m12_cycle_skipped += 1
    if status == AUDIT_FAIL and (sev == SEV_ERROR or sev == SEV_CRITICAL)
        bus_evt_id := st.bus.next_event_id
        st.bus.next_event_id += 1
        st.bus.event_total_emitted += 1
        _ = f_bus_emit(bus_evt_id, st.bus.last_event_id, corrId, MOD_AUDIT, EVENT_ERROR, sev, "FAILED", objId, "Audit Fail: " + msg, "Type=" + type + "|Rec=" + rec, false)
        st.bus.last_event_id := bus_evt_id
    st

f_compute_m12(EngineState state) =>
    EngineState st = state
    if barstate.isconfirmed
        st.audit.m12_cycle_failures := 0
        st.audit.m12_cycle_warnings := 0
        st.audit.m12_cycle_passed := 0
        st.audit.m12_cycle_skipped := 0
        bool is_heavy_cycle = bar_index % AUDIT_INTERVAL == 0
        if array.size(g_trade_rec_registry) > 0
            TradeRecommendationInstance last_tr = array.get(g_trade_rec_registry, array.size(g_trade_rec_registry)-1)
            if last_tr.confidence < 0 or last_tr.confidence > 100
                st := f_record_audit_result(st, AUDIT_STRUCTURE, SEV_ERROR, AUDIT_FAIL, last_tr.instanceId, "M10", last_tr.correlationId, "Score out of bounds (0-100)", "Recalculate score")
            else
                st := f_record_audit_result(st, AUDIT_STRUCTURE, SEV_INFO, AUDIT_PASS, last_tr.instanceId, "M10", last_tr.correlationId, "Score within bounds", "None")
            if last_tr.version <= 0
                st := f_record_audit_result(st, AUDIT_STRUCTURE, SEV_ERROR, AUDIT_FAIL, last_tr.instanceId, "M10", last_tr.correlationId, "Invalid version number", "Re-emit recommendation")
            else
                st := f_record_audit_result(st, AUDIT_STRUCTURE, SEV_INFO, AUDIT_PASS, last_tr.instanceId, "M10", last_tr.correlationId, "Version valid", "None")
            bool poi_found = false
            if array.size(g_poi_registry) > 0
                POIInstance last_poi = array.get(g_poi_registry, array.size(g_poi_registry)-1)
                if last_poi.baseId == last_tr.poiLink
                    poi_found := true
                    if last_poi.integrity
                        st := f_record_audit_result(st, AUDIT_STRUCTURE, SEV_INFO, AUDIT_PASS, last_poi.instanceId, "M8", last_tr.correlationId, "POI integrity verified", "None")
                    else
                        st := f_record_audit_result(st, AUDIT_STRUCTURE, SEV_WARNING, AUDIT_FAIL, last_poi.instanceId, "M8", last_tr.correlationId, "POI integrity flag is false", "Review POI creation")
                    if last_poi.obLink != "" and array.indexof(g_ob_base_id, last_poi.obLink) != -1
                        st := f_record_audit_result(st, AUDIT_DEPENDENCY, SEV_INFO, AUDIT_PASS, last_poi.obLink, "M5", last_tr.correlationId, "OB dependency exists", "None")
                    else
                        st := f_record_audit_result(st, AUDIT_DEPENDENCY, SEV_ERROR, AUDIT_FAIL, last_poi.instanceId, "M8", last_tr.correlationId, "Missing Order Block dependency", "Invalidate POI")
                    if last_poi.fvgLink != "" and array.indexof(g_fvg_base_id, last_poi.fvgLink) != -1
                        st := f_record_audit_result(st, AUDIT_DEPENDENCY, SEV_INFO, AUDIT_PASS, last_poi.fvgLink, "M4", last_tr.correlationId, "FVG dependency exists", "None")
                    else
                        st := f_record_audit_result(st, AUDIT_DEPENDENCY, SEV_ERROR, AUDIT_FAIL, last_poi.instanceId, "M8", last_tr.correlationId, "Missing FVG dependency", "Invalidate POI")
                    if last_poi.mssLink != ""
                        if array.size(g_mss_base_id) > 0 and array.indexof(g_mss_base_id, last_poi.mssLink) != -1
                            st := f_record_audit_result(st, AUDIT_DEPENDENCY, SEV_INFO, AUDIT_PASS, last_poi.mssLink, "M6", last_tr.correlationId, "MSS dependency exists", "None")
                        else
                            st := f_record_audit_result(st, AUDIT_DEPENDENCY, SEV_WARNING, AUDIT_FAIL, last_poi.instanceId, "M8", last_tr.correlationId, "MSS reference broken", "Update POI links")
                    else
                        st := f_record_audit_result(st, AUDIT_DEPENDENCY, SEV_INFO, AUDIT_SKIPPED, last_poi.instanceId, "M6", last_tr.correlationId, "No MSS link (optional)", "None")
                    if last_poi.brkLink != ""
                        if array.size(g_brk_base_id) > 0 and array.indexof(g_brk_base_id, last_poi.brkLink) != -1
                            st := f_record_audit_result(st, AUDIT_DEPENDENCY, SEV_INFO, AUDIT_PASS, last_poi.brkLink, "M7", last_tr.correlationId, "Breaker dependency exists", "None")
                        else
                            st := f_record_audit_result(st, AUDIT_DEPENDENCY, SEV_WARNING, AUDIT_FAIL, last_poi.instanceId, "M8", last_tr.correlationId, "Breaker reference broken", "Update POI links")
                    else
                        st := f_record_audit_result(st, AUDIT_DEPENDENCY, SEV_INFO, AUDIT_SKIPPED, last_poi.instanceId, "M7", last_tr.correlationId, "No Breaker link (optional)", "None")
                    if last_tr.liqLink != "N/A"
                        st := f_record_audit_result(st, AUDIT_DEPENDENCY, SEV_INFO, AUDIT_PASS, last_tr.liqLink, "M2", last_tr.correlationId, "Liquidity dependency exists", "None")
                    else
                        st := f_record_audit_result(st, AUDIT_DEPENDENCY, SEV_WARNING, AUDIT_FAIL, last_tr.instanceId, "M2", last_tr.correlationId, "Missing Liquidity dependency", "Review trade creation")
                    if last_tr.htfLink != "N/A"
                        st := f_record_audit_result(st, AUDIT_DEPENDENCY, SEV_INFO, AUDIT_PASS, last_tr.htfLink, "M1", last_tr.correlationId, "HTF dependency exists", "None")
                    else
                        st := f_record_audit_result(st, AUDIT_DEPENDENCY, SEV_WARNING, AUDIT_FAIL, last_tr.instanceId, "M1", last_tr.correlationId, "Missing HTF dependency", "Review trade creation")
            if not poi_found and last_tr.poiLink != "N/A"
                st := f_record_audit_result(st, AUDIT_DEPENDENCY, SEV_ERROR, AUDIT_FAIL, last_tr.instanceId, "M10", last_tr.correlationId, "Missing POI dependency for Trade", "Reject Trade")
        if is_heavy_cycle
            if array.size(g_event_registry) > 0
                int last_evt_id = array.get(g_event_registry, array.size(g_event_registry)-1).eventId
                if last_evt_id == st.bus.event_total_emitted
                    st := f_record_audit_result(st, AUDIT_REGISTRY, SEV_INFO, AUDIT_PASS, "EVENT_REGISTRY", "M11", "SYS", "Event ID sequence valid", "None")
                else
                    st := f_record_audit_result(st, AUDIT_REGISTRY, SEV_WARNING, AUDIT_FAIL, "EVENT_REGISTRY", "M11", "SYS", "Event ID mismatch detected", "Review event emission logic")
            if array.size(g_poi_registry) > 0
                for i = 0 to array.size(g_poi_registry) - 1
                    POIInstance poi_p = array.get(g_poi_registry, i)
                    if poi_p.obLink != "" and array.indexof(g_ob_base_id, poi_p.obLink) == -1
                        st := f_record_audit_result(st, AUDIT_REGISTRY, SEV_ERROR, AUDIT_FAIL, poi_p.instanceId, "M8", poi_p.correlationId, "POI contains orphaned OB link", "Invalidate POI")
                    if poi_p.fvgLink != "" and array.indexof(g_fvg_base_id, poi_p.fvgLink) == -1
                        st := f_record_audit_result(st, AUDIT_REGISTRY, SEV_ERROR, AUDIT_FAIL, poi_p.instanceId, "M8", poi_p.correlationId, "POI contains orphaned FVG link", "Invalidate POI")
            st := f_record_audit_result(st, AUDIT_REGISTRY, SEV_INFO, AUDIT_PASS, "ALL_REGISTRIES", "M12", "SYS", "Registry scan complete", "None")
        int cycle_score = 100
        cycle_score := math.max(0, cycle_score - (st.audit.m12_cycle_failures * 10))
        cycle_score := math.max(0, cycle_score - (st.audit.m12_cycle_warnings * 5))
        st.audit.m12_cycle_trust_score := cycle_score
        if enable_validation
            st.analytics.val_sum_audit_trust += cycle_score
        int cycle_total = st.audit.m12_cycle_passed + st.audit.m12_cycle_warnings + st.audit.m12_cycle_failures + st.audit.m12_cycle_skipped
        string summary_str = "Cycle " + str.tostring(st.audit.next_audit_cycle_id) + " | Pass=" + str.tostring(st.audit.m12_cycle_passed) + " | Warn=" + str.tostring(st.audit.m12_cycle_warnings) + " | Fail=" + str.tostring(st.audit.m12_cycle_failures) + " | Skip=" + str.tostring(st.audit.m12_cycle_skipped) + " | Trust=" + str.tostring(cycle_score)
        st.audit.m12_last_summary := summary_str
        AuditSummaryInstance summary = AuditSummaryInstance.new(st.audit.next_audit_cycle_id, time, bar_index, cycle_score, cycle_total, st.audit.m12_cycle_passed, st.audit.m12_cycle_warnings, st.audit.m12_cycle_failures, st.audit.m12_cycle_skipped, summary_str)
        array.push(g_audit_summary_registry, summary)
        if array.size(g_audit_summary_registry) > 100
            array.shift(g_audit_summary_registry)
        st.audit.next_audit_cycle_id += 1
    st

f_compute_m13(EngineState state) =>
    EngineState st = state
    if barstate.isconfirmed and (bar_index % ANALYTICS_INTERVAL == 0 or barstate.islast)
        int total_recs = array.size(g_trade_rec_registry)
        float sum_conf = 0.0
        int b_60_69 = 0
        int b_70_79 = 0
        int b_80_89 = 0
        int b_90_100 = 0
        int g_ap = 0
        int g_a = 0
        int g_b = 0
        int g_c = 0
        int f_htf = 0
        int f_ob = 0
        int f_fvg = 0
        int f_brk = 0
        int f_swp = 0
        int f_pd = 0
        string most_common_fail = "None"
        
        int _rej_pool = 0
        int _rej_sweep = 0
        int _rej_val = 0
        int _rej_strat = 0
        int _rej_arb = 0
        int _rej_low_score = 0
        int _fvg_used = 0
        int _ob_used = 0
        int _brk_used = 0
        float _sum_pipe_bars = 0.0
        int _max_pipe_bars = 0
        
        if dev_mode
            if total_recs > 0
                for i = 0 to total_recs - 1
                    TradeRecommendationInstance tr = array.get(g_trade_rec_registry, i)
                    int conf = tr.confidence
                    sum_conf += conf
                    if conf >= 60 and conf <= 69
                        b_60_69 += 1
                    else if conf >= 70 and conf <= 79
                        b_70_79 += 1
                    else if conf >= 80 and conf <= 89
                        b_80_89 += 1
                    else if conf >= 90
                        b_90_100 += 1
                    if str.contains(tr.confidenceFactors, "HTF")
                        f_htf += 1
                    if str.contains(tr.confidenceFactors, "OB")
                        f_ob += 1
                    if str.contains(tr.confidenceFactors, "FVG")
                        f_fvg += 1
                    if str.contains(tr.confidenceFactors, "Breaker")
                        f_brk += 1
                    if str.contains(tr.confidenceFactors, "Sweep")
                        f_swp += 1
                    if str.contains(tr.confidenceFactors, "PD")
                        f_pd += 1
                        
                    if tr.action != "BUY" and tr.action != "SELL"
                        if tr.exitReason == EXIT_NO_POOL
                            _rej_pool += 1
                        else if tr.exitReason == EXIT_NO_SWEEP
                            _rej_sweep += 1
                        else if tr.exitReason == EXIT_VAL_FAIL
                            _rej_val += 1
                        else if tr.exitReason == EXIT_STRAT_REJ
                            _rej_strat += 1
                        else if tr.exitReason == EXIT_ARB_REJ
                            _rej_arb += 1
                        else if tr.exitReason == EXIT_LOW_SCORE
                            _rej_low_score += 1
                            
                    if tr.action == "BUY" or tr.action == "SELL"
                        if tr.fvgLink != "N/A"
                            _fvg_used += 1
                        if tr.obLink != "N/A"
                            _ob_used += 1
                        if tr.brkLink != "N/A"
                            _brk_used += 1
                            
                    _sum_pipe_bars += tr.pipelineBars
                    if tr.pipelineBars > _max_pipe_bars
                        _max_pipe_bars := tr.pipelineBars
                        
            if array.size(g_poi_registry) > 0
                for i = 0 to array.size(g_poi_registry) - 1
                    POIInstance poi_p = array.get(g_poi_registry, i)
                    if poi_p.grade == "A+"
                        g_ap += 1
                    else if poi_p.grade == "A"
                        g_a += 1
                    else if poi_p.grade == "B"
                        g_b += 1
                    else if poi_p.grade == "C"
                        g_c += 1
            if array.size(g_audit_registry) > 0
                int c_structure = 0
                int c_dependency = 0
                int c_registry = 0
                int c_replay = 0
                int c_engine = 0
                for i = 0 to array.size(g_audit_registry) - 1
                    AuditResultInstance a = array.get(g_audit_registry, i)
                    if a.status == AUDIT_FAIL
                        if a.auditType == AUDIT_STRUCTURE
                            c_structure += 1
                        else if a.auditType == AUDIT_DEPENDENCY
                            c_dependency += 1
                        else if a.auditType == AUDIT_REGISTRY
                            c_registry += 1
                        else if a.auditType == AUDIT_REPLAY
                            c_replay += 1
                        else if a.auditType == AUDIT_ENGINE
                            c_engine += 1
                int max_count = 0
                if c_structure > max_count
                    max_count := c_structure
                    most_common_fail := "STRUCTURE"
                if c_dependency > max_count
                    max_count := c_dependency
                    most_common_fail := "DEPENDENCY"
                if c_registry > max_count
                    max_count := c_registry
                    most_common_fail := "REGISTRY"
                if c_replay > max_count
                    max_count := c_replay
                    most_common_fail := "REPLAY"
                if c_engine > max_count
                    max_count := c_engine
                    most_common_fail := "ENGINE"
        else
            most_common_fail := "Disabled"
            
        float avg_conf = total_recs > 0 ? sum_conf / total_recs : 0.0
        float avg_pipe_bars = total_recs > 0 ? _sum_pipe_bars / total_recs : 0.0
        
        int total_rej = _rej_pool + _rej_sweep + _rej_val + _rej_strat + _rej_arb + _rej_low_score
        string rej_dist = "Sel: " + str.tostring(total_rej > 0 ? math.round(_rej_pool / total_recs * 100) : 0) + "% | " +
                          "Val: " + str.tostring(total_rej > 0 ? math.round((_rej_sweep + _rej_val) / total_recs * 100) : 0) + "% | " +
                          "Strat: " + str.tostring(total_rej > 0 ? math.round(_rej_strat / total_recs * 100) : 0) + "% | " +
                          "Arb: " + str.tostring(total_rej > 0 ? math.round(_rej_arb / total_recs * 100) : 0) + "% | " +
                          "Score: " + str.tostring(total_rej > 0 ? math.round(_rej_low_score / total_recs * 100) : 0) + "%"
                          
        string poi_util = "FVG: " + str.tostring(_fvg_used) + "/" + str.tostring(st.counters.fvg_total_emitted) + " | " +
                          "OB: " + str.tostring(_ob_used) + "/" + str.tostring(st.counters.ob_total_emitted) + " | " +
                          "BRK: " + str.tostring(_brk_used) + "/" + str.tostring(st.counters.brk_total_emitted)
        
        AnalyticsSummaryInstance snap = AnalyticsSummaryInstance.new(
            st.analytics.next_analytics_id, time, bar_index, total_recs, avg_conf, 
            b_60_69, b_70_79, b_80_89, b_90_100, 
            g_ap, g_a, g_b, g_c, 
            f_htf, f_ob, f_fvg, f_brk, f_swp, f_pd, 
            most_common_fail, 0, 0, 0.0, 0.0, 0.0,
            _rej_pool, _rej_sweep, _rej_val, _rej_strat, _rej_arb, _rej_low_score,
            _fvg_used, _ob_used, _brk_used,
            avg_pipe_bars, _max_pipe_bars
        )
        array.push(g_analytics_registry, snap)
        if array.size(g_analytics_registry) > 100
            array.shift(g_analytics_registry)
        st.analytics.next_analytics_id += 1
        st.analytics.m13_last_snapshot_id := snap.snapshotId
        st.analytics.m13_last_total_recs := total_recs
        st.analytics.m13_last_avg_conf := avg_conf
        st.analytics.m13_last_common_audit := most_common_fail
        st.analytics.m13_last_summary := "Snap #" + str.tostring(snap.snapshotId) + " | Recs=" + str.tostring(total_recs) + " | AvgConf=" + str.tostring(avg_conf, "#.#")
        st.analytics.m13_last_rej_dist := rej_dist
        st.analytics.m13_last_poi_util := poi_util
        st.analytics.m13_last_avg_pipe := avg_pipe_bars
        st.analytics.m13_last_max_pipe := _max_pipe_bars
    st

f_get_closest_indices(array<float> src_dist, int max_count, float max_d) =>
    array<int> result = array.new<int>()
    if array.size(src_dist) > 0 and not na(max_d)
        array<float> temp_dist = array.copy(src_dist)
        int sz = array.size(temp_dist)
        for k = 0 to math.min(max_count, sz) - 1
            int min_idx = -1
            float min_dist = 9999999.0
            for i = 0 to sz - 1
                float d = array.get(temp_dist, i)
                if not na(d) and d < min_dist and d <= max_d
                    min_dist := d
                    min_idx := i
            if min_idx == -1
                break
            array.push(result, min_idx)
            array.set(temp_dist, min_idx, 9999999.0)
    result

