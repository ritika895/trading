var array<bool>   g_pd_integ  = array.new<bool>(1, false)

f_pd_emit(float r_high, float r_low, float r_size, float eq, float cur_price, float pos_pct, string zone, bool integ) =>
    bool changed = false
    string prevId = ""
    int newVer = 1
    
    int currentVer = array.get(g_pd_ver, 0)
    
    if currentVer == 0
        changed := true
    else if array.get(g_pd_high, 0) != r_high or array.get(g_pd_low, 0) != r_low or array.get(g_pd_zone, 0) != zone or array.get(g_pd_integ, 0) != integ
        changed := true
        prevId  := "PD-ARRAY-v" + str.tostring(currentVer)
        newVer  := currentVer + 1
        
    PDArrayInstance inst = na
    if changed
        array.set(g_pd_ver, 0, newVer)
        array.set(g_pd_high, 0, r_high)
        array.set(g_pd_low, 0, r_low)
        array.set(g_pd_zone, 0, zone)
        array.set(g_pd_integ, 0, integ)
        
        string instId = "PD-ARRAY-v" + str.tostring(newVer)
        inst := PDArrayInstance.new(
             "PD-ARRAY", instId, prevId,
             "PDArray", P9_PD_MODULE,
             bar_index, "Active", integ,
             P9_PD_CVER,
             r_high, r_low, r_size, eq, cur_price, pos_pct, zone, time)
        array.push(g_pd_registry, inst)
        
        f_p9_log(P9_PD_MODULE, "PD_EMIT", instId, integ)
        
    inst

f_compute_pd_array() =>
    int t0 = timenow
    
    float r_high = g_last_swing_high_price
    float r_low = g_last_swing_low_price
    bool integ = not na(r_high) and not na(r_low) and f_mtf_all_ok()
    
    float r_size = na
    float eq = na
    float pos_pct = 50.0
    string zone = "Equilibrium"
    float cur_price = close
    
    if integ
        r_size := r_high - r_low
        eq := r_low + (r_size * 0.5)
        
        // positionPercent is intentionally unbounded to capture sweeps and extensions:
        // 0-100 = Inside dealing range (0 = Range Low, 50 = Eq, 100 = Range High)
        // >100  = Above range high (bullish extension / buy-side sweep)
        // <0    = Below range low (bearish extension / sell-side sweep)
        pos_pct := r_size == 0 ? 50.0 : ((cur_price - r_low) / r_size) * 100.0
        zone := pos_pct > 50.0 ? "Premium" : pos_pct < 50.0 ? "Discount" : "Equilibrium"
        
    PDArrayInstance e = f_pd_emit(r_high, r_low, r_size, eq, cur_price, pos_pct, zone, integ)
    
    if bar_index % 50 == 0
        int elapsed = timenow - t0
        HealthPing hp = HealthPing.new(
             P9_PD_MODULE,
             array.size(g_pd_registry),
             500,
             elapsed,
             0, 0, 0, 0)
        array.push(g_p9_health_pings, hp)
        
    // Return live values for debug panel
    [e, r_high, r_low, eq, cur_price, pos_pct, zone, integ]

// Execution
[g_pd_emitted, dbg_r_high, dbg_r_low, dbg_eq, dbg_cur_price, dbg_pos_pct, dbg_zone, dbg_integ] = f_compute_pd_array()

