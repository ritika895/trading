type SelectionResult
    LiquidityPool bestBullPool
    LiquidityPool bestBearPool
    LiquidityPool bestOverallPool
    string        selectionReason
    float         selectionConfidence

f_score_pool(LiquidityPool p) =>
    float score = p.confidence
    if p.state == LS_REINFORCED
        score += 0.5   
        score += p.touchCount * 0.1 
    score

f_run_selection_engine() =>
    LiquidityPool bestBull = na
    float bestBullScore = -1.0
    
    LiquidityPool bestBear = na
    float bestBearScore = -1.0
    
    string reason = "No eligible pools found."
    float confidence = 0.0

    if array.size(g_registry) > 0
        for i = 0 to array.size(g_registry) - 1
            LiquidityPool p = array.get(g_registry, i)
            
            if p.state == LS_ACTIVE or p.state == LS_REINFORCED or p.state == LS_SWEPT
                float score = f_score_pool(p)
                
                if p.poolType == LT_BUY_SIDE
                    if score > bestBullScore
                        bestBullScore := score
                        bestBull := p
                else if p.poolType == LT_SELL_SIDE
                    if score > bestBearScore
                        bestBearScore := score
                        bestBear := p

    LiquidityPool bestOverall = na
    if not na(bestBull) and not na(bestBear)
        if bestBullScore >= bestBearScore
            bestOverall := bestBull
            reason := "Bullish selected (Highest Score)."
            confidence := bestBull.confidence
        else
            bestOverall := bestBear
            reason := "Bearish selected (Highest Score)."
            confidence := bestBear.confidence
    else if not na(bestBull)
        bestOverall := bestBull
        reason := "Bullish selected (No Bearish competition)."
        confidence := bestBull.confidence
    else if not na(bestBear)
        bestOverall := bestBear
        reason := "Bearish selected (No Bullish competition)."
        confidence := bestBear.confidence

    SelectionResult.new(bestBull, bestBear, bestOverall, reason, confidence)

