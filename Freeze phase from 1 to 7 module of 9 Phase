f_state_to_string(int state) =>
    string res = "UNKNOWN"
    if state == LS_FORMED
        res := "FORMED"
    else if state == LS_ACTIVE
        res := "ACTIVE"
    else if state == LS_REINFORCED
        res := "REINFORCED"
    else if state == LS_SWEPT
        res := "SWEPT"
    else if state == LS_INVALIDATED
        res := "INVALIDATED"
    else if state == LS_EXPIRED
        res := "EXPIRED"
    res

f_score_pool(LiquidityPool p) =>
    float score = p.confidence
    if p.state == LS_REINFORCED
        score += 0.5   
        score += p.touchCount * 0.1 
    score

