string P9_HTF_1 = input.timeframe("60",  "HTF 1", group="Phase 9 — MTF Structure")
string P9_HTF_2 = input.timeframe("240", "HTF 2", group="Phase 9 — MTF Structure")
string P9_HTF_3 = input.timeframe("D",   "HTF 3", group="Phase 9 — MTF Structure")

f_get_htf_data(int lookback) =>
    float h_ph = ta.pivothigh(high, lookback, lookback)
    float h_pl = ta.pivotlow(low, lookback, lookback)
    [h_ph, h_pl, close, time]

[ph1, pl1, c1, t1] = request.security(syminfo.tickerid, P9_HTF_1, f_get_htf_data(SWING_LOOKBACK))
[ph2, pl2, c2, t2] = request.security(syminfo.tickerid, P9_HTF_2, f_get_htf_data(SWING_LOOKBACK))
[ph3, pl3, c3, t3] = request.security(syminfo.tickerid, P9_HTF_3, f_get_htf_data(SWING_LOOKBACK))

f_get_latest_mtf_bias(string tf) =>
    int bias = TD_NEUTRAL
    int sz = array.size(g_mtf_registry)
    if sz > 0
        for i = sz - 1 to 0
            MTFStructureInstance m = array.get(g_mtf_registry, i)
            if m.timeframe == tf
                bias := m.structuralBias
                break
    bias

f_compute_p9(EngineState S) =>
    bool _p8_integ = not na(S.current_context) and S.current_context.atr > 0

    if array.size(g_p9_event_log) > 200
        array.shift(g_p9_event_log)

    bool _liq_integ = _p8_integ and (S.mtf_integ_1 and S.mtf_integ_2 and S.mtf_integ_3)
    if _p8_integ
        if not na(ph1)
            S.mtf_hi_1 := ph1
        if not na(pl1)
            S.mtf_lo_1 := pl1
        if t1 != S.mtf_t_1
            if not na(S.mtf_hi_1) and c1 > S.mtf_hi_1
                if S.mtf_bias_1 == TD_SHORT
                    S.mtf_choch_1 := TD_LONG
                else
                    S.mtf_bos_1 := TD_LONG
                S.mtf_bias_1 := TD_LONG
            if not na(S.mtf_lo_1) and c1 < S.mtf_lo_1
                if S.mtf_bias_1 == TD_LONG
                    S.mtf_choch_1 := TD_SHORT
                else
                    S.mtf_bos_1 := TD_SHORT
                S.mtf_bias_1 := TD_SHORT
            S.mtf_t_1 := t1
        S.mtf_integ_1 := _p8_integ
        bool mtf_changed_1 = S.mtf_bias_1 != S.mtf_l_bias_1 or S.mtf_bos_1 != S.mtf_l_bos_1 or S.mtf_choch_1 != S.mtf_l_choch_1 or S.mtf_integ_1 != S.mtf_l_integ_1 or S.mtf_ver_1 == 0
        if mtf_changed_1
            S.mtf_ver_1 := S.mtf_ver_1 == 0 ? 1 : S.mtf_ver_1 + 1
            string baseId = "MTF-" + P9_HTF_1
            string instId = baseId + "-v" + str.tostring(S.mtf_ver_1)
            string prevId = S.mtf_ver_1 == 1 ? "" : baseId + "-v" + str.tostring(S.mtf_ver_1 - 1)
            MTFStructureInstance inst = MTFStructureInstance.new(baseId, instId, prevId, "MTFStructure", "MTFStructureAdapter", bar_index, "Active", _p8_integ, "MTFStructureContract-1.0", P9_HTF_1, S.mtf_bias_1, S.mtf_bos_1, S.mtf_choch_1, time)
            array.push(g_mtf_registry, inst)
            if array.size(g_mtf_registry) > 100
                array.shift(g_mtf_registry)
            int newId = S.p9_next_evt_id
            S.p9_next_evt_id += 1
            array.push(g_p9_event_log, P9Event.new(newId, "MTFStructureAdapter", "MTF_EMIT", instId, time, _p8_integ))
            S.mtf_l_bias_1 := S.mtf_bias_1
            S.mtf_l_bos_1 := S.mtf_bos_1
            S.mtf_l_choch_1 := S.mtf_choch_1
            S.mtf_l_integ_1 := S.mtf_integ_1

        if not na(ph2)
            S.mtf_hi_2 := ph2
        if not na(pl2)
            S.mtf_lo_2 := pl2
        if t2 != S.mtf_t_2
            if not na(S.mtf_hi_2) and c2 > S.mtf_hi_2
                if S.mtf_bias_2 == TD_SHORT
                    S.mtf_choch_2 := TD_LONG
                else
                    S.mtf_bos_2 := TD_LONG
                S.mtf_bias_2 := TD_LONG
            if not na(S.mtf_lo_2) and c2 < S.mtf_lo_2
                if S.mtf_bias_2 == TD_LONG
                    S.mtf_choch_2 := TD_SHORT
                else
                    S.mtf_bos_2 := TD_SHORT
                S.mtf_bias_2 := TD_SHORT
            S.mtf_t_2 := t2
        S.mtf_integ_2 := _p8_integ
        bool mtf_changed_2 = S.mtf_bias_2 != S.mtf_l_bias_2 or S.mtf_bos_2 != S.mtf_l_bos_2 or S.mtf_choch_2 != S.mtf_l_choch_2 or S.mtf_integ_2 != S.mtf_l_integ_2 or S.mtf_ver_2 == 0
        if mtf_changed_2
            S.mtf_ver_2 := S.mtf_ver_2 == 0 ? 1 : S.mtf_ver_2 + 1
            string baseId = "MTF-" + P9_HTF_2
            string instId = baseId + "-v" + str.tostring(S.mtf_ver_2)
            string prevId = S.mtf_ver_2 == 1 ? "" : baseId + "-v" + str.tostring(S.mtf_ver_2 - 1)
            MTFStructureInstance inst = MTFStructureInstance.new(baseId, instId, prevId, "MTFStructure", "MTFStructureAdapter", bar_index, "Active", _p8_integ, "MTFStructureContract-1.0", P9_HTF_2, S.mtf_bias_2, S.mtf_bos_2, S.mtf_choch_2, time)
            array.push(g_mtf_registry, inst)
            if array.size(g_mtf_registry) > 100
                array.shift(g_mtf_registry)
            int newId = S.p9_next_evt_id
            S.p9_next_evt_id += 1
            array.push(g_p9_event_log, P9Event.new(newId, "MTFStructureAdapter", "MTF_EMIT", instId, time, _p8_integ))
            S.mtf_l_bias_2 := S.mtf_bias_2
            S.mtf_l_bos_2 := S.mtf_bos_2
            S.mtf_l_choch_2 := S.mtf_choch_2
            S.mtf_l_integ_2 := S.mtf_integ_2

        if not na(ph3)
            S.mtf_hi_3 := ph3
        if not na(pl3)
            S.mtf_lo_3 := pl3
        if t3 != S.mtf_t_3
            if not na(S.mtf_hi_3) and c3 > S.mtf_hi_3
                if S.mtf_bias_3 == TD_SHORT
                    S.mtf_choch_3 := TD_LONG
                else
                    S.mtf_bos_3 := TD_LONG
                S.mtf_bias_3 := TD_LONG
            if not na(S.mtf_lo_3) and c3 < S.mtf_lo_3
                if S.mtf_bias_3 == TD_LONG
                    S.mtf_choch_3 := TD_SHORT
                else
                    S.mtf_bos_3 := TD_SHORT
                S.mtf_bias_3 := TD_SHORT
