f_get_closest_indices(array<float> src_dist, int max_count, float max_d) =>
    array<int> result = array.new<int>()
    if array.size(src_dist) > 0 and not na(max_d)
        array<float> temp_dist = array.copy(src_dist)
        int sz = array.size(temp_dist)
        for k = 0 to math.min(max_count, sz) - 1
            int min_idx = -1
            float min_dist = 9999999.0
            for i = 0 to sz - 1
                float d = array.get(temp_dist, i)
                if not na(d) and d < min_dist and d <= max_d
                    min_dist := d
                    min_idx := i
            if min_idx == -1
                break
            array.push(result, min_idx)
            array.set(temp_dist, min_idx, 9999999.0)
    result

f_render_engine(EngineState S) =>
    float max_render_dist = na(S.current_context.atr) ? 0.0 : MAX_RENDER_DIST_MULT * S.current_context.atr

    S.drawn_fvg := 0
    if array.size(fvg_boxes) > 0
        for i = 0 to array.size(fvg_boxes) - 1
            box.set_bgcolor(array.get(fvg_boxes, i), color.new(color.black, 100))
            box.set_text(array.get(fvg_boxes, i), "")

    if show_fvg_vis and array.size(g_fvg_base_id) > 0
        array<float> fvg_dist = array.new<float>()
        for i = 0 to array.size(g_fvg_base_id) - 1
            float mid = (array.get(g_fvg_top, i) + array.get(g_fvg_bot, i)) / 2.0
            array.push(fvg_dist, math.abs(close - mid))
        
        array<int> indices = f_get_closest_indices(fvg_dist, MAX_VISUALS, max_render_dist)
        
        if array.size(indices) > 0
            while array.size(fvg_boxes) < array.size(indices)
                array.push(fvg_boxes, box.new(na, na, na, na, text="", text_halign=text.align_center, text_size=size.tiny, text_color=color.white))
                
            for k = 0 to array.size(indices) - 1
                int i = array.get(indices, k)
                if i < array.size(g_fvg_base_id)
                    box b = array.get(fvg_boxes, k)
                    string state = array.get(g_fvg_state, i)
                    int dir = array.get(g_fvg_dir, i)
                    int transp = state == "Active" ? 80 : 90
                    color c = dir == TD_LONG ? color.new(color.green, transp) : color.new(color.red, transp)
                    box.set_bgcolor(b, c)
                    box.set_lefttop(b, bar_index - 50, array.get(g_fvg_top, i))
                    box.set_rightbottom(b, bar_index, array.get(g_fvg_bot, i))
                    string txt = array.get(g_fvg_base_id, i) + "-v" + str.tostring(array.get(g_fvg_ver, i)) + "\n" + (dir == TD_LONG ? "Bull FVG" : "Bear FVG") + "\n" + state
                    box.set_text(b, txt)
                    S.drawn_fvg += 1

    S.drawn_ob := 0
    if array.size(ob_boxes) > 0
        for i = 0 to array.size(ob_boxes) - 1
            box.set_bgcolor(array.get(ob_boxes, i), color.new(color.black, 100))
            box.set_text(array.get(ob_boxes, i), "")

    if show_ob_vis and array.size(g_ob_base_id) > 0
        array<float> ob_dist = array.new<float>()
        for i = 0 to array.size(g_ob_base_id) - 1
            float mid = (array.get(g_ob_high, i) + array.get(g_ob_low, i)) / 2.0
            array.push(ob_dist, math.abs(close - mid))
            
        array<int> indices = f_get_closest_indices(ob_dist, MAX_VISUALS, max_render_dist)
        
        if array.size(indices) > 0
            while array.size(ob_boxes) < array.size(indices)
                array.push(ob_boxes, box.new(na, na, na, na, text="", text_halign=text.align_center, text_size=size.tiny, text_color=color.white))
                
            for k = 0 to array.size(indices) - 1
                int i = array.get(indices, k)
                if i < array.size(g_ob_base_id)
                    box b = array.get(ob_boxes, k)
                    string state = array.get(g_ob_state, i)
                    int dir = array.get(g_ob_dir, i)
                    int transp = state == "Active" ? 80 : 90
                    color c = dir == TD_LONG ? color.new(color.blue, transp) : color.new(color.orange, transp)
                    box.set_bgcolor(b, c)
                    box.set_lefttop(b, bar_index - 50, array.get(g_ob_high, i))
                    box.set_rightbottom(b, bar_index, array.get(g_ob_low, i))
                    string txt = array.get(g_ob_base_id, i) + "-v" + str.tostring(array.get(g_ob_ver, i)) + "\n" + (dir == TD_LONG ? "Bull OB" : "Bear OB") + "\n" + state
                    box.set_text(b, txt)
                    S.drawn_ob += 1

    S.drawn_brk := 0
    if array.size(brk_boxes) > 0
        for i = 0 to array.size(brk_boxes) - 1
            box.set_bgcolor(array.get(brk_boxes, i), color.new(color.black, 100))
            box.set_text(array.get(brk_boxes, i), "")

    if show_brk_vis and array.size(g_brk_base_id) > 0
        array<float> brk_dist = array.new<float>()
        for i = 0 to array.size(g_brk_base_id) - 1
            float mid = (array.get(g_brk_high, i) + array.get(g_brk_low, i)) / 2.0
            array.push(brk_dist, math.abs(close - mid))
            
        array<int> indices = f_get_closest_indices(brk_dist, MAX_VISUALS, max_render_dist)
        
        if array.size(indices) > 0
            while array.size(brk_boxes) < array.size(indices)
                array.push(brk_boxes, box.new(na, na, na, na, text="", text_halign=text.align_center, text_size=size.tiny, text_color=color.white))
                
            for k = 0 to array.size(indices) - 1
                int i = array.get(indices, k)
                if i < array.size(g_brk_base_id)
                    box b = array.get(brk_boxes, k)
                    string state = array.get(g_brk_state, i)
                    int dir = array.get(g_brk_dir, i)
                    int transp = state == "Active" ? 80 : 90
                    color c = dir == TD_LONG ? color.new(color.purple, transp) : color.new(color.fuchsia, transp)
                    box.set_bgcolor(b, c)
                    box.set_lefttop(b, bar_index - 50, array.get(g_brk_high, i))
                    box.set_rightbottom(b, bar_index, array.get(g_brk_low, i))
                    string txt = array.get(g_brk_base_id, i) + "-v" + str.tostring(array.get(g_brk_ver, i)) + "\n" + (dir == TD_LONG ? "Bull BRK" : "Bear BRK") + "\n" + state
                    box.set_text(b, txt)
                    S.drawn_brk += 1

    if array.size(g_mss_base_id) > 0
        while array.size(mss_labels) < array.size(g_mss_base_id)
            mss_labels.push(label.new(na, na, text="", style=label.style_label_up, textcolor=color.white, size=size.tiny))
        while array.size(mss_labels) > array.size(g_mss_base_id)
            label.delete(array.pop(mss_labels))
            
        for i = 0 to array.size(g_mss_base_id) - 1
            label lbl = array.get(mss_labels, i)
            string state = array.get(g_mss_state, i)
            int dir = array.get(g_mss_dir, i)
            float trig_px = array.get(g_mss_trigger_px, i)
            int trig_bar = array.get(g_mss_trigger_bar, i)
            if state == "Active"
                if bar_index - trig_bar < 4900
                    label.set_xy(lbl, trig_bar, trig_px)
                    string txt = array.get(g_mss_base_id, i) + "-v" + str.tostring(array.get(g_mss_ver, i)) + "\n" + (dir == TD_LONG ? "MSS↑" : "MSS↓")
                    label.set_text(lbl, txt)
                    label.set_color(lbl, dir == TD_LONG ? color.green : color.red)
                    label.set_style(lbl, dir == TD_LONG ? label.style_label_up : label.style_label_down)
                else
                    label.set_text(lbl, "")
            else
                label.set_text(lbl, "")
    else
        while array.size(mss_labels) > 0
            label.delete(array.pop(mss_labels))
    S

