f_compute_order_blocks() =>
    bool integ = f_check_p8_integ() and f_mtf_all_ok()
    if integ and barstate.islastconfirmedhistory
        if str.contains(struct_logs, "BOS (Bullish)")
            int ob_bar = -1
            float ob_h = na
            float ob_l = na
            int ob_time = -1
            for i = 1 to 20
                if close[i] < open[i]
                    ob_bar := i
                    ob_h := high[i]
                    ob_l := low[i]
                    ob_time := time[i]
                    break
            if ob_bar != -1
                string bos_id = "BOS-BULL-" + str.tostring(bar_index)
                f_ob_create(TD_LONG, ob_h, ob_l, ob_bar, bos_id, ob_time)
                
        else if str.contains(struct_logs, "BOS (Bearish)")
            int ob_bar = -1
            float ob_h = na
            float ob_l = na
            int ob_time = -1
            for i = 1 to 20
                if close[i] > open[i]
                    ob_bar := i
                    ob_h := high[i]
                    ob_l := low[i]
                    ob_time := time[i]
                    break
            if ob_bar != -1
                string bos_id = "BOS-BEAR-" + str.tostring(bar_index)
                f_ob_create(TD_SHORT, ob_h, ob_l, ob_bar, bos_id, ob_time)
                
        int sz = array.size(g_ob_base_id)
        if sz > 0
            for i = 0 to sz - 1
                string state = array.get(g_ob_state, i)
                if state != "Invalidated"
                    int dir = array.get(g_ob_dir, i)
                    float ob_h = array.get(g_ob_high, i)
                    float ob_l = array.get(g_ob_low, i)
                    
                    if (dir == TD_LONG and low < ob_h + g_current_context.atr) or (dir == TD_SHORT and high > ob_l - g_current_context.atr)
                        float cur_mit = array.get(g_ob_mit_pct, i)
                        float new_mit = cur_mit
                        string new_state = state
                        
                        if dir == TD_LONG
                            if close < ob_l
                                new_state := "Invalidated"
                            else
                                if low <= ob_l
                                    new_mit := 100.0
                                else if low < ob_h
                                    float ob_size = ob_h - ob_l
                                    new_mit := ob_size == 0 ? 0.0 : (ob_h - low) / ob_size * 100.0
                                if new_mit > 0
                                    new_state := new_mit == 100.0 ? "Fully Mitigated" : "Mitigated"
                        else if dir == TD_SHORT
                            if close > ob_h
                                new_state := "Invalidated"
                            else
                                if high >= ob_h
                                    new_mit := 100.0
                                else if high > ob_l
                                    float ob_size = ob_h - ob_l
                                    new_mit := ob_size == 0 ? 0.0 : (high - ob_l) / ob_size * 100.0
                                if new_mit > 0
                                    new_state := new_mit == 100.0 ? "Fully Mitigated" : "Mitigated"
                                    
                        if new_mit != cur_mit or new_state != state
                            f_ob_emit(i, new_state, new_mit)

f_compute_order_blocks()


