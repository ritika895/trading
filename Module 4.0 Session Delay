int RS_ACTIVE      = 1
int RS_INVALIDATED = 2
int RS_FULFILLED   = 3
int RS_EXPIRED     = 4

// Defines replacement engine decisions
int RD_KEEP    = 0
int RD_REPLACE = 1
int RD_MERGE   = 2
int RD_IGNORE  = 3

// Defines registry actions
int RA_NONE        = 0
int RA_CREATED_NEW = 1
int RA_UPDATED     = 2
int RA_MERGED      = 3
int RA_REPLACED    = 4
int RA_IGNORED     = 5

// -------------------------------------------------------------------------
// 1.3 CORE TYPE DEFINITIONS
// -------------------------------------------------------------------------

// Represents a structural swing point on the chart
type SwingPoint
    float price
    int   barIndex
    int   timeMs   // Renamed from 'time' to avoid Pine v6 built-in keyword conflict
    bool  isHigh

// Represents a liquidity pool in the Registry
type LiquidityPool
    int               id
    int               poolType         
    int               state            
    float             priceLevel
    int               touchCount
    float             confidence
    bool              isSwept
    int               createdAtBar
    int               sweptAtBar
    int               invalidatedAtBar
    string            sweepReasonCode 
    array<SwingPoint> mitigations      

// Represents an immutable snapshot of market context at evaluation time
type ContextSnapshot
    int   barIndex
    int   timeMs           
    float currentPrice
    float atr
    int   currentSession 
    int   marketBias     
    float premiumZone
    float discountZone

// Represents a candidate trade idea from a Strategy
type StrategyCandidate
    int             id
    LiquidityPool   sourcePool
    ContextSnapshot context
    int             direction       
    float           entryPrice
    float           stopLoss
    float           takeProfit
    string          strategyName

// Represents the final output of the pipeline
type Recommendation
    int               id
    StrategyCandidate candidate
    int               status          
    int               createdBarIndex
    float             actualEntry
    float             actualStop


