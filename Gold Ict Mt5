f_state_to_string(int state_val) =>
    string res = "UNKNOWN"
    if state_val == LS_ACTIVE
        res := "ACTIVE"
    else if state_val == LS_SWEPT
        res := "SWEPT"
    else if state_val == LS_INVALIDATED
        res := "INVALIDATED"
    else if state_val == LS_EXPIRED
        res := "EXPIRED"
    res

f_score_pool(LiquidityPool pool) =>
    float score = pool.confidence
    if pool.state == 2
        score += 0.5
        score += pool.touchCount * 0.1
    score

