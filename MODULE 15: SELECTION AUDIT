// 15.1 Audit Data Type Definition
type SelectionAuditData
    int totalBull
    int totalBear
    int eligibleBull
    int eligibleBear
    string stateFilterBull
    string stateFilterBear
    int selectedBullId
    int selectedBearId
    int selectedOverallId
    string finalRejectionReason

// 15.2 Helper: Convert State Integer to String for Audit Readout
// Rewritten with if/else if to prevent Pine v6 line continuation syntax errors.
f_state_to_string(int state) =>
    string res = "UNKNOWN"
    if state == LS_FORMED
        res := "FORMED"
    else if state == LS_ACTIVE
        res := "ACTIVE"
    else if state == LS_REINFORCED
        res := "REINFORCED"
    else if state == LS_SWEPT
        res := "SWEPT"
    else if state == LS_INVALIDATED
        res := "INVALIDATED"
    else if state == LS_EXPIRED
        res := "EXPIRED"
    res

// 15.3 Selection Audit Logic
// Pure Function: Observes the Registry and Selection Result to compile audit data.
f_run_selection_audit(SelectionResult sel) =>
    int tBull = 0
    int tBear = 0
    int eBull = 0
    int eBear = 0
    string filterBull = "PASS"
    string filterBear = "PASS"
    int selBullId = na(sel.bestBullPool) ? -1 : sel.bestBullPool.id
    int selBearId = na(sel.bestBearPool) ? -1 : sel.bestBearPool.id
    int selOverallId = na(sel.bestOverallPool) ? -1 : sel.bestOverallPool.id
    string finalReason = "Selected (No conflicts)"

    if array.size(g_registry) > 0
        for i = 0 to array.size(g_registry) - 1
            LiquidityPool p = array.get(g_registry, i)
            if p.poolType == LT_BUY_SIDE
                tBull += 1
                if p.state == LS_ACTIVE or p.state == LS_REINFORCED
                    eBull += 1
                else
                    filterBull := "FAIL: State is " + f_state_to_string(p.state)
            else if p.poolType == LT_SELL_SIDE
                tBear += 1
                if p.state == LS_ACTIVE or p.state == LS_REINFORCED
                    eBear += 1
                else
                    filterBear := "FAIL: State is " + f_state_to_string(p.state)

    if selOverallId == -1
        if eBull == 0 and eBear == 0
            finalReason := "No eligible pools (All rejected by State filter)"
        else if eBull == 0
            finalReason := "No eligible Bull pools"
        else if eBear == 0
            finalReason := "No eligible Bear pools"
        else
            finalReason := "Unknown selection failure"

    SelectionAuditData.new(tBull, tBear, eBull, eBear, filterBull, filterBear, selBullId, selBearId, selOverallId, finalReason)

// 15.4 Execution
var SelectionAuditData g_current_audit = na
g_current_audit := f_run_selection_audit(g_current_selection)

if g_current_audit.selectedOverallId == -1
    array.push(g_event_log, str.format("{0} - AUDIT: {1}", bar_index, g_current_audit.finalRejectionReason))

// 15.5 Audit Table Instance
var table audit_table = table.new(position.bottom_right, 2, 10, bgcolor=color.new(color.black, 10), border_width=1, border_color=color.new(color.gray, 60))

// 15.6 Audit Table Initialization
f_init_audit_table() =>
    if barstate.isfirst
        table.cell(audit_table, 0, 0, "SELECTION AUDIT", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.navy, 60))
        table.merge_cells(audit_table, 0, 0, 1, 0)
        table.cell(audit_table, 0, 1, "Total Bull / Bear", text_color=color.gray, text_size=size.tiny)
        table.cell(audit_table, 0, 2, "Eligible Bull / Bear", text_color=color.gray, text_size=size.tiny)
        table.cell(audit_table, 0, 3, "State Filter (Bull)", text_color=color.gray, text_size=size.tiny)
        table.cell(audit_table, 0, 4, "State Filter (Bear)", text_color=color.gray, text_size=size.tiny)
        table.cell(audit_table, 0, 5, "Selected Bull ID", text_color=color.gray, text_size=size.tiny)
        table.cell(audit_table, 0, 6, "Selected Bear ID", text_color=color.gray, text_size=size.tiny)
        table.cell(audit_table, 0, 7, "Selected Overall ID", text_color=color.gray, text_size=size.tiny)
        table.cell(audit_table, 0, 8, "Final Reason", text_color=color.gray, text_size=size.tiny)

// 15.7 Execution
f_init_audit_table()

// 15.8 Audit Dashboard Integration
if barstate.islast
    table.cell(audit_table, 1, 1, str.tostring(g_current_audit.totalBull) + " / " + str.tostring(g_current_audit.totalBear), text_color=color.white, text_size=size.tiny)
    table.cell(audit_table, 1, 2, str.tostring(g_current_audit.eligibleBull) + " / " + str.tostring(g_current_audit.eligibleBear), text_color=g_current_audit.eligibleBull > 0 or g_current_audit.eligibleBear > 0 ? color.green : color.red, text_size=size.tiny)
    
    table.cell(audit_table, 1, 3, g_current_audit.stateFilterBull, text_color=str.contains(g_current_audit.stateFilterBull, "FAIL") ? color.red : color.green, text_size=size.tiny)
    table.cell(audit_table, 1, 4, g_current_audit.stateFilterBear, text_color=str.contains(g_current_audit.stateFilterBear, "FAIL") ? color.red : color.green, text_size=size.tiny)
    
    table.cell(audit_table, 1, 5, g_current_audit.selectedBullId == -1 ? "N/A" : str.tostring(g_current_audit.selectedBullId), text_color=color.white, text_size=size.tiny)
    table.cell(audit_table, 1, 6, g_current_audit.selectedBearId == -1 ? "N/A" : str.tostring(g_current_audit.selectedBearId), text_color=color.white, text_size=size.tiny)
    table.cell(audit_table, 1, 7, g_current_audit.selectedOverallId == -1 ? "N/A" : str.tostring(g_current_audit.selectedOverallId), text_color=g_current_audit.selectedOverallId == -1 ? color.red : color.green, text_size=size.tiny)
    table.cell(audit_table, 1, 8, g_current_audit.finalRejectionReason, text_color=color.yellow, text_size=size.tiny)

