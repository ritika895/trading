// MODULE 9 — TRADE CANDIDATE QUALIFICATION & LIFECYCLE ENGINE
// ============================================================================ 

string M9_QUALIFIED   = "QUALIFIED"
string M9_CONFIRMED   = "CONFIRMED"
string M9_READY       = "READY"
string M9_TRIGGERED   = "TRIGGERED"
string M9_INVALIDATED = "INVALIDATED"
string M9_EXPIRED     = "EXPIRED"

int    M9_CANDIDATE_EXPIRY_BARS = 150
float  M9_READY_ATR_MULT        = 3.0
int    MAX_M9_REGISTRY          = 100

type TradeCandidate
    string  baseId
    int     direction
    float   entryZoneHigh
    float   entryZoneLow
    int     createdAt
    string  status
    float   qualificationScore
    bool    structureConfirmed
    string  invalidationReason

type M9RuntimeState
    int total_emitted
    int prev_trend

var array<TradeCandidate> g_m9_registry = array.new<TradeCandidate>()
var array<string> g_m9_dedup_keys = array.new<string>()
var map<string, bool> g_m9_dedup_map = map.new<string, bool>()
var M9RuntimeState g_m9_rt = M9RuntimeState.new(0, TD_NEUTRAL)

f_m9_record_audit(EngineState st, string corr_id, string object_id, string status, string message, string recommendation) =>
    int audit_id = st.audit.next_audit_id
    st.audit.next_audit_id += 1
    st.audit.audit_total_emitted += 1

    if status == AUDIT_PASS
        st.audit.lifetime_audit_passed += 1
        st.audit.m12_cycle_passed += 1
    else if status == AUDIT_WARNING
        st.audit.lifetime_audit_warnings += 1
        st.audit.m12_cycle_warnings += 1
    else if status == AUDIT_FAIL
        st.audit.lifetime_audit_failures += 1
        st.audit.m12_cycle_failures += 1
        st.audit.audit_last_failure_msg := message
    else if status == AUDIT_SKIPPED
        st.audit.m12_cycle_skipped += 1
    st.audit.m12_last_summary := message

    AuditResultInstance audit_result = AuditResultInstance.new(audit_id, AUDIT_REGISTRY, status == AUDIT_FAIL ? SEV_ERROR : status == AUDIT_WARNING ? SEV_WARNING : SEV_INFO, status, object_id, "Module 9", corr_id, message, recommendation, status != AUDIT_FAIL, AUDIT_SCHEMA_VERSION, time, bar_index)
    AuditResultInstance _shifted = f_push_audit(g_audit_registry, audit_result, MAX_AUDIT_REGISTRY)
    _shifted

f_m9_dedup_exists(string dedupKey) =>
    map.contains(g_m9_dedup_map, dedupKey)

f_m9_push_candidate(EngineState st, TradeCandidate cand, string dedupKey) =>
    array.push(g_m9_registry, cand)
    array.push(g_m9_dedup_keys, dedupKey)
    map.put(g_m9_dedup_map, dedupKey, true)
    if array.size(g_m9_registry) > MAX_M9_REGISTRY
        TradeCandidate evicted = array.shift(g_m9_registry)
        _ = array.shift(g_m9_dedup_keys)
        map.remove(g_m9_dedup_map, evicted.baseId)
        if evicted.status == M9_QUALIFIED or evicted.status == M9_CONFIRMED or evicted.status == M9_READY
            string ev_corr = "M9-EVICT-" + str.tostring(bar_index)
            _ = f_emit_engine_event(st, 0, ev_corr, MOD_TR, EVENT_WARNING, SEV_WARNING, "EVICTED_OVERFLOW", evicted.baseId, "TradeCandidate evicted on registry overflow (last status: " + evicted.status + ")", "{}", false)
            _ = f_m9_record_audit(st, ev_corr, evicted.baseId, AUDIT_WARNING, "TradeCandidate evicted on overflow, last known status: " + evicted.status, "No action required — registry at capacity")
    true

f_m9_stage1_qualification(EngineState st, M9RuntimeState rt) =>
    if barstate.isconfirmed
        if array.size(g_poi_registry) > 0
            for i = 0 to array.size(g_poi_registry) - 1
                INSTR.cur_m9s1LoopIter += 1
                POIInstance poi = array.get(g_poi_registry, i)
                if poi.createdAt == bar_index and poi.status == POI_ACTIVE
                    string dedupKey = poi.baseId
                    INSTR.cur_m9s1DedupScan += 1
                    bool is_dup = f_m9_dedup_exists(dedupKey)
                    string q_corr = "M9-Q-" + str.tostring(bar_index)

                    if is_dup
                        _ = f_m9_record_audit(st, q_corr, poi.baseId, AUDIT_SKIPPED, "Duplicate candidate source rejected: " + dedupKey, "No action required")
                    else
                        bool poi_valid = poi.status == POI_ACTIVE and poi.integrity == true
                        bool direction_ok = st.structure.current_trend != poi.direction

                        if poi_valid and direction_ok
                            bool htf_conflict = poi.direction != st.mtf.bias_1 and st.mtf.bias_1 != TD_NEUTRAL
                            bool pd_conflict  = (poi.direction == TD_LONG and st.counters.pd_zone == "Premium") or (poi.direction == TD_SHORT and st.counters.pd_zone == "Discount")
                            bool off_session  = f_m8_get_session(st) == ST_OFF_SESSION

                            float score = 100.0
                            if htf_conflict
                                score += P_HTF_CONF
                                _ = f_m9_record_audit(st, q_corr, poi.baseId, AUDIT_WARNING, "HTF conflict penalty applied to " + poi.baseId, "No action required")
                            if pd_conflict
                                score += P_PD_CONF
                                _ = f_m9_record_audit(st, q_corr, poi.baseId, AUDIT_WARNING, "PD-array conflict penalty applied to " + poi.baseId, "No action required")
                            if off_session
                                score += P_SESS
                                _ = f_m9_record_audit(st, q_corr, poi.baseId, AUDIT_WARNING, "Off-session penalty applied to " + poi.baseId, "No action required")
                            score := math.max(0.0, math.min(100.0, score))

                            TradeCandidate new_cand = TradeCandidate.new(poi.baseId, poi.direction, poi.poiHigh, poi.poiLow, bar_index, M9_QUALIFIED, score, false, "")
                            _ = f_m9_push_candidate(st, new_cand, dedupKey)
                            rt.total_emitted += 1

                            _ = f_emit_engine_event(st, 0, q_corr, MOD_TR, EVENT_CREATE, SEV_INFO, "SUCCESS", poi.baseId, "TradeCandidate Qualified from " + poi.baseId, "{}", true)
                            _ = f_m9_record_audit(st, q_corr, poi.baseId, AUDIT_PASS, "TradeCandidate Qualified: " + poi.baseId + " score=" + str.tostring(score, "#.#"), "No action required")
                        else
                            string fail_reason = not poi_valid ? "POI_INVALID" : "DIRECTION_FILTER_REJECTED"
                            _ = f_m9_record_audit(st, q_corr, poi.baseId, AUDIT_WARNING, "Candidate rejected: " + fail_reason, "No action required")
    bool _done = true
    _done

f_m9_evaluate_lifecycle(EngineState st, M9RuntimeState rt) =>
    if barstate.isconfirmed and array.size(g_m9_registry) > 0
        map<string, int> poiIdx = map.new<string, int>()
        if array.size(g_poi_registry) > 0
            for j = 0 to array.size(g_poi_registry) - 1
                INSTR.cur_m9lcPoiIdxScan += 1
                map.put(poiIdx, array.get(g_poi_registry, j).baseId, j)

        for i = 0 to array.size(g_m9_registry) - 1
            INSTR.cur_m9lcLoopIter += 1
            TradeCandidate cand = array.get(g_m9_registry, i)
            bool transitioned = false
            bool is_non_terminal = cand.status == M9_QUALIFIED or cand.status == M9_CONFIRMED or cand.status == M9_READY

            if not transitioned and (cand.status == M9_CONFIRMED or cand.status == M9_READY)
                bool triggered = low <= cand.entryZoneHigh and high >= cand.entryZoneLow
                if triggered
                    cand.status := M9_TRIGGERED
                    transitioned := true
                    string t_corr = "M9-TRIG-" + str.tostring(bar_index)
                    _ = f_emit_engine_event(st, 0, t_corr, MOD_TR, EVENT_CREATE, SEV_INFO, "SUCCESS", cand.baseId, "TradeCandidate Triggered: " + cand.baseId, "{}", true)
                    _ = f_m9_record_audit(st, t_corr, cand.baseId, AUDIT_PASS, "TradeCandidate transitioned -> TRIGGERED", "No action required")

            if not transitioned and cand.status == M9_CONFIRMED
                float nearestEdge = cand.direction == TD_LONG ? cand.entryZoneHigh : cand.entryZoneLow
                float distance = cand.direction == TD_LONG ? (close - nearestEdge) : (nearestEdge - close)
                bool ready = distance >= 0 and distance <= (st.current_context.atr * M9_READY_ATR_MULT)
                if ready
                    cand.status := M9_READY
                    transitioned := true
                    string r_corr = "M9-READY-" + str.tostring(bar_index)
                    _ = f_emit_engine_event(st, 0, r_corr, MOD_TR, EVENT_EMIT, SEV_INFO, "READY", cand.baseId, "TradeCandidate Ready: " + cand.baseId, "{}", true)
                    _ = f_m9_record_audit(st, r_corr, cand.baseId, AUDIT_PASS, "TradeCandidate transitioned CONFIRMED -> READY", "No action required")

            if not transitioned and cand.status == M9_QUALIFIED
                bool confirm = st.structure.current_trend != rt.prev_trend and st.structure.current_trend == cand.direction and bar_index != cand.createdAt
                if confirm
                    cand.status := M9_CONFIRMED
                    cand.structureConfirmed := true
                    transitioned := true
                    string c_corr = "M9-CONF-" + str.tostring(bar_index)
                    _ = f_emit_engine_event(st, 0, c_corr, MOD_TR, EVENT_EMIT, SEV_INFO, "CONFIRMED", cand.baseId, "TradeCandidate Confirmed: " + cand.baseId, "{}", true)
                    _ = f_m9_record_audit(st, c_corr, cand.baseId, AUDIT_PASS, "TradeCandidate transitioned QUALIFIED -> CONFIRMED", "No action required")

            if not transitioned and is_non_terminal
                if bar_index - cand.createdAt > M9_CANDIDATE_EXPIRY_BARS
                    cand.status := M9_EXPIRED
                    cand.invalidationReason := "EXPIRED_NO_TRIGGER"
                    transitioned := true
                    string e_corr = "M9-EXP-" + str.tostring(bar_index)
                    _ = f_emit_engine_event(st, 0, e_corr, MOD_TR, EVENT_INVALID, SEV_WARNING, "EXPIRED", cand.baseId, "TradeCandidate Expired: " + cand.baseId, "{}", true)
                    _ = f_m9_record_audit(st, e_corr, cand.baseId, AUDIT_PASS, "TradeCandidate transitioned -> EXPIRED (EXPIRED_NO_TRIGGER)", "No action required")

            if not transitioned and is_non_terminal
                bool source_found = map.contains(poiIdx, cand.baseId)
                string source_status = source_found ? array.get(g_poi_registry, map.get(poiIdx, cand.baseId)).status : ""
                string inv_reason = ""
                if not source_found
                    inv_reason := "SOURCE_LOST"
                else if source_status == POI_MITIGATED or source_status == POI_INVALIDATED or source_status == POI_ARCHIVED
                    inv_reason := "SOURCE_POI_RESOLVED"

                if inv_reason != ""
                    cand.status := M9_INVALIDATED
                    cand.invalidationReason := inv_reason
                    transitioned := true
                    string inv_corr = "M9-INV-" + str.tostring(bar_index)
                    _ = f_emit_engine_event(st, 0, inv_corr, MOD_TR, EVENT_INVALID, SEV_WARNING, "INVALIDATED", cand.baseId, "TradeCandidate Invalidated: " + cand.baseId + " (" + inv_reason + ")", "{}", true)
                    _ = f_m9_record_audit(st, inv_corr, cand.baseId, AUDIT_WARNING, "TradeCandidate transitioned -> INVALIDATED (" + inv_reason + ")", "No action required")

            array.set(g_m9_registry, i, cand)
    bool _done = true
    _done

f_m9_coordinator(EngineState st) =>
    _ = f_m9_stage1_qualification(st, g_m9_rt)
    _ = f_m9_evaluate_lifecycle(st, g_m9_rt)
    if barstate.isconfirmed
        g_m9_rt.prev_trend := st.structure.current_trend
    bool _done = true
    _done

