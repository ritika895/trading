// @function Records an audit for Module 7 actions
f_m7_record_audit(EngineState st, string corr_id, string object_id, string message) =>
    int audit_id = st.audit.next_audit_id
    st.audit.next_audit_id += 1
    st.audit.audit_total_emitted += 1
    st.audit.lifetime_audit_passed += 1
    st.audit.m12_cycle_passed += 1
    st.audit.m12_last_summary := message

    AuditResultInstance audit_result = AuditResultInstance.new(
         audit_id,
         AUDIT_REGISTRY,
         SEV_INFO,
         AUDIT_PASS,
         object_id,
         "Module 7",
         corr_id,
         message,
         "No action required",
         true,
         AUDIT_SCHEMA_VERSION,
         time,
         bar_index)

    f_push_audit(g_audit_registry, audit_result, MAX_AUDIT_REGISTRY)

// @function Fetches HTF snapshot using request.security
f_get_htf_snapshot(string tf) =>
    float htf_close = request.security(syminfo.tickerid, tf, close, barmerge.gaps_off, barmerge.lookahead_off)
    float htf_high = request.security(syminfo.tickerid, tf, high, barmerge.gaps_off, barmerge.lookahead_off)
    float htf_low = request.security(syminfo.tickerid, tf, low, barmerge.gaps_off, barmerge.lookahead_off)
    float htf_sma = request.security(syminfo.tickerid, tf, ta.sma(close, 50), barmerge.gaps_off, barmerge.lookahead_off)
    
    int htf_bias = TD_NEUTRAL
    if not na(htf_close) and not na(htf_sma)
        htf_bias := htf_close > htf_sma ? TD_LONG : htf_close < htf_sma ? TD_SHORT : TD_NEUTRAL
        
    [htf_bias, htf_high, htf_low, htf_close]

// @function Updates Premium, Discount, and Equilibrium levels
f_m7_update_pd(EngineState S) =>
    float swingHigh = S.structure.last_swing_high_price
    float swingLow  = S.structure.last_swing_low_price
    AuditResultInstance _pd_audit_result = na
    
    if not na(swingHigh) and not na(swingLow) and swingHigh > swingLow
        float rng = swingHigh - swingLow
        
        // Update zone string every bar
        if not na(S.current_context.currentPrice)
            if S.current_context.currentPrice >= swingHigh - (rng * 0.2)
                S.counters.pd_zone := "Premium"
            else if S.current_context.currentPrice <= swingLow + (rng * 0.2)
                S.counters.pd_zone := "Discount"
            else
                S.counters.pd_zone := "Equilibrium"
        else
            S.counters.pd_zone := "N/A"
            
        // Only emit event if swing range actually changed
        if S.current_context.premiumZone != swingHigh or S.current_context.discountZone != swingLow
            S.current_context.premiumZone   := swingHigh
            S.current_context.discountZone  := swingLow
            
            S.counters.pd_ver += 1
            S.counters.pd_high := swingHigh
            S.counters.pd_low := swingLow
            S.counters.pd_integ := true
            
            string corr_id = "M7-PD-" + str.tostring(bar_index)
            _ = f_emit_engine_event(S, 0, corr_id, MOD_PD, EVENT_CREATE, SEV_INFO, "SUCCESS", "PD-UPDATE", "PD Zones Updated", "{}", true)
            _pd_audit_result := f_m7_record_audit(S, corr_id, "PD-UPDATE", "PD Zones Updated")
        _pd_audit_result
    else
        S.counters.pd_integ := false
        S.counters.pd_zone := "N/A"
        log.info("M7 PD Engine -> Invalid swings detected. PD marked invalid.")
        _pd_audit_result

// @function Updates Multi-Timeframe state
f_m7_update_mtf(EngineState S) =>
    [bias1, hi1, lo1, c1] = f_get_htf_snapshot(P9_HTF_1)
    [bias2, hi2, lo2, c2] = f_get_htf_snapshot(P9_HTF_2)
    [bias3, hi3, lo3, c3] = f_get_htf_snapshot(P9_HTF_3)
    
    S.mtf.bias_1 := bias1
    S.mtf.bias_2 := bias2
    S.mtf.bias_3 := bias3
    S.mtf.hi_1 := hi1
    S.mtf.lo_1 := lo1
    S.mtf.hi_2 := hi2
    S.mtf.lo_2 := lo2
    S.mtf.hi_3 := hi3
    S.mtf.lo_3 := lo3
    S.mtf.t_1 := time
    S.mtf.t_2 := time
    S.mtf.t_3 := time
    S.mtf.integ_1 := true
    S.mtf.integ_2 := true
    S.mtf.integ_3 := true
    
    string corr_id = "M7-MTF-" + str.tostring(bar_index)
    _ = f_emit_engine_event(S, 0, corr_id, MOD_MTF, EVENT_CREATE, SEV_INFO, "SUCCESS", "MTF-UPDATE", "MTF Data Fetched", "{}", true)
    f_m7_record_audit(S, corr_id, "MTF-UPDATE", "MTF Data Fetched")

// @function Detects and manages Fair Value Gaps
f_m7_update_fvgs(EngineState S) =>
    bool bull_fvg = low > high[2] and not na(high[2]) and close[1] > open[1]
    bool bear_fvg = high < low[2] and not na(low[2]) and close[1] < open[1]
    
    string pd_zone = S.counters.pd_zone
    int mtf_bias = S.mtf.bias_1
    
    if bull_fvg
        int new_id = S.counters.next_fvg_id
        S.counters.next_fvg_id += 1
        S.counters.fvg_total_emitted += 1
        
        float top = low
        float bot = high[2]
        
        string base_id = "FVG_" + str.tostring(bar_index) + "_BULL"
        string inst_id = base_id + "_v1"
        
        FVGInstance new_fvg = FVGInstance.new(
            base_id, inst_id, "", "FVG", "M7", bar_index, "ACTIVE", true, "1.0",
            TD_LONG, top, bot, 0.0, mtf_bias, pd_zone, "N/A", time
        )
        
        f_push_fvg(g_fvg_registry, new_fvg, MAX_FVG_REGISTRY)
        f_push_string(g_fvg_base_id, base_id, MAX_FVG_REGISTRY)
        f_push_int(g_fvg_ver, 1, MAX_FVG_REGISTRY)
        f_push_float(g_fvg_top, top, MAX_FVG_REGISTRY)
        f_push_float(g_fvg_bot, bot, MAX_FVG_REGISTRY)
        f_push_int(g_fvg_dir, TD_LONG, MAX_FVG_REGISTRY)
        f_push_string(g_fvg_state, "ACTIVE", MAX_FVG_REGISTRY)
        f_push_float(g_fvg_mit_pct, 0.0, MAX_FVG_REGISTRY)
        
        string obj_id = f_format_id("M7-FVG", new_id, 1)
        string corr_id = "M7-FVG-" + str.tostring(bar_index)
        _ = f_emit_engine_event(S, 0, corr_id, MOD_FVG, EVENT_CREATE, SEV_INFO, "SUCCESS", obj_id, "Bullish FVG Created", "{}", true)
        f_m7_record_audit(S, corr_id, obj_id, "Bullish FVG Created")
        
    if bear_fvg
        int new_id = S.counters.next_fvg_id
        S.counters.next_fvg_id += 1
        S.counters.fvg_total_emitted += 1
        
        float top = low[2]
        float bot = high
        
        string base_id = "FVG_" + str.tostring(bar_index) + "_BEAR"
        string inst_id = base_id + "_v1"
        
        FVGInstance new_fvg = FVGInstance.new(
            base_id, inst_id, "", "FVG", "M7", bar_index, "ACTIVE", true, "1.0",
            TD_SHORT, top, bot, 0.0, mtf_bias, pd_zone, "N/A", time
        )
        
        f_push_fvg(g_fvg_registry, new_fvg, MAX_FVG_REGISTRY)
        f_push_string(g_fvg_base_id, base_id, MAX_FVG_REGISTRY)
        f_push_int(g_fvg_ver, 1, MAX_FVG_REGISTRY)
        f_push_float(g_fvg_top, top, MAX_FVG_REGISTRY)
        f_push_float(g_fvg_bot, bot, MAX_FVG_REGISTRY)
        f_push_int(g_fvg_dir, TD_SHORT, MAX_FVG_REGISTRY)
        f_push_string(g_fvg_state, "ACTIVE", MAX_FVG_REGISTRY)
        f_push_float(g_fvg_mit_pct, 0.0, MAX_FVG_REGISTRY)
        
        string obj_id = f_format_id("M7-FVG", new_id, 1)
        string corr_id = "M7-FVG-" + str.tostring(bar_index)
        _ = f_emit_engine_event(S, 0, corr_id, MOD_FVG, EVENT_CREATE, SEV_INFO, "SUCCESS", obj_id, "Bearish FVG Created", "{}", true)
        f_m7_record_audit(S, corr_id, obj_id, "Bearish FVG Created")

    // Lifecycle Management
    if array.size(g_fvg_registry) > 0
        for i = array.size(g_fvg_registry) - 1 to 0
            FVGInstance fvg = array.get(g_fvg_registry, i)
            if fvg.status == "ACTIVE"
                bool mitigated = false
                if fvg.direction == TD_LONG
                    if low <= fvg.gapTop and close > fvg.gapBottom
                        fvg.mitigationPercent := 100.0
                        fvg.status := "MITIGATED"
                        mitigated := true
                else if fvg.direction == TD_SHORT
                    if high >= fvg.gapBottom and close < fvg.gapTop
                        fvg.mitigationPercent := 100.0
                        fvg.status := "MITIGATED"
                        mitigated := true
                        
                if mitigated
                    array.set(g_fvg_registry, i, fvg)
                    array.set(g_fvg_state, i, "Full") 
                    array.set(g_fvg_mit_pct, i, 100.0)
                    
                    string obj_id = f_format_id("M7-FVG", i, array.get(g_fvg_ver, i))
                    string corr_id = "M7-FVG-MIT-" + str.tostring(bar_index)
                    _ = f_emit_engine_event(S, 0, corr_id, MOD_FVG, EVENT_INVALID, SEV_INFO, "MITIGATED", obj_id, "FVG Mitigated", "{}", true)
                    f_m7_record_audit(S, corr_id, obj_id, "FVG Mitigated")

// @function Detects and manages Order Blocks
f_m7_update_obs(EngineState S) =>
    bool bull_ob = close[1] > open[1] and close[2] < open[2] and close > high[1]
