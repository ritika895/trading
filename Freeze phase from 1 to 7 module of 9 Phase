// =========================================================================
// PHASE 8 COMPUTATION FUNCTION
// =========================================================================
f_is_in_range(int cur_mins, int start_mins, int end_mins) =>
    if start_mins <= end_mins
        cur_mins >= start_mins and cur_mins < end_mins
    else
        cur_mins >= start_mins or cur_mins < end_mins

f_compute_phase8(EngineState S) =>
    int cur_hour = hour(time, syminfo.timezone)
    int cur_min  = minute(time, syminfo.timezone)
    int cur_mins = cur_hour * 60 + cur_min
    int cur_day  = dayofweek(time, syminfo.timezone)

    bool is_weekend = false
    if cur_day == 1
        if cur_mins < (17 * 60)
            is_weekend := true
    else if cur_day == 6
        if cur_mins >= (17 * 60)
            is_weekend := true

    int g_current_session = ST_OFF_SESSION
    S.market_status := "CLOSED"

    if not is_weekend
        bool is_ny = f_is_in_range(cur_mins, ny_start, ny_end)
        bool is_london = f_is_in_range(cur_mins, london_start, london_end)
        bool is_asian = f_is_in_range(cur_mins, asian_start, asian_end)
        S.market_status := "OPEN"
        if is_ny
            g_current_session := ST_NEW_YORK
        else if is_london
            g_current_session := ST_LONDON
        else if is_asian
            g_current_session := ST_ASIAN
        else
            g_current_session := ST_OFF_SESSION
            S.market_status := "CLOSED"

    string h_str = cur_hour < 10 ? "0" + str.tostring(cur_hour) : str.tostring(cur_hour)
    string m_str = cur_min < 10 ? "0" + str.tostring(cur_min) : str.tostring(cur_min)
    S.current_time_str := h_str + ":" + m_str

    float ph = ta.pivothigh(high, SWING_LOOKBACK, SWING_LOOKBACK)
    float pl = ta.pivotlow(low, SWING_LOOKBACK, SWING_LOOKBACK)

    S.struct_logs := ""

    if barstate.isconfirmed
        if not na(S.last_swing_high_price) and close > S.last_swing_high_price
            if S.current_trend == TD_SHORT
                S.last_choch_dir := TD_LONG 
                S.current_trend := TD_LONG
                S.struct_logs += "CHoCH (Bullish) detected. "
            else
                S.last_bos_dir := TD_LONG 
                S.current_trend := TD_LONG
                S.struct_logs += "BOS (Bullish) detected. "
                
        if not na(S.last_swing_low_price) and close < S.last_swing_low_price
            if S.current_trend == TD_LONG
                S.last_choch_dir := TD_SHORT 
                S.current_trend := TD_SHORT
                S.struct_logs += "CHoCH (Bearish) detected. "
            else
                S.last_bos_dir := TD_SHORT 
                S.current_trend := TD_SHORT
                S.struct_logs += "BOS (Bearish) detected. "

        if not na(ph)
            if array.size(g_registry) < MAX_POOLS
                int newId = S.next_pool_id
                S.next_pool_id += 1
                LiquidityPool newPool = LiquidityPool.new(newId, LT_BUY_SIDE, LS_ACTIVE, ph, 0, 1.0, false, bar_index, 0, 0, "INIT", array.new<SwingPoint>())
                array.push(g_registry, newPool)
                array.push(g_event_log, str.tostring(time, "HH:mm") + " Pool Created: ID-" + str.tostring(newId))
            S.last_swing_high_price := ph
            S.last_swing_high_bar := bar_index - SWING_LOOKBACK
            S.struct_logs += "Confirmed Swing High: " + str.tostring(ph) + ". "
            
        if not na(pl)
            if array.size(g_registry) < MAX_POOLS
                int newId = S.next_pool_id
                S.next_pool_id += 1
                LiquidityPool newPool = LiquidityPool.new(newId, LT_SELL_SIDE, LS_ACTIVE, pl, 0, 1.0, false, bar_index, 0, 0, "INIT", array.new<SwingPoint>())
                array.push(g_registry, newPool)
                array.push(g_event_log, str.tostring(time, "HH:mm") + " Pool Created: ID-" + str.tostring(newId))
            S.last_swing_low_price := pl
            S.last_swing_low_bar := bar_index - SWING_LOOKBACK
            S.struct_logs += "Confirmed Swing Low: " + str.tostring(pl) + ". "

        if S.struct_logs != ""
            array.push(g_event_log, str.tostring(time, "HH:mm") + " STRUCT: " + S.struct_logs)

    float atr_val = ta.atr(ATR_LENGTH)
    float high50 = ta.highest(high, 50)
    float low50 = ta.lowest(low, 50)
    float priceRange = high50 - low50

    float eq = low50 + (priceRange * 0.5)
    float premium = low50 + (priceRange * 0.7)
    float discount = low50 + (priceRange * 0.3)

    S.current_context := ContextSnapshot.new(bar_index, time, close, atr_val, g_current_session, S.current_trend, premium, discount)

    int POOL_EXPIRY_BARS = 200

    int _bull_count = 0
    int _bear_count = 0
    int _active_count = 0
    int _swept_count = 0
    int _rein_count = 0
    int _invalid_count = 0
    int _expired_count = 0

    int _tBull = 0
    int _tBear = 0
    int _eBull = 0
    int _eBear = 0

    while array.size(g_pool_trackers) < array.size(g_registry)
        int new_idx = array.size(g_pool_trackers)
        LiquidityPool p_new = array.get(g_registry, new_idx)
        PoolTracker newT = PoolTracker.new(p_new.id, p_new.state, bar_index, 0, 0)
        array.push(g_pool_trackers, newT)

    if array.size(g_registry) > 0 and array.size(g_pool_trackers) == array.size(g_registry)
        for i = 0 to array.size(g_registry) - 1
            LiquidityPool p = array.get(g_registry, i)
            if p.state == LS_ACTIVE or p.state == LS_REINFORCED
                if bar_index - p.createdAtBar > POOL_EXPIRY_BARS
                    int prevState = p.state
                    p.state := LS_EXPIRED
                    array.push(_lc_logs, str.tostring(time, "HH:mm") + " Pool " + str.tostring(p.id) + " " + f_state_to_string(prevState) + "->" + f_state_to_string(LS_EXPIRED))
                        
            if p.state == LS_ACTIVE or p.state == LS_REINFORCED
                if p.poolType == LT_BUY_SIDE
                    if close < p.priceLevel
                        int prevState = p.state
                        p.state := LS_SWEPT
                        p.isSwept := true
                        p.sweptAtBar := bar_index
                        array.push(_lc_logs, str.tostring(time, "HH:mm") + " Pool " + str.tostring(p.id) + " " + f_state_to_string(prevState) + "->" + f_state_to_string(LS_SWEPT))
                    else if low <= p.priceLevel and close > p.priceLevel
                        p.state := LS_REINFORCED
                        p.touchCount += 1
                        p.confidence := math.min(p.confidence + 0.1, 1.0)
                        array.push(_lc_logs, str.tostring(time, "HH:mm") + " Pool " + str.tostring(p.id) + " Reinforced")
                else if p.poolType == LT_SELL_SIDE
                    if close > p.priceLevel
                        int prevState = p.state
                        p.state := LS_SWEPT
                        p.isSwept := true
                        p.sweptAtBar := bar_index
                        array.push(_lc_logs, str.tostring(time, "HH:mm") + " Pool " + str.tostring(p.id) + " " + f_state_to_string(prevState) + "->" + f_state_to_string(LS_SWEPT))
                    else if high >= p.priceLevel and close < p.priceLevel
                        p.state := LS_REINFORCED
                        p.touchCount += 1
                        p.confidence := math.min(p.confidence + 0.1, 1.0)
                        array.push(_lc_logs, str.tostring(time, "HH:mm") + " Pool " + str.tostring(p.id) + " Reinforced")
                        
            if p.state == LS_SWEPT and p.sweptAtBar < bar_index
                int prevState = p.state
                p.state := LS_INVALIDATED
                p.invalidatedAtBar := bar_index
                array.push(_lc_logs, str.tostring(time, "HH:mm") + " Pool " + str.tostring(p.id) + " " + f_state_to_string(prevState) + "->" + f_state_to_string(LS_INVALIDATED))
                
            if i < array.size(g_pool_trackers)
                PoolTracker t = array.get(g_pool_trackers, i)
                if t.lastState != p.state
                    int prev = t.lastState
                    int curr = p.state
                    string transStr = f_state_to_string(prev) + " -> " + f_state_to_string(curr)
                    int activeDur = 0
                    int reinDur = 0
                    int sweptDur = 0
                    if prev == LS_ACTIVE
                        activeDur := bar_index - t.activeStartBar
                    else if prev == LS_REINFORCED
                        reinDur := bar_index - t.reinforcedStartBar
                    else if prev == LS_SWEPT
                        sweptDur := bar_index - t.sweptStartBar
                    LifecycleAuditEntry entry = LifecycleAuditEntry.new(p.id, prev, curr, transStr, p.sweepReasonCode, bar_index, activeDur, reinDur, sweptDur)
                    array.push(g_lifecycle_audit_log, entry)
                    if curr == LS_ACTIVE
                        t.activeStartBar := bar_index
                    else if curr == LS_REINFORCED
                        t.reinforcedStartBar := bar_index
                    else if curr == LS_SWEPT
                        t.sweptStartBar := bar_index
                    t.lastState := curr
                
            if p.poolType == LT_BUY_SIDE
                _tBull += 1
            else
                _tBear += 1
                
            if p.state == LS_ACTIVE
                _active_count += 1
                _eBull += p.poolType == LT_BUY_SIDE ? 1 : 0
                _eBear += p.poolType == LT_SELL_SIDE ? 1 : 0
            else if p.state == LS_REINFORCED
                _rein_count += 1
                _eBull += p.poolType == LT_BUY_SIDE ? 1 : 0
                _eBear += p.poolType == LT_SELL_SIDE ? 1 : 0
            else if p.state == LS_SWEPT
                _swept_count += 1
                _eBull += p.poolType == LT_BUY_SIDE ? 1 : 0
                _eBear += p.poolType == LT_SELL_SIDE ? 1 : 0
            else if p.state == LS_INVALIDATED
                _invalid_count += 1
            else if p.state == LS_EXPIRED
                _expired_count += 1

    if array.size(g_lifecycle_audit_log) > 10
        array.shift(g_lifecycle_audit_log)

    if array.size(_lc_logs) > 0
        string final_log = array.join(_lc_logs, " | ")
        array.push(g_event_log, str.tostring(time, "HH:mm") + " " + final_log)
        array.clear(_lc_logs)

    if array.size(g_registry) > 0 and array.size(g_registry) == array.size(g_pool_trackers)
        for i = array.size(g_registry) - 1 to 0
            LiquidityPool p = array.get(g_registry, i)
            if p.state == LS_EXPIRED or p.state == LS_INVALIDATED
                array.remove(g_registry, i)
                array.remove(g_pool_trackers, i)

    float _bestBullScore = -1.0
    float _bestBearScore = -1.0
    LiquidityPool _bestBull = na
    LiquidityPool _bestBear = na

    if array.size(g_registry) > 0
        for i = 0 to array.size(g_registry) - 1
            LiquidityPool p = array.get(g_registry, i)
            if p.state == LS_ACTIVE or p.state == LS_REINFORCED or p.state == LS_SWEPT
                float score = f_score_pool(p)
                if p.poolType == LT_BUY_SIDE and score > _bestBullScore
                    _bestBullScore := score
                    _bestBull := p
                else if p.poolType == LT_SELL_SIDE and score > _bestBearScore
                    _bestBearScore := score
                    _bestBear := p

    LiquidityPool _bestOverall = na
    string _selReason = "No eligible pools found."
    float _selConf = 0.0

    if not na(_bestBull) and not na(_bestBear)
        if _bestBullScore >= _bestBearScore
            _bestOverall := _bestBull
            _selReason := "Bullish selected (Highest Score)."
            _selConf := _bestBull.confidence
        else
            _bestOverall := _bestBear
            _selReason := "Bearish selected (Highest Score)."
            _selConf := _bestBear.confidence
    else if not na(_bestBull)
        _bestOverall := _bestBull
        _selReason := "Bullish selected (No Bearish competition)."
        _selConf := _bestBull.confidence
    else if not na(_bestBear)
        _bestOverall := _bestBear
        _selReason := "Bearish selected (No Bullish competition)."
        _selConf := _bestBear.confidence

    S.current_selection := SelectionResult.new(_bestBull, _bestBear, _bestOverall, _selReason, _selConf)
    if S.current_selection.selectionReason != "No eligible pools found."
        array.push(g_event_log, str.tostring(time, "HH:mm") + " SELECT: " + S.current_selection.selectionReason)

    string _filterBull = "PASS"
    string _filterBear = "PASS"
    if _eBull == 0 and _tBull > 0
        _filterBull := "FAIL: No eligible bull pools"
    if _eBear == 0 and _tBear > 0
        _filterBear := "FAIL: No eligible bear pools"

    S.current_audit := SelectionAuditData.new(_tBull, _tBear, _eBull, _eBear, _filterBull, _filterBear, na(_bestBull) ? -1 : _bestBull.id, na(_bestBear) ? -1 : _bestBear.id, na(_bestOverall) ? -1 : _bestOverall.id, na(_bestOverall) ? "No eligible pools" : "Selected (No conflicts)")
    if S.current_audit.selectedOverallId == -1
        array.push(g_event_log, str.tostring(time, "HH:mm") + " AUDIT: " + S.current_audit.finalRejectionReason)

    bool _isSwept = false
    int _sweepDir = TD_NEUTRAL
    float _sweepConf = 0.0
    string _sweepReason = "NO_SWEEP_DETECTED"
    LiquidityPool _sweptPool = na

    if not na(S.current_selection.bestOverallPool) and not na(S.current_context)
        LiquidityPool p = S.current_selection.bestOverallPool
        float level = p.priceLevel
        float atr_v = S.current_context.atr
        float max_depth = atr_v * SWEEP_THRESHOLD
        if p.poolType == LT_SELL_SIDE
            if low <= level and close > level 
                float sweep_depth = level - low
                if sweep_depth <= max_depth
                    _isSwept := true
                    _sweepDir := TD_LONG
                    _sweepConf := 0.8 - (sweep_depth / max_depth * 0.3) 
                    _sweepReason := "BULLISH_SWEEP_WICK"
                    _sweptPool := p
                else
                    _sweepReason := "SWEEP_TOO_DEEP"
        else if p.poolType == LT_BUY_SIDE
            if high >= level and close < level 
                float sweep_depth = high - level
                if sweep_depth <= max_depth
                    _isSwept := true
                    _sweepDir := TD_SHORT
                    _sweepConf := 0.8 - (sweep_depth / max_depth * 0.3)
                    _sweepReason := "BEARISH_SWEEP_WICK"
                    _sweptPool := p
                else
                    _sweepReason := "SWEEP_TOO_DEEP"

    S.current_sweep_validation := SweepValidationResult.new(_isSwept, _sweepDir, _sweepConf, _sweepReason, _sweptPool)
    if S.current_sweep_validation.isSwept
        array.push(g_event_log, str.tostring(time, "HH:mm") + " SWEEP: " + S.current_sweep_validation.sweepReason)

    bool _ready = true
    string _result = "PASS"
    string _reason = "All conditions met."
    string _status = "Validated"

    if S.market_status != "OPEN"
        _ready := false
        _result := "FAIL"
        _reason := "Market Closed"
        _status := "Rejected (Market Closed)"
    else if na(S.current_selection.bestOverallPool)
        _ready := false
        _result := "FAIL"
        _reason := "No Pool Selected"
        _status := "Rejected (No Selection)"
    else if not S.current_sweep_validation.isSwept
        _ready := false
        _result := "FAIL"
        _reason := "No Sweep Detected"
        _status := "Rejected (No Sweep)"
    else if S.current_trend == TD_NEUTRAL
        _ready := false
        _result := "FAIL"
        _reason := "Trend Neutral"
        _status := "Rejected (No Trend)"

    S.current_validation := ValidationSummary.new(_ready, _result, _reason, _status, S.current_context, S.current_selection, S.current_sweep_validation, S.current_trend)
    if S.current_validation.isReady
        array.push(g_event_log, str.tostring(time, "HH:mm") + " VALIDATION: PASS - Ready for Strategy")
    else if S.current_validation.validationResult == "FAIL"
        array.push(g_event_log, str.tostring(time, "HH:mm") + " VALIDATION: FAIL - " + S.current_validation.failureReason)

    bool _approved = false
    int _dir = TD_NEUTRAL
    float _entry = na
    float _sl = na
    float _tp = na
    float _rr = 0.0
    float _conf = 0.0
    string _stratReason = "N/A"

    if S.current_validation.isReady
        SweepValidationResult sweep = S.current_validation.sweep
        ContextSnapshot snap = S.current_validation.context
        LiquidityPool pool = S.current_validation.selection.bestOverallPool
        if sweep.sweepDirection == TD_LONG 
            _approved := true
            _dir := TD_LONG
            _entry := close
            _sl := pool.priceLevel - (snap.atr * 0.2)
            _tp := _entry + (snap.atr * 2.0)
            if _entry != _sl
                _rr := (_tp - _entry) / (_entry - _sl)
            _conf := (sweep.sweepConfidence * 0.6) + (pool.confidence * 0.4)
        else if sweep.sweepDirection == TD_SHORT 
            _approved := true
            _dir := TD_SHORT
            _entry := close
            _sl := pool.priceLevel + (snap.atr * 0.2)
            _tp := _entry - (snap.atr * 2.0)
            if _entry != _sl
                _rr := (_entry - _tp) / (_sl - _entry)
            _conf := (sweep.sweepConfidence * 0.6) + (pool.confidence * 0.4)
        else
            _stratReason := "Invalid Sweep Direction"
    else
        _stratReason := S.current_validation.failureReason

    S.current_strategy := StrategyResult.new(_approved, _dir, _entry, _sl, _tp, _rr, _conf, _stratReason)
    if S.current_strategy.strategyApproved
        array.push(g_event_log, str.tostring(time, "HH:mm") + " STRATEGY: Approved " + (S.current_strategy.direction == TD_LONG ? "LONG" : "SHORT"))

    bool _arbApproved = false
    int _arbDir = TD_NEUTRAL
    float _arbEntry = na
    float _arbSl = na
    float _arbTp = na
    string _arbReason = "N/A"

    if S.current_strategy.strategyApproved
        if S.current_strategy.direction == TD_LONG and S.current_context.marketBias == TD_SHORT
            _arbReason := "Conflict: Long vs Bearish Trend"
        else if S.current_strategy.direction == TD_SHORT and S.current_context.marketBias == TD_LONG
            _arbReason := "Conflict: Short vs Bullish Trend"
        else
            _arbApproved := true
            _arbDir := S.current_strategy.direction
            _arbEntry := S.current_strategy.entryPrice
            _arbSl := S.current_strategy.stopLoss
            _arbTp := S.current_strategy.takeProfit
            _arbReason := "Approved (No Conflicts)"
    else
        _arbReason := "Strategy Rejected"

    S.current_arbitration := ArbitrationResult.new(_arbApproved, _arbDir, _arbEntry, _arbSl, _arbTp, _arbReason)
    if S.current_arbitration.isApproved
        array.push(g_event_log, str.tostring(time, "HH:mm") + " ARBITRATION: Approved " + (S.current_arbitration.direction == TD_LONG ? "LONG" : "SHORT"))

    if array.size(g_recommendations) > 0
        for i = 0 to array.size(g_recommendations) - 1
            Recommendation rec = array.get(g_recommendations, i)
            if rec.status == RS_ACTIVE
                if rec.candidate.direction == TD_LONG and low <= rec.actualStop
                    rec.status := RS_INVALIDATED
                else if rec.candidate.direction == TD_SHORT and high >= rec.actualStop
                    rec.status := RS_INVALIDATED
                else if rec.candidate.direction == TD_LONG and high >= rec.candidate.takeProfit
                    rec.status := RS_FULFILLED
                else if rec.candidate.direction == TD_SHORT and low <= rec.candidate.takeProfit
                    rec.status := RS_FULFILLED
                else if bar_index - rec.createdBarIndex > 100
                    rec.status := RS_EXPIRED

    bool has_active_rec = false
    S.active_rec := na
    if array.size(g_recommendations) > 0
        for i = array.size(g_recommendations) - 1 to 0
            Recommendation r = array.get(g_recommendations, i)
            if r.status == RS_ACTIVE
                has_active_rec := true
                S.active_rec := r
                break

    if S.current_arbitration.isApproved and not has_active_rec
        int recId = S.next_rec_id
        S.next_rec_id += 1
        StrategyCandidate cand = StrategyCandidate.new(recId, S.current_selection.bestOverallPool, S.current_context, S.current_arbitration.direction, S.current_arbitration.entryPrice, S.current_arbitration.stopLoss, S.current_arbitration.takeProfit, "ICT_Liquidity_Sweep")
        Recommendation newRec = Recommendation.new(recId, cand, RS_ACTIVE, bar_index, S.current_arbitration.entryPrice, S.current_arbitration.stopLoss)
        array.push(g_recommendations, newRec)
        S.active_rec := newRec
        array.push(g_event_log, str.tostring(time, "HH:mm") + " REC_CREATE: Approved " + (S.current_arbitration.direction == TD_LONG ? "LONG" : "SHORT"))
    S

