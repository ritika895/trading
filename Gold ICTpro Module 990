    bool new_swing_high = not na(st.structure.last_swing_high_price) and st.structure.last_swing_high_bar == bar_index - SWING_LOOKBACK
    bool new_swing_low  = not na(st.structure.last_swing_low_price) and st.structure.last_swing_low_bar == bar_index - SWING_LOOKBACK

    st.current_trace.pool_str += "\nHighPrice=" + str.tostring(st.structure.last_swing_high_price, "#.##")
    st.current_trace.pool_str += "\nLowPrice=" + str.tostring(st.structure.last_swing_low_price, "#.##")

    st.current_trace.pool_str += "\nnew_swing_high=" + (new_swing_high ? "TRUE" : "FALSE") + " new_swing_low=" + (new_swing_low ? "TRUE" : "FALSE")

    if new_swing_high
        st.current_trace.pool_str += "\nPASSED SWING CHECK (HIGH)"
        _ = f_emit_engine_event(st, 0, "DBG-M6", MOD_LIQ, EVENT_EMIT, SEV_INFO, "DEBUG", "M6", "PASSED SWING CHECK (HIGH)", "{}", true)
        
        int pool_id = st.counters.next_pool_id
        st.counters.next_pool_id += 1
        st.counters.liq_total_emitted += 1
        st.analytics.val_pools_created += 1
        
        LiquidityPool new_pool = f_create_liquidity_pool(pool_id, LT_BUY_SIDE, LS_ACTIVE, st.structure.last_swing_high_price, 0, 0.5, false, bar_index - SWING_LOOKBACK, na, na, "NONE", array.new<SwingPoint>())
        st.current_trace.pool_str += "\nPOOL CREATED (HIGH) ID:" + str.tostring(pool_id)
        _ = f_emit_engine_event(st, 0, "DBG-M6", MOD_LIQ, EVENT_EMIT, SEV_INFO, "DEBUG", "M6", "POOL CREATED (HIGH) ID:" + str.tostring(pool_id), "{}", true)
             
        array.push(g_registry, new_pool)
        
        st.current_trace.pool_str += "\nRegistrySize=" + str.tostring(array.size(g_registry))
        st.current_trace.pool_str += "\nPoolsCreated=" + str.tostring(st.analytics.val_pools_created)
        
        LiquidityPool verify_pool = array.get(g_registry, array.size(g_registry) - 1)
        st.current_trace.pool_str += "\nLastPoolID=" + str.tostring(verify_pool.id)
        st.current_trace.pool_str += "\nLastPoolState=" + str.tostring(verify_pool.state)
        
        _ = f_emit_engine_event(st, 0, "DBG-M6", MOD_LIQ, EVENT_EMIT, SEV_INFO, "DEBUG", "M6", "PUSHED TO REGISTRY | Size=" + str.tostring(array.size(g_registry)), "{}", true)
        
        string obj_id = f_format_id("M6-BSL", pool_id, 0)
        string corr_id = "M6-" + str.tostring(bar_index)
        string msg = "Buy-Side Liquidity Created @ " + str.tostring(new_pool.priceLevel, "#.##")
        _ = f_emit_engine_event(st, 0, corr_id, MOD_LIQ, EVENT_CREATE, SEV_INFO, "SUCCESS", obj_id, msg, "{}", true)
        f_m6_record_pool_audit(st, corr_id, obj_id, msg)

    if new_swing_low
        st.current_trace.pool_str += "\nPASSED SWING CHECK (LOW)"
        _ = f_emit_engine_event(st, 0, "DBG-M6", MOD_LIQ, EVENT_EMIT, SEV_INFO, "DEBUG", "M6", "PASSED SWING CHECK (LOW)", "{}", true)
        
        int pool_id = st.counters.next_pool_id
        st.counters.next_pool_id += 1
        st.counters.liq_total_emitted += 1
        st.analytics.val_pools_created += 1
        
        LiquidityPool new_pool = f_create_liquidity_pool(pool_id, LT_SELL_SIDE, LS_ACTIVE, st.structure.last_swing_low_price, 0, 0.5, false, bar_index - SWING_LOOKBACK, na, na, "NONE", array.new<SwingPoint>())
        st.current_trace.pool_str += "\nPOOL CREATED (LOW) ID:" + str.tostring(pool_id)
        _ = f_emit_engine_event(st, 0, "DBG-M6", MOD_LIQ, EVENT_EMIT, SEV_INFO, "DEBUG", "M6", "POOL CREATED (LOW) ID:" + str.tostring(pool_id), "{}", true)
             
        array.push(g_registry, new_pool)
        
        st.current_trace.pool_str += "\nRegistrySize=" + str.tostring(array.size(g_registry))
        st.current_trace.pool_str += "\nPoolsCreated=" + str.tostring(st.analytics.val_pools_created)
        
        LiquidityPool verify_pool = array.get(g_registry, array.size(g_registry) - 1)
        st.current_trace.pool_str += "\nLastPoolID=" + str.tostring(verify_pool.id)
        st.current_trace.pool_str += "\nLastPoolState=" + str.tostring(verify_pool.state)
        
        _ = f_emit_engine_event(st, 0, "DBG-M6", MOD_LIQ, EVENT_EMIT, SEV_INFO, "DEBUG", "M6", "PUSHED TO REGISTRY | Size=" + str.tostring(array.size(g_registry)), "{}", true)
        
        string obj_id = f_format_id("M6-SSL", pool_id, 0)
        string corr_id = "M6-" + str.tostring(bar_index)
        string msg = "Sell-Side Liquidity Created @ " + str.tostring(new_pool.priceLevel, "#.##")
        _ = f_emit_engine_event(st, 0, corr_id, MOD_LIQ, EVENT_CREATE, SEV_INFO, "SUCCESS", obj_id, msg, "{}", true)
        f_m6_record_pool_audit(st, corr_id, obj_id, msg)

    LiquidityPool _shifted_pool = na
    while array.size(g_registry) > MAX_POOLS
        _shifted_pool := array.shift(g_registry)

    if array.size(g_registry) > 0
        for i = 0 to array.size(g_registry) - 1
            LiquidityPool pool = array.get(g_registry, i)
            
            if pool.state == LS_EXPIRED or pool.state == LS_INVALIDATED
                continue
                
            float lvl = pool.priceLevel
            bool is_buy = pool.poolType == LT_BUY_SIDE

            if bar_index - pool.createdAtBar > POOL_EXPIRY_BARS
                pool.state := LS_EXPIRED
                pool.invalidatedAtBar := bar_index
                string obj_id = f_format_id("M6-POOL", pool.id, 0)
                string corr_id = "M6-" + str.tostring(bar_index)
                string msg = "Pool #" + str.tostring(pool.id) + " Expired"
                _ = f_emit_engine_event(st, 0, corr_id, MOD_LIQ, EVENT_INVALID, SEV_INFO, "EXPIRED", obj_id, msg, "{}", true)
                f_m6_record_pool_audit(st, corr_id, obj_id, msg)
                continue

            if pool.state == LS_ACTIVE or pool.state == 2
                bool sweep_cond = is_buy ? (high > lvl and close < lvl) : (low < lvl and close > lvl)
                if sweep_cond
                    pool.state := LS_SWEPT
                    pool.isSwept := true
                    pool.sweptAtBar := bar_index
                    pool.sweepReasonCode := is_buy ? "BSL_SWEEP" : "SSL_SWEEP"
                    st.analytics.val_sweeps += 1
                    string obj_id = f_format_id("M6-POOL", pool.id, 0)
                    string corr_id = "M6-" + str.tostring(bar_index)
                    string msg = "Pool #" + str.tostring(pool.id) + " Swept"
                    _ = f_emit_engine_event(st, 0, corr_id, MOD_LIQ, EVENT_INVALID, SEV_WARNING, "SWEPT", obj_id, msg, "{}", true)
                    f_m6_record_pool_audit(st, corr_id, obj_id, msg)
                    continue

                bool inv_cond = is_buy ? (close > lvl) : (close < lvl)
                if inv_cond
                    pool.state := LS_INVALIDATED
                    pool.invalidatedAtBar := bar_index
                    pool.sweepReasonCode := "BOS_BREAK"
                    string obj_id = f_format_id("M6-POOL", pool.id, 0)
                    string corr_id = "M6-" + str.tostring(bar_index)
                    string msg = "Pool #" + str.tostring(pool.id) + " Invalidated by BOS"
                    _ = f_emit_engine_event(st, 0, corr_id, MOD_LIQ, EVENT_INVALID, SEV_ERROR, "INVALIDATED", obj_id, msg, "{}", true)
                    f_m6_record_pool_audit(st, corr_id, obj_id, msg)
                    continue

                bool touch_cond = is_buy ? (high >= lvl) : (low <= lvl)
                if touch_cond and pool.state == LS_ACTIVE
                    pool.state := 2
                    pool.touchCount += 1
                    array.push(pool.mitigations, SwingPoint.new(lvl, bar_index, time, is_buy))

            else if pool.state == LS_SWEPT
                bool inv_cond = is_buy ? (close > lvl) : (close < lvl)
                if inv_cond
                    pool.state := LS_INVALIDATED
                    pool.invalidatedAtBar := bar_index
                    pool.sweepReasonCode := "POST_SWEEP_INVALIDATION"
                    string obj_id = f_format_id("M6-POOL", pool.id, 0)
                    string corr_id = "M6-" + str.tostring(bar_index)
                    string msg = "Swept Pool #" + str.tostring(pool.id) + " Invalidated"
                    _ = f_emit_engine_event(st, 0, corr_id, MOD_LIQ, EVENT_INVALID, SEV_ERROR, "INVALIDATED", obj_id, msg, "{}", true)
                    f_m6_record_pool_audit(st, corr_id, obj_id, msg)

    st.current_trace.pool_str += "\nEXIT M6 | Pools:" + str.tostring(st.analytics.val_pools_created) + " RegSize:" + str.tostring(array.size(g_registry))
    _ = f_emit_engine_event(st, 0, "DBG-M6", MOD_LIQ, EVENT_EMIT, SEV_INFO, "DEBUG", "M6", "EXIT M6 | Pools:" + str.tostring(st.analytics.val_pools_created) + " RegSize:" + str.tostring(array.size(g_registry)), "{}", true)

