indicator("Gold ICT Pro - Phase 8 Engine", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// ============================================================================
// Gold ICT Pro - Phase 8 Engine
// Architecture Version: 8.0
// Pine Script Version: 6
