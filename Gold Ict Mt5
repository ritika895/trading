f_get_latest_mtf_bias(string tf) =>
    int bias = TD_NEUTRAL
    int sz = array.size(g_mtf_registry)
    if sz > 0
        for i = sz - 1 to 0
            MTFStructureInstance mtf_m = array.get(g_mtf_registry, i)
            if mtf_m.timeframe == tf
                bias := mtf_m.structuralBias
                break
    bias

f_compute_p9(EngineState state) =>
    EngineState st = state
    int bus_evt_id = 0
    bool _p8_integ = not na(st.current_context.atr) and st.current_context.atr > 0
    bool _liq_integ = _p8_integ and (st.mtf.integ_1 and st.mtf.integ_2 and st.mtf.integ_3)
    if _p8_integ
        if not na(ph1)
            st.mtf.hi_1 := ph1
        if not na(pl1)
            st.mtf.lo_1 := pl1
        if t1 != st.mtf.t_1
            if not na(st.mtf.hi_1) and c1 > st.mtf.hi_1
                if st.mtf.bias_1 == TD_SHORT
                    st.mtf.choch_1 := TD_LONG
                else
                    st.mtf.bos_1 := TD_LONG
                st.mtf.bias_1 := TD_LONG
            if not na(st.mtf.lo_1) and c1 < st.mtf.lo_1
                if st.mtf.bias_1 == TD_LONG
                    st.mtf.choch_1 := TD_SHORT
                else
                    st.mtf.bos_1 := TD_SHORT
                st.mtf.bias_1 := TD_SHORT
            st.mtf.t_1 := t1
        st.mtf.integ_1 := _p8_integ
        bool mtf_changed_1 = st.mtf.bias_1 != st.mtf.l_bias_1 or st.mtf.bos_1 != st.mtf.l_bos_1 or st.mtf.choch_1 != st.mtf.l_choch_1 or st.mtf.integ_1 != st.mtf.l_integ_1 or st.mtf.ver_1 == 0
        if mtf_changed_1
            st.mtf.ver_1 := st.mtf.ver_1 == 0 ? 1 : st.mtf.ver_1 + 1
            string baseId = "MTF-" + P9_HTF_1
            string instId = baseId + "-v" + str.tostring(st.mtf.ver_1)
            string prevId = st.mtf.ver_1 == 1 ? "" : baseId + "-v" + str.tostring(st.mtf.ver_1 - 1)
            MTFStructureInstance inst = MTFStructureInstance.new(baseId, instId, prevId, "MTFStructure", "MTFStructureAdapter", bar_index, "Active", _p8_integ, "MTFStructureContract-1.0", P9_HTF_1, st.mtf.bias_1, st.mtf.bos_1, st.mtf.choch_1, time)
            array.push(g_mtf_registry, inst)
            if array.size(g_mtf_registry) > 100
                array.shift(g_mtf_registry)
            st.mtf.l_bias_1 := st.mtf.bias_1
            st.mtf.l_bos_1 := st.mtf.bos_1
            st.mtf.l_choch_1 := st.mtf.choch_1
            st.mtf.l_integ_1 := st.mtf.integ_1
        if not na(ph2)
            st.mtf.hi_2 := ph2
        if not na(pl2)
            st.mtf.lo_2 := pl2
        if t2 != st.mtf.t_2
            if not na(st.mtf.hi_2) and c2 > st.mtf.hi_2
                if st.mtf.bias_2 == TD_SHORT
                    st.mtf.choch_2 := TD_LONG
                else
                    st.mtf.bos_2 := TD_LONG
                st.mtf.bias_2 := TD_LONG
            if not na(st.mtf.lo_2) and c2 < st.mtf.lo_2
                if st.mtf.bias_2 == TD_LONG
                    st.mtf.choch_2 := TD_SHORT
                else
                    st.mtf.bos_2 := TD_SHORT
                st.mtf.bias_2 := TD_SHORT
            st.mtf.t_2 := t2
        st.mtf.integ_2 := _p8_integ
        bool mtf_changed_2 = st.mtf.bias_2 != st.mtf.l_bias_2 or st.mtf.bos_2 != st.mtf.l_bos_2 or st.mtf.choch_2 != st.mtf.l_choch_2 or st.mtf.integ_2 != st.mtf.l_integ_2 or st.mtf.ver_2 == 0
        if mtf_changed_2
            st.mtf.ver_2 := st.mtf.ver_2 == 0 ? 1 : st.mtf.ver_2 + 1
            string baseId = "MTF-" + P9_HTF_2
            string instId = baseId + "-v" + str.tostring(st.mtf.ver_2)
            string prevId = st.mtf.ver_2 == 1 ? "" : baseId + "-v" + str.tostring(st.mtf.ver_2 - 1)
            MTFStructureInstance inst = MTFStructureInstance.new(baseId, instId, prevId, "MTFStructure", "MTFStructureAdapter", bar_index, "Active", _p8_integ, "MTFStructureContract-1.0", P9_HTF_2, st.mtf.bias_2, st.mtf.bos_2, st.mtf.choch_2, time)
            array.push(g_mtf_registry, inst)
            if array.size(g_mtf_registry) > 100
                array.shift(g_mtf_registry)
            st.mtf.l_bias_2 := st.mtf.bias_2
            st.mtf.l_bos_2 := st.mtf.bos_2
            st.mtf.l_choch_2 := st.mtf.choch_2
            st.mtf.l_integ_2 := st.mtf.integ_2
        if not na(ph3)
            st.mtf.hi_3 := ph3
        if not na(pl3)
            st.mtf.lo_3 := pl3
        if t3 != st.mtf.t_3
            if not na(st.mtf.hi_3) and c3 > st.mtf.hi_3
                if st.mtf.bias_3 == TD_SHORT
                    st.mtf.choch_3 := TD_LONG
                else
                    st.mtf.bos_3 := TD_LONG
                st.mtf.bias_3 := TD_LONG
            if not na(st.mtf.lo_3) and c3 < st.mtf.lo_3
                if st.mtf.bias_3 == TD_LONG
                    st.mtf.choch_3 := TD_SHORT
                else
                    st.mtf.bos_3 := TD_SHORT
                st.mtf.bias_3 := TD_SHORT
            st.mtf.t_3 := t3
        st.mtf.integ_3 := _p8_integ
        bool mtf_changed_3 = st.mtf.bias_3 != st.mtf.l_bias_3 or st.mtf.bos_3 != st.mtf.l_bos_3 or st.mtf.choch_3 != st.mtf.l_choch_3 or st.mtf.integ_3 != st.mtf.l_integ_3 or st.mtf.ver_3 == 0
        if mtf_changed_3
            st.mtf.ver_3 := st.mtf.ver_3 == 0 ? 1 : st.mtf.ver_3 + 1
            string baseId = "MTF-" + P9_HTF_3
            string instId = baseId + "-v" + str.tostring(st.mtf.ver_3)
            string prevId = st.mtf.ver_3 == 1 ? "" : baseId + "-v" + str.tostring(st.mtf.ver_3 - 1)
            MTFStructureInstance inst = MTFStructureInstance.new(baseId, instId, prevId, "MTFStructure", "MTFStructureAdapter", bar_index, "Active", _p8_integ, "MTFStructureContract-1.0", P9_HTF_3, st.mtf.bias_3, st.mtf.bos_3, st.mtf.choch_3, time)
            array.push(g_mtf_registry, inst)
            if array.size(g_mtf_registry) > 100
                array.shift(g_mtf_registry)
            st.mtf.l_bias_3 := st.mtf.bias_3
            st.mtf.l_bos_3 := st.mtf.bos_3
            st.mtf.l_choch_3 := st.mtf.choch_3
            st.mtf.l_integ_3 := st.mtf.integ_3
    int LIQ_MAJOR_SCORE = 75
    int LIQ_INTER_SCORE = 45
    if array.size(g_registry) > 0
        for i = 0 to array.size(g_registry) - 1
            LiquidityPool pool = array.get(g_registry, i)
            if _liq_integ and barstate.isconfirmed
                if pool.state == LS_ACTIVE
                    int age = bar_index - pool.createdAtBar
                    float age_score = math.min(float(age), 200.0) / 200.0 * 40.0
                    float touch_score = math.min(float(pool.touchCount), 5.0) / 5.0 * 30.0
                    float conf_score = pool.confidence * 30.0
                    float inst_score = age_score + touch_score + conf_score
                    string tier_str = "Minor"
                    if inst_score >= LIQ_MAJOR_SCORE
                        tier_str := "Major"
                    else if inst_score >= LIQ_INTER_SCORE
                        tier_str := "Intermediate"
                    int idx = array.indexof(g_liq_pool_ids, pool.id)
                    string ct = idx == -1 ? "" : array.get(g_liq_tier_map, idx)
                    bool cs = idx == -1 ? false : array.get(g_liq_swept_map, idx)
                    int curVer = idx == -1 ? 0 : array.get(g_liq_ver_map, idx)
                    bool changed = false
                    string prevId = ""
                    int newVer = 1
                    if curVer == 0
                        changed := true
                        array.push(g_liq_pool_ids, pool.id)
                        array.push(g_liq_tier_map, tier_str)
                        array.push(g_liq_swept_map, pool.isSwept)
                        array.push(g_liq_ver_map, 1)
                        array.push(g_liq_score_map, inst_score)
                    else
                        if ct != tier_str or cs != pool.isSwept
                            changed := true
                            prevId := "LIQ-" + str.tostring(pool.id) + "-v" + str.tostring(curVer)
                            newVer := curVer + 1
                            array.set(g_liq_tier_map, idx, tier_str)
                            array.set(g_liq_swept_map, idx, pool.isSwept)
                            array.set(g_liq_ver_map, idx, newVer)
                            array.set(g_liq_score_map, idx, inst_score)
                    if changed
                        string baseId = "LIQ-" + str.tostring(pool.id)
                        string instId = baseId + "-v" + str.tostring(newVer)
                        LiquidityHierarchyInstance inst = LiquidityHierarchyInstance.new(baseId, instId, prevId, "LiquidityHierarchy", "LiquidityHierarchyEngine", bar_index, "Active", _liq_integ, "LiquidityHierarchyContract-1.0", pool.id, tier_str, timeframe.period, pool.priceLevel, pool.isSwept, inst_score)
                        array.push(g_liq_registry, inst)
                        st.counters.liq_total_emitted += 1
                        if array.size(g_liq_registry) > 100
                            array.shift(g_liq_registry)
    bool pd_integ = _p8_integ and (st.mtf.integ_1 and st.mtf.integ_2 and st.mtf.integ_3)
    if pd_integ and barstate.isconfirmed
        float r_high = st.structure.last_swing_high_price
        float r_low = st.structure.last_swing_low_price
        float r_size = na
        float eq_v = na
        float pos_pct = 50.0
        string zone = "Equilibrium"
        if not na(r_high) and not na(r_low)
            r_size := r_high - r_low
            eq_v := r_low + (r_size * 0.5)
            pos_pct := r_size == 0 ? 50.0 : ((close - r_low) / r_size) * 100.0
            zone := pos_pct > 50.0 ? "Premium" : pos_pct < 50.0 ? "Discount" : "Equilibrium"
        bool changed = false
        string prevId = ""
        int newVer = 1
        int currentVer = st.counters.pd_ver
        if currentVer == 0
