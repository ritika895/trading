// Helper to find nearest liquidity tier for a given price
f_find_nearest_liq_tier(float price) =>
    string nearest_tier = "None"
    float nearest_dist = -1.0
    int sz = array.size(g_liq_pool_id)
    if sz > 0
        for i = 0 to sz - 1
            int pool_id = array.get(g_liq_pool_id, i)
            LiquidityPool p = f_registry_get(pool_id)
            if not na(p)
                float dist = math.abs(p.priceLevel - price)
                if nearest_dist == -1.0 or dist < nearest_dist
                    nearest_dist := dist
                    nearest_tier := array.get(g_liq_tier, i)
    // Only return if within 1 ATR (roughly)
    float atr_val = ta.atr(ATR_LENGTH)
    nearest_dist <= atr_val ? nearest_tier : "None"

// Emit new FVG Instance (Immutable)
f_fvg_emit(int idx, string new_state, float new_mit_pct) =>
    string baseId = array.get(g_fvg_base_id, idx)
    int currentVer = array.get(g_fvg_ver, idx)
    int newVer = currentVer + 1
    string prevId = baseId + "-v" + str.tostring(currentVer)
    string instId = baseId + "-v" + str.tostring(newVer)
    
    // Update live arrays
    array.set(g_fvg_ver, idx, newVer)
    array.set(g_fvg_state, idx, new_state)
    array.set(g_fvg_mit_pct, idx, new_mit_pct)
    
    FVGInstance inst = FVGInstance.new(
         baseId, instId, prevId,
         "FVG", P9_FVG_MODULE,
         bar_index, new_state, f_mtf_all_ok(),
         P9_FVG_CVER,
         array.get(g_fvg_dir, idx), 
         array.get(g_fvg_top, idx), 
         array.get(g_fvg_bot, idx), 
         new_mit_pct, 
         array.get(g_fvg_mtf_bias, idx), 
         array.get(g_fvg_pd_zone, idx), 
         array.get(g_fvg_liq_tier, idx), 
         time)
         
    array.push(g_fvg_registry, inst)
    f_p9_log(P9_FVG_MODULE, "FVG_EMIT", instId, f_mtf_all_ok())
    inst

// Create entirely new FVG
f_fvg_create(int dir, float top, float bot) =>
    int newId = array.get(g_fvg_next_id, 0)
    array.set(g_fvg_next_id, 0, newId + 1)
    string baseId = "FVG-" + str.tostring(newId)
    
    // Stamp Contextual Metadata
    int mtf_bias = f_mtf_bias("D")
    string pd_zone = array.get(g_pd_zone, 0)
    string liq_tier = f_find_nearest_liq_tier((top + bot) / 2.0)
    
    // Push to live arrays
    array.push(g_fvg_base_id, baseId)
    array.push(g_fvg_ver, 1)
    array.push(g_fvg_top, top)
    array.push(g_fvg_bot, bot)
    array.push(g_fvg_dir, dir)
    array.push(g_fvg_state, "Active")
    array.push(g_fvg_mit_pct, 0.0)
    array.push(g_fvg_mtf_bias, mtf_bias)
    array.push(g_fvg_pd_zone, pd_zone)
    array.push(g_fvg_liq_tier, liq_tier)
    
    string instId = baseId + "-v1"
    FVGInstance inst = FVGInstance.new(
         baseId, instId, "",
         "FVG", P9_FVG_MODULE,
         bar_index, "Active", f_mtf_all_ok(),
         P9_FVG_CVER,
         dir, top, bot, 0.0, 
         mtf_bias, pd_zone, liq_tier, time)
         
    array.push(g_fvg_registry, inst)
    f_p9_log(P9_FVG_MODULE, "FVG_EMIT", instId, f_mtf_all_ok())
    inst

// Prune dead FVGs to prevent memory bloat
f_fvg_prune() =>
    int full_cnt = 0
    int first_full_idx = -1
    int sz = array.size(g_fvg_base_id)
    
    if sz > 0
        for i = 0 to sz - 1
            if array.get(g_fvg_state, i) == "Full"
                full_cnt += 1
                if first_full_idx == -1
                    first_full_idx := i
                    
    if full_cnt > FVG_PRUNE_LIMIT and first_full_idx != -1
        array.remove(g_fvg_base_id, first_full_idx)
        array.remove(g_fvg_ver, first_full_idx)
        array.remove(g_fvg_top, first_full_idx)
        array.remove(g_fvg_bot, first_full_idx)
        array.remove(g_fvg_dir, first_full_idx)
        array.remove(g_fvg_state, first_full_idx)
        array.remove(g_fvg_mit_pct, first_full_idx)
        array.remove(g_fvg_mtf_bias, first_full_idx)
        array.remove(g_fvg_pd_zone, first_full_idx)
        array.remove(g_fvg_liq_tier, first_full_idx)
        
    // Also prune historical registry if it gets too large
    if array.size(g_fvg_registry) > 200
        array.shift(g_fvg_registry)

// Main Compute Function
f_compute_fvg() =>
    int t0 = timenow
    array<FVGInstance> emitted = array.new<FVGInstance>()
    
    // 1. Check for new FVGs on confirmed bar close
    // Using [1] and [3] ensures the 3-candle sequence is strictly closed and non-repainting.
    // Candle 1 = high[3]/low[3], Candle 2 = high[2]/low[2], Candle 3 = high[1]/low[1]
    if barstate.isconfirmed and not na(high[3]) and not na(low[3])
        
        // Bullish FVG: Low of Candle 3 > High of Candle 1
        if low[1] > high[3]
            FVGInstance e = f_fvg_create(TD_LONG, low[1], high[3])
            if not na(e)
                array.push(emitted, e)
                
        // Bearish FVG: High of Candle 3 < Low of Candle 1
        else if high[1] < low[3]
            FVGInstance e = f_fvg_create(TD_SHORT, low[3], high[1])
            if not na(e)
                array.push(emitted, e)
                
    // 2. Check mitigation for existing FVGs
    int sz = array.size(g_fvg_base_id)
    if sz > 0
        for i = 0 to sz - 1
            string state = array.get(g_fvg_state, i)
            if state != "Full"
                int dir = array.get(g_fvg_dir, i)
                float top = array.get(g_fvg_top, i)
                float bot = array.get(g_fvg_bot, i)
                float cur_mit = array.get(g_fvg_mit_pct, i)
                float new_mit = cur_mit
                string new_state = state
                
                if dir == TD_LONG
                    // Bullish FVG mitigation (price drops into it)
                    if low <= bot
                        new_mit := 100.0
                        new_state := "Full"
                    else if low < top
                        float pct = (top - low) / (top - bot) * 100.0
                        if pct > new_mit
                            new_mit := pct
                            new_state := "Partial"
                            
                else if dir == TD_SHORT
                    // Bearish FVG mitigation (price rises into it)
                    if high >= top
                        new_mit := 100.0
                        new_state := "Full"
                    else if high > bot
                        float pct = (high - bot) / (top - bot) * 100.0
                        if pct > new_mit
                            new_mit := pct
                            new_state := "Partial"
                            
                if new_mit != cur_mit
                    FVGInstance e = f_fvg_emit(i, new_state, new_mit)
                    if not na(e)
                        array.push(emitted, e)
                        
    // 3. Prune
    f_fvg_prune()
    
    // HealthPing
    if bar_index % 50 == 0
        int elapsed = timenow - t0
        HealthPing hp = HealthPing.new(P9_FVG_MODULE, array.size(g_fvg_registry), 500, elapsed, 0, 0, 0, 0)
        array.push(g_p9_health_pings, hp)
        
    emitted

// Execution
array<FVGInstance> g_fvg_emitted = f_compute_fvg()

// Visibility
if barstate.islast and array.size(g_fvg_emitted) > 0
    for i = 0 to array.size(g_fvg_emitted) - 1
        FVGInstance e = array.get(g_fvg_emitted, i)
        string msg = str.tostring(bar_index) + " — P9_FVG: " + e.instanceId + " | Dir: " + (e.direction == TD_LONG ? "Bull" : "Bear") + " | State: " + e.status + " | Mit: " + str.tostring(e.mitigationPercent, "#.#") + "%"
        array.push(g_event_log, msg)

// --- FVG Debug Panel (Testing Only) ---
var table fvg_debug_table = table.new(position.bottom_center, 2, 10, bgcolor=color.new(color.black, 10), border_width=1, border_color=color.new(color.gray, 60))

f_init_fvg_debug() =>
    if barstate.isfirst
        table.cell(fvg_debug_table, 0, 0, "FVG ENGINE DEBUG", text_color=color.yellow, text_size=size.tiny, bgcolor=color.new(color.navy, 60))
        table.merge_cells(fvg_debug_table, 0, 0, 1, 0)
        
        for i = 1 to 9
            table.cell(fvg_debug_table, 0, i, "", text_color=color.gray, text_size=size.tiny)
            table.cell(fvg_debug_table, 1, i, "", text_color=color.gray, text_size=size.tiny)

if barstate.islast and show_fvg_debug
    f_init_fvg_debug()
    
    int active_cnt = 0
    int partial_cnt = 0
    int full_cnt = 0
    int sz = array.size(g_fvg_base_id)
    if sz > 0
        for i = 0 to sz - 1
            string s = array.get(g_fvg_state, i)
            if s == "Active"
                active_cnt += 1
            else if s == "Partial"
                partial_cnt += 1
            else if s == "Full"
                full_cnt += 1
                
    table.cell(fvg_debug_table, 0, 1, "Active FVGs", text_color=color.white, text_size=size.tiny)
    table.cell(fvg_debug_table, 1, 1, str.tostring(active_cnt), text_color=color.green, text_size=size.tiny)
    
    table.cell(fvg_debug_table, 0, 2, "Partial FVGs", text_color=color.white, text_size=size.tiny)
    table.cell(fvg_debug_table, 1, 2, str.tostring(partial_cnt), text_color=color.yellow, text_size=size.tiny)
    
    table.cell(fvg_debug_table, 0, 3, "Full FVGs", text_color=color.white, text_size=size.tiny)
    table.cell(fvg_debug_table, 1, 3, str.tostring(full_cnt), text_color=color.gray, text_size=size.tiny)
    
    // Example 1 (Most recent active/partial)
    int ex_idx = -1
    if sz > 0
        for i = sz - 1 to 0
            if array.get(g_fvg_state, i) != "Full"
                ex_idx := i
                break
                
    string ex_str = "None"
    if ex_idx != -1
        string dir_str = array.get(g_fvg_dir, ex_idx) == TD_LONG ? "Bull" : "Bear"
        ex_str := array.get(g_fvg_base_id, ex_idx) + " (" + dir_str + ", " + str.tostring(array.get(g_fvg_mit_pct, ex_idx), "#.#") + "%)"
        
    table.cell(fvg_debug_table, 0, 4, "Latest Open FVG", text_color=color.white, text_size=size.tiny)
    table.cell(fvg_debug_table, 1, 4, ex_str, text_color=color.white, text_size=size.tiny)
    
    // Example 1 Metadata
    string meta_str = "None"
    if ex_idx != -1
        string mtf_str = array.get(g_fvg_mtf_bias, ex_idx) == TD_LONG ? "Bull" : array.get(g_fvg_mtf_bias, ex_idx) == TD_SHORT ? "Bear" : "Neutral"
        meta_str := mtf_str + " / " + array.get(g_fvg_pd_zone, ex_idx) + " / " + array.get(g_fvg_liq_tier, ex_idx)
        
    table.cell(fvg_debug_table, 0, 5, "Meta (MTF/PD/Liq)", text_color=color.white, text_size=size.tiny)
    table.cell(fvg_debug_table, 1, 5, meta_str, text_color=color.white, text_size=size.tiny)
    
    table.cell(fvg_debug_table, 0, 6, "Integrity", text_color=color.white, text_size=size.tiny)
    table.cell(fvg_debug_table, 1, 6, f_mtf_all_ok() ? "TRUE" : "FALSE", text_color=f_mtf_all_ok() ? color.green : color.red, text_size=size.tiny)
