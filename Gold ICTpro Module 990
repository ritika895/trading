        table.cell(event_log_table, 0, 0, "EVENT TIMELINE", text_color=color.yellow, text_size=size.tiny, text_halign=text.align_center, bgcolor=color.new(color.navy, 60))
        for i = 1 to 15
            f_table_cell_color(event_log_table, 0, i, "", color.gray)
        f_table_header(audit_table, 0, 0, "SELECTION AUDIT")
        table.merge_cells(audit_table, 0, 0, 1, 0)
        f_table_header(lifecycle_audit_table,0, 0, "LIFECYCLE AUDIT")
        table.merge_cells(lifecycle_audit_table, 0, 0, 1, 0)
        table.cell(p9_debug_table, 0, 0, "PHASE 9 DEBUG", text_color=color.yellow, text_size=size.tiny, bgcolor=color.new(color.navy, 60))
        table.merge_cells(p9_debug_table, 0, 0, 1, 0)
        table.cell(p9_inspector_table, 0, 0, "P9 REGISTRY INSPECTOR", text_color=color.yellow, text_size=size.tiny, bgcolor=color.new(color.navy, 60))
        table.merge_cells(p9_inspector_table, 0, 0, 1, 0)
        table.cell(p9_engine_summary_table, 0, 0, "PHASE 9 ENGINE", text_color=color.yellow, text_size=size.tiny, bgcolor=color.new(color.navy, 60))
        table.merge_cells(p9_engine_summary_table, 0, 0, 1, 0)
        table.cell(profile_table, 0, 0, "P9 PROFILE", text_color=color.yellow, text_size=size.tiny, bgcolor=color.new(color.navy, 60))
        table.merge_cells(profile_table, 0, 0, 2, 0)
        table.cell(validation_table, 0, 0, "PHASE 9 VALIDATION", text_color=color.yellow, text_size=size.small, text_halign=text.align_center, bgcolor=color.new(color.navy, 60))
        table.merge_cells(validation_table, 0, 0, 1, 0)

    if barstate.islast
        // ── Session / Market Status ──
        int now_hour = hour(timenow, syminfo.timezone)
        int now_min = minute(timenow, syminfo.timezone)
        int now_mins = now_hour * 60 + now_min
        int now_day = dayofweek(timenow, syminfo.timezone)
        bool is_weekend_now = false
        if now_day == 1
            if now_mins < (17 * 60)
                is_weekend_now := true
        else if now_day == 6
            if now_mins >= (17 * 60)
                is_weekend_now := true
        string display_session_name = "Off Session"
        string display_status = "CLOSED"
        string display_time_str = st.current_context.time_str
        if is_weekend_now
            string h_str2 = now_hour < 10 ? "0" + str.tostring(now_hour) : str.tostring(now_hour)
            string m_str2 = now_min < 10 ? "0" + str.tostring(now_min) : str.tostring(now_min)
            display_time_str := h_str2 + ":" + m_str2 + " (Wknd)"
        else
            if f_is_in_range(now_mins, ny_start, ny_end) and f_is_in_range(now_mins, london_start, london_end)
                display_session_name := "London/NY Overlap"
                display_status := "OPEN"
            else if f_is_in_range(now_mins, ny_start, ny_end)
                display_session_name := "New York"
                display_status := "OPEN"
            else if f_is_in_range(now_mins, london_start, london_end)
                display_session_name := "London"
                display_status := "OPEN"
            else if f_is_in_range(now_mins, asian_start, asian_end)
                display_session_name := "Asian"
                display_status := "OPEN"
            string h_str2 = now_hour < 10 ? "0" + str.tostring(now_hour) : str.tostring(now_hour)
            string m_str2 = now_min < 10 ? "0" + str.tostring(now_min) : str.tostring(now_min)
            display_time_str := h_str2 + ":" + m_str2
        f_table_cell(dash_table, 1, 7, display_session_name)
        f_table_cell_color(dash_table, 1, 8, display_status, display_status == "OPEN" ? color.green : color.red)
        f_table_cell(dash_table, 1, 9, display_time_str)

        // ── Liquidity Pool Registry Counts ──
        int bull_count = 0
        int bear_count = 0
        int active_count = 0
        int swept_count = 0
        int rein_count = 0
        int invalid_count = 0
        int expired_count = 0
        if array.size(g_registry) > 0
            for i = 0 to array.size(g_registry) - 1
                LiquidityPool pool = array.get(g_registry, i)
                if pool.poolType == LT_BUY_SIDE
                    bull_count += 1
                else
                    bear_count += 1
                if pool.state == LS_ACTIVE
                    active_count += 1
                else if pool.state == 2
                    rein_count += 1
                else if pool.state == LS_SWEPT
                    swept_count += 1
                else if pool.state == LS_INVALIDATED
                    invalid_count += 1
                else if pool.state == LS_EXPIRED
                    expired_count += 1
        f_table_cell(dash_table, 1, 15, str.tostring(bull_count))
        f_table_cell(dash_table, 1, 16, str.tostring(bear_count))
        f_table_cell(dash_table, 1, 17, str.tostring(active_count))
        f_table_cell(dash_table, 1, 18, str.tostring(swept_count))
        f_table_cell(dash_table, 1, 19, str.tostring(rein_count))
        f_table_cell(dash_table, 1, 20, str.tostring(invalid_count))
        f_table_cell(dash_table, 1, 21, str.tostring(expired_count))

        // ── Market Structure ──
        if not na(st.current_validation)
            f_table_cell_color(dash_table, 1, 10, st.current_validation.trend == TD_LONG ? "Bullish" : st.current_validation.trend == TD_SHORT ? "Bearish" : "Neutral", f_bias_color(st.current_validation.trend))
        else
            f_table_cell_color(dash_table, 1, 10, "N/A", color.gray)

        f_table_cell_color(dash_table, 1, 11, st.structure.last_bos_dir == TD_LONG ? "Bullish BOS" : st.structure.last_bos_dir == TD_SHORT ? "Bearish BOS" : "None", st.structure.last_bos_dir != 0 ? color.yellow : color.gray)
        f_table_cell_color(dash_table, 1, 12, st.structure.last_choch_dir == TD_LONG ? "Bullish CHoCH" : st.structure.last_choch_dir == TD_SHORT ? "Bearish CHoCH" : "None", st.structure.last_choch_dir != 0 ? color.orange : color.gray)
        string pd_str = "N/A"
        if not na(st.current_context.currentPrice)
            if st.current_context.currentPrice >= st.current_context.premiumZone
                pd_str := "Premium"
            else if st.current_context.currentPrice <= st.current_context.discountZone
                pd_str := "Discount"
            else
                pd_str := "Equilibrium"
        f_table_cell_color(dash_table, 1, 13, pd_str, pd_str == "Premium" ? color.red : pd_str == "Discount" ? color.green : color.gray)

        // ── Strategy & Arbitration ──
        f_table_cell_color(dash_table, 1, 23, st.current_strategy.strategyApproved ? "Approved" : "Rejected", f_bool_color(st.current_strategy.strategyApproved))
        f_table_cell(dash_table, 1, 24, st.current_strategy.direction == TD_LONG ? "LONG" : st.current_strategy.direction == TD_SHORT ? "SHORT" : "N/A")
        f_table_cell(dash_table, 1, 25, str.tostring(st.current_strategy.entryPrice, "#.##"))
        f_table_cell(dash_table, 1, 26, str.tostring(st.current_strategy.stopLoss, "#.##") + " / " + str.tostring(st.current_strategy.takeProfit, "#.##"))
        f_table_cell(dash_table, 1, 27, str.tostring(st.current_strategy.riskReward, "#.##"))
        f_table_cell(dash_table, 1, 28, str.tostring(st.current_strategy.strategyConfidence, "#.##"))

        if not na(st.current_arbitration)
            f_table_cell_color(dash_table, 1, 29, st.current_arbitration.isApproved ? "Approved" : "Rejected", f_bool_color(st.current_arbitration.isApproved))
            f_table_cell(dash_table, 1, 30, st.current_arbitration.reason)
        else
            f_table_cell_color(dash_table, 1, 29, "N/A", color.gray)
            f_table_cell_color(dash_table, 1, 30, "Not evaluated", color.gray)

        // ── Recommendation ──
        string rec_status_str = "No Active Rec"
        string rec_dir_str = "N/A"
        string rec_entry_str = "N/A"
        string rec_sltp_str = "N/A"
        string rec_rr_str = "N/A"
        if not na(st.active_rec)
            string status_name = "Active"
            if st.active_rec.status == 2
                status_name := "Invalidated"
            else if st.active_rec.status == 3
                status_name := "Fulfilled"
            else if st.active_rec.status == 4
                status_name := "Expired"
            rec_status_str := "Rec #" + str.tostring(st.active_rec.id) + " (" + status_name + ")"
            rec_dir_str := st.active_rec.candidate.direction == TD_LONG ? "LONG" : "SHORT"
            rec_entry_str := str.tostring(st.active_rec.actualEntry, "#.##")
            rec_sltp_str := str.tostring(st.active_rec.actualStop, "#.##") + " / " + str.tostring(st.active_rec.candidate.takeProfit, "#.##")
            if st.active_rec.actualEntry != st.active_rec.actualStop
                if st.active_rec.candidate.direction == TD_LONG
                    rec_rr_str := str.tostring((st.active_rec.candidate.takeProfit - st.active_rec.actualEntry) / (st.active_rec.actualEntry - st.active_rec.actualStop), "#.##")
                else
                    rec_rr_str := str.tostring((st.active_rec.actualEntry - st.active_rec.candidate.takeProfit) / (st.active_rec.actualStop - st.active_rec.actualEntry), "#.##")
        else
            rec_status_str := "No Active Rec (" + st.diag.m10_reject_reason + ")"
        f_table_cell_color(dash_table, 1, 32, rec_status_str, not na(st.active_rec) and st.active_rec.status == RS_ACTIVE ? color.green : color.gray)
        f_table_cell(dash_table, 1, 33, rec_dir_str)
        f_table_cell(dash_table, 1, 34, rec_entry_str)
        f_table_cell(dash_table, 1, 35, rec_sltp_str)
        f_table_cell(dash_table, 1, 36, rec_rr_str)

        // ── Pipeline Status ──
        string pool_icon  = f_bool_icon(str.contains(st.current_trace.pool_str, "PASS"))
        string sweep_icon = f_trace_icon_3way(st.current_trace.sweep_str)
        string trend_icon = f_trace_icon_3way(st.current_trace.trend_str)
        string strat_icon = f_trace_icon_3way(st.current_trace.strategy_str)
        string arb_icon   = f_trace_icon_3way(st.current_trace.arb_str)
        string final_icon = f_bool_icon(st.current_trace.final_str == "PASS")

        color pool_color  = f_bool_color(str.contains(st.current_trace.pool_str, "PASS"))
        color sweep_color = f_trace_color_3way(st.current_trace.sweep_str)
        color trend_color = f_trace_color_3way(st.current_trace.trend_str)
        color strat_color = f_trace_color_3way(st.current_trace.strategy_str)
        color arb_color   = f_trace_color_3way(st.current_trace.arb_str)
        color final_color = f_bool_color(st.current_trace.final_str == "PASS")

        f_table_cell_color(dash_table, 0, 38, pool_icon + " Selection", pool_color)
        f_table_cell_color(dash_table, 1, 38, st.current_trace.pool_str, pool_color)
        f_table_cell_color(dash_table, 0, 39, sweep_icon + " Sweep", sweep_color)
        f_table_cell_color(dash_table, 1, 39, st.current_trace.sweep_str, sweep_color)
        f_table_cell_color(dash_table, 0, 40, trend_icon + " Trend", trend_color)
        f_table_cell_color(dash_table, 1, 40, st.current_trace.trend_str, trend_color)
        f_table_cell_color(dash_table, 0, 41, strat_icon + " Strategy", strat_color)
        f_table_cell_color(dash_table, 1, 41, st.current_trace.strategy_str, strat_color)
        f_table_cell_color(dash_table, 0, 42, arb_icon + " Arbitration", arb_color)
        f_table_cell_color(dash_table, 1, 42, st.current_trace.arb_str, arb_color)
        f_table_cell_color(dash_table, 0, 43, final_icon + " Final Result", final_color)
        f_table_cell_color(dash_table, 1, 43, st.current_trace.reason_str, final_color)

        // ── Module 8 — POI ──
        f_table_cell_color(dash_table, 1, 44, str.tostring(st.diag.poi_highest_score) + "pts", color.yellow)
        f_table_cell(dash_table, 1, 45, f_last_or_na(g_poi_base_id))
        f_table_cell_color(dash_table, 1, 46, st.diag.poi_latest_grade, f_grade_color(st.diag.poi_latest_grade))
        f_table_cell(dash_table, 1, 47, st.diag.poi_latest_dir == TD_LONG ? "LONG" : st.diag.poi_latest_dir == TD_SHORT ? "SHORT" : "N/A")
        int m3_bias_val = st.mtf.bias_3
        f_table_cell(dash_table, 1, 48, f_bias_label(m3_bias_val))
        f_table_cell(dash_table, 1, 49, st.counters.pd_zone)
        f_table_cell(dash_table, 1, 50, f_last_or_na(g_fvg_base_id))
        f_table_cell(dash_table, 1, 51, f_last_or_na(g_ob_base_id))
        f_table_cell(dash_table, 1, 52, f_last_or_na(g_mss_base_id))
        f_table_cell(dash_table, 1, 53, f_last_or_na(g_brk_base_id))

        // ── Module 9 — Trade Candidates ──
        // Row budget note: rows 61-62 are already claimed by the pre-existing
        // Module 10 diagnostic cells below (m10_latest_action/rating), so M9's
        // reserved block (header row 57) is rendered across rows 58-60 only.
        int m9_qual_count = 0
        int m9_conf_count = 0
        int m9_ready_count = 0
        int m9_trig_count = 0
        int m9_inv_count = 0
        int m9_exp_count = 0
        if array.size(g_m9_registry) > 0
            for i = 0 to array.size(g_m9_registry) - 1
                TradeCandidate mc = array.get(g_m9_registry, i)
                if mc.status == M9_QUALIFIED
                    m9_qual_count += 1
                else if mc.status == M9_CONFIRMED
                    m9_conf_count += 1
                else if mc.status == M9_READY
                    m9_ready_count += 1
                else if mc.status == M9_TRIGGERED
                    m9_trig_count += 1
                else if mc.status == M9_INVALIDATED
                    m9_inv_count += 1
                else if mc.status == M9_EXPIRED
                    m9_exp_count += 1
        f_table_cell_color(dash_table, 1, 58, str.tostring(array.size(g_m9_registry)) + " active / " + str.tostring(g_m9_rt.total_emitted) + " total", color.yellow)
        f_table_cell(dash_table, 1, 59, "Q:" + str.tostring(m9_qual_count) + " C:" + str.tostring(m9_conf_count) + " R:" + str.tostring(m9_ready_count))
