    if sz > 0
        int start_idx = math.max(0, sz - 20)
        for i = sz - 1 to start_idx
            OBInstance ob = array.get(g_ob_registry, i)
            if ob.status == "Invalidated" and ob.createdAt == bar_idx and ob.direction != mss_dir
                is_cand := true
                break
    is_cand

