string sigov_sltp_str  = sigov_action_live and not na(S.diag.m10_latest_sl)   and not na(S.diag.m10_latest_tp) ? str.tostring(S.diag.m10_latest_sl, "#.##") + " / " + str.tostring(S.diag.m10_latest_tp, "#.##") : "N/A"
string sigov_rr_str    = sigov_action_live ? str.tostring(S.diag.m10_latest_rr,   "#.##") : "N/A"
string sigov_conf_str  = sigov_action_live ? str.tostring(S.diag.m10_latest_score)         : "N/A"

// --- Reuse existing pure helpers — no reimplementation of lifecycle rules ---
string sigov_status = f_m11_1_status_from_exit(not sigov_has_rec, sigov_exit_reason)

// --- Compact decision panel (read-only render) ------------------------------
if sigov_enable and sigov_show_panel and barstate.islast
    table.cell(sigov_table, 0, 0, "SIGNAL OVERLAY", text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.navy, 60))
    table.merge_cells(sigov_table, 0, 0, 1, 0)

    f_table_cell(sigov_table, 0, 1, "Signal")
    f_table_cell_color(sigov_table, 1, 1, sigov_action, f_m11_1_action_color(sigov_action))

    f_table_cell(sigov_table, 0, 2, "Status")
    f_table_cell_color(sigov_table, 1, 2, sigov_status, f_m11_1_status_color(sigov_status))

    f_table_cell(sigov_table, 0, 3, "Entry")
    f_table_cell(sigov_table, 1, 3, sigov_entry_str)

    f_table_cell(sigov_table, 0, 4, "SL / TP")
    f_table_cell(sigov_table, 1, 4, sigov_sltp_str)

    f_table_cell(sigov_table, 0, 5, "RR")
    f_table_cell(sigov_table, 1, 5, sigov_rr_str)

    f_table_cell(sigov_table, 0, 6, "Confidence")
    f_table_cell(sigov_table, 1, 6, sigov_conf_str)

    // --- Diagnostic-only rows (read-only signal-age instrumentation) --------
    f_table_cell(sigov_table, 0, 7, "Created At")
    f_table_cell(sigov_table, 1, 7, na(sigov_created_at) ? "N/A" : str.tostring(sigov_created_at))

    f_table_cell(sigov_table, 0, 8, "Current Bar")
    f_table_cell(sigov_table, 1, 8, str.tostring(bar_index))

    bool sigov_created_this_bar = sigov_created_at == bar_index
    f_table_cell(sigov_table, 0, 9, "Created This Bar?")
    f_table_cell_color(sigov_table, 1, 9, sigov_created_this_bar ? "TRUE" : "FALSE", sigov_created_this_bar ? color.green : color.gray)

    string sigov_reg_dir_str = sigov_has_rec ? f_bias_label(sigov_direction) : "N/A"
    f_table_cell(sigov_table, 0, 10, "Registry Direction")
    f_table_cell_color(sigov_table, 1, 10, sigov_reg_dir_str, f_bias_color(sigov_direction))

// --- Chart markers (default OFF, only on the creating bar) ------------------
bool sigov_new_buy  = sigov_enable and sigov_show_marker and sigov_has_rec and sigov_created_at == bar_index and sigov_direction == TD_LONG
bool sigov_new_sell = sigov_enable and sigov_show_marker and sigov_has_rec and sigov_created_at == bar_index and sigov_direction == TD_SHORT

plotshape(sigov_new_buy,  title="Signal BUY",  style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.small, text="BUY")
plotshape(sigov_new_sell, title="Signal SELL", style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.small, text="SELL")

// ============================================================================ 
// INSTRUMENTATION FIELDS (PIECE 2) & PANEL (SECTION C)
// ============================================================================ 
f_instr_fold_bar() =>
    INSTR.barsProcessed += 1
    int barTotal = INSTR.cur_m6PoolLoopIter + INSTR.cur_fvgLoopIter + INSTR.cur_obLoopIter + INSTR.cur_m8ScanNewFvg + INSTR.cur_m8ScanNewOb + INSTR.cur_m8FvgIdxScan + INSTR.cur_m8ObIdxScan + INSTR.cur_m8PoiLoopIter + INSTR.cur_m8PoiEvaluated + INSTR.cur_m9s1LoopIter + INSTR.cur_m9lcLoopIter + INSTR.cur_m9lcPoiIdxScan + INSTR.cur_m10s04LoopIter + INSTR.cur_m10PoiIdxScan + INSTR.cur_m10s5LoopIter
    if barTotal > 0
        INSTR.barsWithWork += 1

    INSTR.tot_m6PoolLoopIter += INSTR.cur_m6PoolLoopIter
    INSTR.max_m6PoolLoopIter := math.max(INSTR.max_m6PoolLoopIter, INSTR.cur_m6PoolLoopIter)
    INSTR.tot_fvgLoopIter += INSTR.cur_fvgLoopIter
    INSTR.max_fvgLoopIter := math.max(INSTR.max_fvgLoopIter, INSTR.cur_fvgLoopIter)
    INSTR.tot_obLoopIter += INSTR.cur_obLoopIter
    INSTR.max_obLoopIter := math.max(INSTR.max_obLoopIter, INSTR.cur_obLoopIter)
    INSTR.tot_m8ScanNewFvg += INSTR.cur_m8ScanNewFvg
    INSTR.max_m8ScanNewFvg := math.max(INSTR.max_m8ScanNewFvg, INSTR.cur_m8ScanNewFvg)
    INSTR.tot_m8ScanNewOb += INSTR.cur_m8ScanNewOb
    INSTR.max_m8ScanNewOb := math.max(INSTR.max_m8ScanNewOb, INSTR.cur_m8ScanNewOb)
    INSTR.tot_m8FvgIdxScan += INSTR.cur_m8FvgIdxScan
    INSTR.max_m8FvgIdxScan := math.max(INSTR.max_m8FvgIdxScan, INSTR.cur_m8FvgIdxScan)
    INSTR.tot_m8ObIdxScan += INSTR.cur_m8ObIdxScan
    INSTR.max_m8ObIdxScan := math.max(INSTR.max_m8ObIdxScan, INSTR.cur_m8ObIdxScan)
    INSTR.tot_m8PoiLoopIter += INSTR.cur_m8PoiLoopIter
    INSTR.max_m8PoiLoopIter := math.max(INSTR.max_m8PoiLoopIter, INSTR.cur_m8PoiLoopIter)
    INSTR.tot_m8PoiEvaluated += INSTR.cur_m8PoiEvaluated
    INSTR.max_m8PoiEvaluated := math.max(INSTR.max_m8PoiEvaluated, INSTR.cur_m8PoiEvaluated)
    INSTR.tot_m9s1LoopIter += INSTR.cur_m9s1LoopIter
    INSTR.max_m9s1LoopIter := math.max(INSTR.max_m9s1LoopIter, INSTR.cur_m9s1LoopIter)
    INSTR.tot_m9s1DedupScan += INSTR.cur_m9s1DedupScan
    INSTR.max_m9s1DedupScan := math.max(INSTR.max_m9s1DedupScan, INSTR.cur_m9s1DedupScan)
    INSTR.tot_m9lcLoopIter += INSTR.cur_m9lcLoopIter
    INSTR.max_m9lcLoopIter := math.max(INSTR.max_m9lcLoopIter, INSTR.cur_m9lcLoopIter)
    INSTR.tot_m9lcPoiIdxScan += INSTR.cur_m9lcPoiIdxScan
    INSTR.max_m9lcPoiIdxScan := math.max(INSTR.max_m9lcPoiIdxScan, INSTR.cur_m9lcPoiIdxScan)
    INSTR.tot_m10s04LoopIter += INSTR.cur_m10s04LoopIter
    INSTR.max_m10s04LoopIter := math.max(INSTR.max_m10s04LoopIter, INSTR.cur_m10s04LoopIter)
    INSTR.tot_m10DedupScan += INSTR.cur_m10DedupScan
    INSTR.max_m10DedupScan := math.max(INSTR.max_m10DedupScan, INSTR.cur_m10DedupScan)
    INSTR.tot_m10PoiIdxScan += INSTR.cur_m10PoiIdxScan
    INSTR.max_m10PoiIdxScan := math.max(INSTR.max_m10PoiIdxScan, INSTR.cur_m10PoiIdxScan)
    INSTR.tot_m10s5LoopIter += INSTR.cur_m10s5LoopIter
    INSTR.max_m10s5LoopIter := math.max(INSTR.max_m10s5LoopIter, INSTR.cur_m10s5LoopIter)

    INSTR.max_regSizeFvg := math.max(INSTR.max_regSizeFvg, array.size(g_fvg_registry))
    INSTR.max_regSizeOb := math.max(INSTR.max_regSizeOb, array.size(g_ob_registry))
    INSTR.max_regSizePoi := math.max(INSTR.max_regSizePoi, array.size(g_poi_registry))
    INSTR.max_regSizeM9 := math.max(INSTR.max_regSizeM9, array.size(g_m9_registry))
    INSTR.max_regSizePool := math.max(INSTR.max_regSizePool, array.size(g_registry))
    true

GRP_INSTR = "Instrumentation"
bool show_instr_panel = input.bool(false, "Show Instrumentation Panel", group=GRP_INSTR)

var table instr_table = table.new(position.middle_center, 2, 30, bgcolor=color.new(color.black, 10), border_width=1, border_color=color.new(color.gray, 60))

f_instr_render() =>
    if show_instr_panel and barstate.islast
        // Aggregated instrumented operations = distinct-anchor loop/scan counters only.
        // Excludes tot_m8PoiEvaluated (subset of tot_m8PoiLoopIter — would double-count),
        // excludes both dedup call counters, and excludes all max_regSize* fields.
        // This is NOT a CPU-time or complexity measurement.
        int grandTotal = INSTR.tot_m6PoolLoopIter + INSTR.tot_fvgLoopIter + INSTR.tot_obLoopIter + INSTR.tot_m8ScanNewFvg + INSTR.tot_m8ScanNewOb + INSTR.tot_m8FvgIdxScan + INSTR.tot_m8ObIdxScan + INSTR.tot_m8PoiLoopIter + INSTR.tot_m9s1LoopIter + INSTR.tot_m9lcLoopIter + INSTR.tot_m9lcPoiIdxScan + INSTR.tot_m10s04LoopIter + INSTR.tot_m10PoiIdxScan + INSTR.tot_m10s5LoopIter

        float avgPerBar = INSTR.barsProcessed > 0 ? grandTotal / INSTR.barsProcessed : 0.0

        table.cell(instr_table, 0, 0, "INSTRUMENTATION (workload baseline)", text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.navy, 60))
        table.merge_cells(instr_table, 0, 0, 1, 0)

        f_table_header(instr_table, 0, 1, "WORKLOAD")
        table.merge_cells(instr_table, 0, 1, 1, 1)
        f_table_cell(instr_table, 0, 2, "Bars processed / with work")
        f_table_cell(instr_table, 1, 2, str.tostring(INSTR.barsProcessed) + " / " + str.tostring(INSTR.barsWithWork))
        f_table_cell(instr_table, 0, 3, "Avg aggregated ops / bar")
        f_table_cell(instr_table, 1, 3, str.tostring(avgPerBar, "#.##"))
        f_table_cell(instr_table, 0, 4, "Aggregated instrumented operations")
        f_table_cell_color(instr_table, 1, 4, str.tostring(grandTotal), color.aqua)

        f_table_header(instr_table, 0, 5, "M6")
        table.merge_cells(instr_table, 0, 5, 1, 5)
        f_table_cell(instr_table, 0, 6, "Pool loop tot/max")
        f_table_cell(instr_table, 1, 6, str.tostring(INSTR.tot_m6PoolLoopIter) + " / " + str.tostring(INSTR.max_m6PoolLoopIter))

        f_table_header(instr_table, 0, 7, "M7")
        table.merge_cells(instr_table, 0, 7, 1, 7)
        f_table_cell(instr_table, 0, 8, "FVG loop tot/max")
        f_table_cell(instr_table, 1, 8, str.tostring(INSTR.tot_fvgLoopIter) + " / " + str.tostring(INSTR.max_fvgLoopIter))
        f_table_cell(instr_table, 0, 9, "OB loop tot/max")
        f_table_cell(instr_table, 1, 9, str.tostring(INSTR.tot_obLoopIter) + " / " + str.tostring(INSTR.max_obLoopIter))

        f_table_header(instr_table, 0, 10, "M8")
        table.merge_cells(instr_table, 0, 10, 1, 10)
        f_table_cell(instr_table, 0, 11, "New FVG scan tot/max")
        f_table_cell(instr_table, 1, 11, str.tostring(INSTR.tot_m8ScanNewFvg) + " / " + str.tostring(INSTR.max_m8ScanNewFvg))
        f_table_cell(instr_table, 0, 12, "New OB scan tot/max")
        f_table_cell(instr_table, 1, 12, str.tostring(INSTR.tot_m8ScanNewOb) + " / " + str.tostring(INSTR.max_m8ScanNewOb))
        f_table_cell(instr_table, 0, 13, "FVG idx-map scan tot/max")
        f_table_cell(instr_table, 1, 13, str.tostring(INSTR.tot_m8FvgIdxScan) + " / " + str.tostring(INSTR.max_m8FvgIdxScan))
        f_table_cell(instr_table, 0, 14, "OB idx-map scan tot/max")
        f_table_cell(instr_table, 1, 14, str.tostring(INSTR.tot_m8ObIdxScan) + " / " + str.tostring(INSTR.max_m8ObIdxScan))
        f_table_cell(instr_table, 0, 15, "POI loop tot/max")
        f_table_cell(instr_table, 1, 15, str.tostring(INSTR.tot_m8PoiLoopIter) + " / " + str.tostring(INSTR.max_m8PoiLoopIter))
        f_table_cell_color(instr_table, 0, 16, "POI evaluated tot/max (excl. from total)", color.gray)
        f_table_cell_color(instr_table, 1, 16, str.tostring(INSTR.tot_m8PoiEvaluated) + " / " + str.tostring(INSTR.max_m8PoiEvaluated), color.gray)

        f_table_header(instr_table, 0, 17, "M9")
        table.merge_cells(instr_table, 0, 17, 1, 17)
        f_table_cell(instr_table, 0, 18, "Stage-1 loop tot/max")
        f_table_cell(instr_table, 1, 18, str.tostring(INSTR.tot_m9s1LoopIter) + " / " + str.tostring(INSTR.max_m9s1LoopIter))
        f_table_cell_color(instr_table, 0, 19, "Stage-1 dedup CALLS tot/max", color.orange)
        f_table_cell_color(instr_table, 1, 19, str.tostring(INSTR.tot_m9s1DedupScan) + " / " + str.tostring(INSTR.max_m9s1DedupScan), color.orange)
        f_table_cell(instr_table, 0, 20, "Lifecycle loop tot/max")
        f_table_cell(instr_table, 1, 20, str.tostring(INSTR.tot_m9lcLoopIter) + " / " + str.tostring(INSTR.max_m9lcLoopIter))
