var array<int>    g_mtf_choch   = array.new<int>(3, 0)
var array<float>  g_mtf_last_hi = array.new<float>(3, na)
var array<float>  g_mtf_last_lo = array.new<float>(3, na)
var array<int>    g_mtf_last_t  = array.new<int>(3, 0)
