    int newId = f_allocate_mss_id()
    string baseId = "MSS-" + str.tostring(newId)
    
    array.push(g_mss_base_id, baseId)
    array.push(g_mss_ver, 1)
    array.push(g_mss_dir, dir)
    array.push(g_mss_state, "Active")
