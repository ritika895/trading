                MSSInstance inst = MSSInstance.new(baseId, instId, "", "MSS", "MSSEngine", bar_index, "Active", p9_mss_integ, "MSSContract-1.0", TD_SHORT, bar_index, trig_px, trig_rg, disp_str, "", brk_cand)
                array.push(g_mss_registry, inst)
                S.mss_total_emitted += 1
                int newEvtId = S.p9_next_evt_id
                S.p9_next_evt_id += 1
                array.push(g_p9_event_log, P9Event.new(newEvtId, "MSSEngine", "MSS_EMIT", instId, time, p9_mss_integ))
                if array.size(g_mss_registry) > 200
                    array.shift(g_mss_registry)
        else
            if na(S.mss_diag_bar)
                S.mss_diag_reason := "No CHoCH detected"
            else
                S.mss_diag_reason := "Waiting for next CHoCH... (Last CHoCH eval bar: " + str.tostring(S.mss_diag_bar) + ")"
                
        if array.size(g_mss_base_id) > 0
            for i = 0 to array.size(g_mss_base_id) - 1
                string state = array.get(g_mss_state, i)
                if state == "Active"
                    int dir = array.get(g_mss_dir, i)
                    float trig_px = array.get(g_mss_trigger_px, i)
                    string new_state = state
                    if dir == TD_LONG
                        if close < trig_px
                            new_state := "Invalidated"
                    else if dir == TD_SHORT
                        if close > trig_px
                            new_state := "Invalidated"
                    if new_state != state
                        string baseId = array.get(g_mss_base_id, i)
                        int currentVer = array.get(g_mss_ver, i)
                        int newVer = currentVer + 1
                        string prevId = baseId + "-v" + str.tostring(currentVer)
                        string instId = baseId + "-v" + str.tostring(newVer)
                        array.set(g_mss_ver, i, newVer)
                        array.set(g_mss_state, i, new_state)
                        MSSInstance inst = MSSInstance.new(baseId, instId, prevId, "MSS", "MSSEngine", bar_index, new_state, p9_mss_integ, "MSSContract-1.0", dir, array.get(g_mss_trigger_bar, i), array.get(g_mss_trigger_px, i), array.get(g_mss_trigger_rg, i), array.get(g_mss_disp_str, i), "", array.get(g_mss_breaker, i))
                        array.push(g_mss_registry, inst)
                        S.mss_total_emitted += 1
                        int newEvtId = S.p9_next_evt_id
                        S.p9_next_evt_id += 1
                        array.push(g_p9_event_log, P9Event.new(newEvtId, "MSSEngine", "MSS_EMIT", instId, time, p9_mss_integ))
                        if array.size(g_mss_registry) > 200
                            array.shift(g_mss_registry)

        if array.size(g_mss_base_id) > 0
            for i = array.size(g_mss_base_id) - 1 to 0
                if array.get(g_mss_state, i) == "Invalidated"
                    array.remove(g_mss_base_id, i)
                    array.remove(g_mss_ver, i)
                    array.remove(g_mss_dir, i)
                    array.remove(g_mss_state, i)
                    array.remove(g_mss_trigger_px, i)
                    array.remove(g_mss_trigger_bar, i)
                    array.remove(g_mss_trigger_rg, i)
                    array.remove(g_mss_disp_str, i)
                    array.remove(g_mss_breaker, i)

    bool p9_brk_integ = _p8_integ and (S.mtf_integ_1 and S.mtf_integ_2 and S.mtf_integ_3)
    if p9_brk_integ and barstate.isconfirmed
        S.brk_diag_bar := bar_index
        S.brk_last_eval_bar := bar_index
        S.brk_diag_ob_inv := false
        S.brk_diag_mss_found := false
        S.brk_stat_evals += 1
        
        if array.size(g_ob_base_id) > 0
            for i = 0 to array.size(g_ob_base_id) - 1
                string ob_state = array.get(g_ob_state, i)
                string ob_base = array.get(g_ob_base_id, i)
                int ob_ver = array.get(g_ob_ver, i)
                string ob_inst = ob_base + "-v" + str.tostring(ob_ver)
                bool just_inv = false
                if array.size(g_ob_registry) > 0
                    int start_idx = math.max(0, array.size(g_ob_registry) - 20)
                    for j = array.size(g_ob_registry) - 1 to start_idx
                        OBInstance last_ob = array.get(g_ob_registry, j)
                        if last_ob.instanceId == ob_inst and last_ob.status == "Invalidated" and last_ob.createdAt == bar_index
                            just_inv := true
                            break
                if just_inv
                    S.brk_diag_ob_inv := true
                    int ob_dir = array.get(g_ob_dir, i)
                    float ob_h = array.get(g_ob_high, i)
                    float ob_l = array.get(g_ob_low, i)
                    int brk_dir = ob_dir == TD_LONG ? TD_SHORT : TD_LONG
                    
                    string src_mss_base = ""
                    string src_mss_inst = ""
                    int mss_dir = -1
                    if array.size(g_mss_registry) > 0
                        for j = array.size(g_mss_registry) - 1 to 0
                            MSSInstance m = array.get(g_mss_registry, j)
                            if m.triggerBarIndex == bar_index
                                src_mss_base := m.baseId
                                src_mss_inst := m.instanceId
                                mss_dir := m.direction
                                break
                    
                    if src_mss_base == ""
                        S.brk_diag_mss_found := false
                        S.brk_diag_reason := "Rejected: No MSS on invalidation bar"
                        S.brk_stat_rej_no_mss += 1
                    else if mss_dir != brk_dir
                        S.brk_diag_reason := "Rejected: MSS direction mismatch"
                        S.brk_stat_rej_direction += 1
                    else
                        S.brk_diag_mss_found := true
                        string mss_type_str = mss_dir == TD_LONG ? "Bullish MSS" : "Bearish MSS"
                        string conf_reason = "OB invalidated + " + mss_type_str
                        S.brk_diag_reason := "Created BRK-" + str.tostring(S.next_brk_id) + "-v1 | " + conf_reason
                        S.brk_stat_created += 1
                        
                        int newId = S.next_brk_id
                        S.next_brk_id += 1
                        string baseId = "BRK-" + str.tostring(newId)
                        array.push(g_brk_base_id, baseId)
                        array.push(g_brk_ver, 1)
                        array.push(g_brk_dir, brk_dir)
                        array.push(g_brk_high, ob_h)
                        array.push(g_brk_low, ob_l)
                        array.push(g_brk_state, "Active")
                        array.push(g_brk_mit_pct, 0.0)
                        array.push(g_brk_src_ob_base, ob_base)
                        array.push(g_brk_src_ob_inst, ob_inst)
                        array.push(g_brk_src_mss_base, src_mss_base)
                        array.push(g_brk_src_mss_inst, src_mss_inst)
                        array.push(g_brk_orig_time, time)
                        array.push(g_brk_orig_bias, S.mtf_bias_3)
                        array.push(g_brk_orig_pd, S.pd_zone)
                        array.push(g_brk_orig_liq, "None")
                        array.push(g_brk_conf_reason, conf_reason)
                        string instId = baseId + "-v1"
                        BreakerBlockInstance inst = BreakerBlockInstance.new(baseId, instId, "", "BreakerBlock", "BreakerBlockEngine", bar_index, "Active", p9_brk_integ, "BreakerBlockContract-1.0", brk_dir, ob_h, ob_l, 0.0, ob_base, ob_inst, src_mss_base, src_mss_inst, time, S.mtf_bias_3, S.pd_zone, "None", conf_reason)
                        array.push(g_brk_registry, inst)
                        S.brk_total_emitted += 1
                        int newEvtId = S.p9_next_evt_id
                        S.p9_next_evt_id += 1
                        array.push(g_p9_event_log, P9Event.new(newEvtId, "BreakerBlockEngine", "BRK_EMIT", instId, time, p9_brk_integ))
                        if array.size(g_brk_registry) > 200
                            array.shift(g_brk_registry)

        if not S.brk_diag_ob_inv
            S.brk_diag_reason := "Waiting for OB Invalidation"
            S.brk_stat_waiting += 1
                
        if array.size(g_brk_base_id) > 0
            for i = 0 to array.size(g_brk_base_id) - 1
                string state = array.get(g_brk_state, i)
                if state != "Invalidated"
                    int dir = array.get(g_brk_dir, i)
                    float brk_h = array.get(g_brk_high, i)
                    float brk_l = array.get(g_brk_low, i)
                    if (dir == TD_LONG and low < brk_h + S.current_context.atr) or (dir == TD_SHORT and high > brk_l - S.current_context.atr)
                        float cur_mit = array.get(g_brk_mit_pct, i)
                        float new_mit = cur_mit
                        string new_state = state
                        if dir == TD_LONG
                            if close < brk_l
                                new_state := "Invalidated"
                            else
                                if low <= brk_l
                                    new_mit := 100.0
                                else if low < brk_h
                                    float brk_size = brk_h - brk_l
                                    new_mit := brk_size == 0 ? 0.0 : (brk_h - low) / brk_size * 100.0
                                if new_mit > 0
                                    new_state := new_mit == 100.0 ? "Fully Mitigated" : "Mitigated"
                        else if dir == TD_SHORT
                            if close > brk_h
                                new_state := "Invalidated"
                            else
                                if high >= brk_h
                                    new_mit := 100.0
                                else if high > brk_l
                                    float brk_size = brk_h - brk_l
                                    new_mit := brk_size == 0 ? 0.0 : (high - brk_l) / brk_size * 100.0
                                if new_mit > 0
                                    new_state := new_mit == 100.0 ? "Fully Mitigated" : "Mitigated"
                        if new_mit != cur_mit or new_state != state
                            string baseId = array.get(g_brk_base_id, i)
                            int currentVer = array.get(g_brk_ver, i)
                            int newVer = currentVer + 1
                            string prevId = baseId + "-v" + str.tostring(currentVer)
                            string instId = baseId + "-v" + str.tostring(newVer)
                            array.set(g_brk_ver, i, newVer)
                            array.set(g_brk_state, i, new_state)
                            array.set(g_brk_mit_pct, i, new_mit)
                            BreakerBlockInstance inst = BreakerBlockInstance.new(baseId, instId, prevId, "BreakerBlock", "BreakerBlockEngine", bar_index, new_state, p9_brk_integ, "BreakerBlockContract-1.0", dir, brk_h, brk_l, new_mit, array.get(g_brk_src_ob_base, i), array.get(g_brk_src_ob_inst, i), array.get(g_brk_src_mss_base, i), array.get(g_brk_src_mss_inst, i), array.get(g_brk_orig_time, i), array.get(g_brk_orig_bias, i), array.get(g_brk_orig_pd, i), array.get(g_brk_orig_liq, i), array.get(g_brk_conf_reason, i))
                            array.push(g_brk_registry, inst)
                            S.brk_total_emitted += 1
                            int newEvtId = S.p9_next_evt_id
                            S.p9_next_evt_id += 1
                            array.push(g_p9_event_log, P9Event.new(newEvtId, "BreakerBlockEngine", "BRK_EMIT", instId, time, p9_brk_integ))
                            if array.size(g_brk_registry) > 200
                                array.shift(g_brk_registry)

        if array.size(g_brk_base_id) > 0
            for i = array.size(g_brk_base_id) - 1 to 0
                if array.get(g_brk_state, i) == "Invalidated"
                    array.remove(g_brk_base_id, i)
                    array.remove(g_brk_ver, i)
                    array.remove(g_brk_dir, i)
                    array.remove(g_brk_high, i)
                    array.remove(g_brk_low, i)
                    array.remove(g_brk_state, i)
                    array.remove(g_brk_mit_pct, i)
                    array.remove(g_brk_src_ob_base, i)
                    array.remove(g_brk_src_ob_inst, i)
                    array.remove(g_brk_src_mss_base, i)
                    array.remove(g_brk_src_mss_inst, i)
                    array.remove(g_brk_orig_time, i)
                    array.remove(g_brk_orig_bias, i)
                    array.remove(g_brk_orig_pd, i)
                    array.remove(g_brk_orig_liq, i)
                    array.remove(g_brk_conf_reason, i)
    else
        if barstate.isconfirmed
            S.brk_diag_reason := "Rejected: Integrity failed"
            S.brk_stat_rej_integrity += 1
            S.brk_last_eval_bar := bar_index
    S

