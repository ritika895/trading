type LiquidityHierarchyInstance
    string baseId
    string instanceId
    string supersedes
    string ctype
    string sourceModule
    int    createdAt
    string status
    bool   integrity
    string contractVersion
    int    poolId
    string tier                // "Major" | "Intermediate" | "Minor"
    string originTimeframe     // syminfo.tickerid chart TF
    float  price
    bool   swept
    float  institutionalScore  // 0-100

var array<LiquidityHierarchyInstance> g_liq_registry = array.new<LiquidityHierarchyInstance>()

var array<int>    g_liq_pool_id = array.new<int>()
var array<string> g_liq_tier    = array.new<string>()
var array<bool>   g_liq_swept   = array.new<bool>()
var array<int>    g_liq_ver     = array.new<int>()
var array<bool>   g_liq_integ   = array.new<bool>()
var array<float>  g_liq_score   = array.new<float>() // added for debug visibility

f_liq_find(int poolId) =>
    int idx = -1
    int sz = array.size(g_liq_pool_id)
    if sz > 0
        for i = 0 to sz - 1
            if array.get(g_liq_pool_id, i) == poolId
                idx := i
                break
    idx

f_liq_emit(int poolId, string tier, float price, bool swept, bool integ, float inst_score) =>
    string baseId = "LIQ-" + str.tostring(poolId)
    int idx = f_liq_find(poolId)

    bool   changed = false
    string prevId  = ""
    int    newVer  = 1

    if idx == -1
        changed := true
        array.push(g_liq_pool_id, poolId)
        array.push(g_liq_tier, tier)
        array.push(g_liq_swept, swept)
        array.push(g_liq_ver, 1)
        array.push(g_liq_integ, integ)
        array.push(g_liq_score, inst_score)
    else
        string ct = array.get(g_liq_tier, idx)
        bool cs = array.get(g_liq_swept, idx)
        bool ci = array.get(g_liq_integ, idx)

        if ct != tier or cs != swept or ci != integ
            changed := true
            prevId  := baseId + "-v" + str.tostring(array.get(g_liq_ver, idx))
            newVer  := array.get(g_liq_ver, idx) + 1

            array.set(g_liq_tier, idx, tier)
            array.set(g_liq_swept, idx, swept)
            array.set(g_liq_ver, idx, newVer)
            array.set(g_liq_integ, idx, integ)
            array.set(g_liq_score, idx, inst_score)

    LiquidityHierarchyInstance inst = na
    if changed
        string instId = baseId + "-v" + str.tostring(newVer)
        inst := LiquidityHierarchyInstance.new(
             baseId, instId, prevId,
             "LiquidityHierarchy", P9_LIQ_MODULE,
             bar_index, "Active", integ,
             P9_LIQ_CVER,
             poolId, tier, timeframe.period, price, swept, inst_score)
        array.push(g_liq_registry, inst)

        string ref = instId + (prevId == "" ? "" : "|supersedes:" + prevId)
        f_p9_log(P9_LIQ_MODULE, "LIQ_EMIT", ref, integ)

    inst

f_liq_prune() =>
    int sz = array.size(g_liq_registry)
    if sz > P9_LIQ_RETAIN
        int rm = sz - P9_LIQ_RETAIN
        for i = 0 to rm - 1
            array.shift(g_liq_registry)

f_compute_liquidity_hierarchy() =>
    int t0 = timenow
    array<LiquidityHierarchyInstance> emitted = array.new<LiquidityHierarchyInstance>()

    if array.size(g_registry) > 0
        for i = 0 to array.size(g_registry) - 1
            LiquidityPool p = array.get(g_registry, i)
            
            if p.state == LS_ACTIVE or p.state == LS_REINFORCED or p.state == LS_SWEPT
                int age = bar_index - p.createdAtBar
                
                // Score: Age (0-40), Touches (0-30), Confidence (0-30)
                float age_score = math.min(float(age), 200.0) / 200.0 * 40.0
                float touch_score = math.min(float(p.touchCount), 5.0) / 5.0 * 30.0
                float conf_score = p.confidence * 30.0
                float inst_score = age_score + touch_score + conf_score
                
                string tier_str = "Minor"
                if inst_score >= LIQ_MAJOR_SCORE
                    tier_str := "Major"
                else if inst_score >= LIQ_INTER_SCORE
                    tier_str := "Intermediate"
                
                bool swept = p.isSwept
                bool integ = f_mtf_all_ok()
                
                LiquidityHierarchyInstance e = f_liq_emit(p.id, tier_str, p.priceLevel, swept, integ, inst_score)
                if not na(e)
                    array.push(emitted, e)

    f_liq_prune()

    if bar_index % 50 == 0
        int elapsed = timenow - t0
        HealthPing hp = HealthPing.new(
             P9_LIQ_MODULE,
             array.size(g_liq_registry),
             P9_LIQ_CAP,
             elapsed,
             0, 0, 0, 0)
        array.push(g_p9_health_pings, hp)

    emitted

// Public Readers
f_liq_tier(int poolId) =>
    int idx = f_liq_find(poolId)
    idx == -1 ? "Minor" : array.get(g_liq_tier, idx)

f_liq_swept(int poolId) =>
    int idx = f_liq_find(poolId)
    idx == -1 ? false : array.get(g_liq_swept, idx)

f_liq_integ(int poolId) =>
    int idx = f_liq_find(poolId)
    idx == -1 ? false : array.get(g_liq_integ, idx)

// Execution
array<LiquidityHierarchyInstance> g_liq_emitted = f_compute_liquidity_hierarchy()

