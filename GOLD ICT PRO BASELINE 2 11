    f_m7_record_audit(S, corr_id, "MTF-UPDATE", "MTF Data Fetched")

f_m7_update_fvgs(EngineState S) =>
    bool bull_fvg = low > high[2] and not na(high[2]) and close[1] > open[1]
    bool bear_fvg = high < low[2] and not na(low[2]) and close[1] < open[1]
    
    string pd_zone = S.counters.pd_zone
    int mtf_bias = S.mtf.bias_1
    
    if bull_fvg
        int new_id = S.counters.next_fvg_id
        S.counters.next_fvg_id += 1
        S.counters.fvg_total_emitted += 1
        
        float top = low
        float bot = high[2]
        
        string base_id = "FVG_" + str.tostring(bar_index) + "_BULL"
        string inst_id = base_id + "_v1"
        
        FVGInstance new_fvg = FVGInstance.new(base_id, inst_id, "", "FVG", "M7", bar_index, "ACTIVE", true, "1.0", TD_LONG, top, bot, 0.0, mtf_bias, pd_zone, "N/A", time)
        
        f_push_fvg(g_fvg_registry, new_fvg, MAX_FVG_REGISTRY)
        f_push_string(g_fvg_base_id, base_id, MAX_FVG_REGISTRY)
        f_push_int(g_fvg_ver, 1, MAX_FVG_REGISTRY)
        f_push_float(g_fvg_top, top, MAX_FVG_REGISTRY)
        f_push_float(g_fvg_bot, bot, MAX_FVG_REGISTRY)
        f_push_int(g_fvg_dir, TD_LONG, MAX_FVG_REGISTRY)
        f_push_string(g_fvg_state, "ACTIVE", MAX_FVG_REGISTRY)
        f_push_float(g_fvg_mit_pct, 0.0, MAX_FVG_REGISTRY)
        
        string obj_id = f_format_id("M7-FVG", new_id, 1)
        string corr_id = "M7-FVG-" + str.tostring(bar_index)
        _ = f_emit_engine_event(S, 0, corr_id, MOD_FVG, EVENT_CREATE, SEV_INFO, "SUCCESS", obj_id, "Bullish FVG Created", "{}", true)
        f_m7_record_audit(S, corr_id, obj_id, "Bullish FVG Created")
        
    if bear_fvg
        int new_id = S.counters.next_fvg_id
        S.counters.next_fvg_id += 1
        S.counters.fvg_total_emitted += 1
        
        float top = low[2]
        float bot = high
        
        string base_id = "FVG_" + str.tostring(bar_index) + "_BEAR"
        string inst_id = base_id + "_v1"
        
        FVGInstance new_fvg = FVGInstance.new(base_id, inst_id, "", "FVG", "M7", bar_index, "ACTIVE", true, "1.0", TD_SHORT, top, bot, 0.0, mtf_bias, pd_zone, "N/A", time)
        
        f_push_fvg(g_fvg_registry, new_fvg, MAX_FVG_REGISTRY)
        f_push_string(g_fvg_base_id, base_id, MAX_FVG_REGISTRY)
        f_push_int(g_fvg_ver, 1, MAX_FVG_REGISTRY)
        f_push_float(g_fvg_top, top, MAX_FVG_REGISTRY)
        f_push_float(g_fvg_bot, bot, MAX_FVG_REGISTRY)
        f_push_int(g_fvg_dir, TD_SHORT, MAX_FVG_REGISTRY)
        f_push_string(g_fvg_state, "ACTIVE", MAX_FVG_REGISTRY)
        f_push_float(g_fvg_mit_pct, 0.0, MAX_FVG_REGISTRY)
        
        string obj_id = f_format_id("M7-FVG", new_id, 1)
        string corr_id = "M7-FVG-" + str.tostring(bar_index)
        _ = f_emit_engine_event(S, 0, corr_id, MOD_FVG, EVENT_CREATE, SEV_INFO, "SUCCESS", obj_id, "Bearish FVG Created", "{}", true)
        f_m7_record_audit(S, corr_id, obj_id, "Bearish FVG Created")

    if array.size(g_fvg_registry) > 0
        for i = array.size(g_fvg_registry) - 1 to 0
            FVGInstance fvg = array.get(g_fvg_registry, i)
            INSTR.cur_fvgLoopIter += 1
            if fvg.status == "ACTIVE"
                bool mitigated = false
                if fvg.direction == TD_LONG
                    if low <= fvg.gapTop and close > fvg.gapBottom
                        fvg.mitigationPercent := 100.0
                        fvg.status := "MITIGATED"
                        mitigated := true
                else if fvg.direction == TD_SHORT
                    if high >= fvg.gapBottom and close < fvg.gapTop
                        fvg.mitigationPercent := 100.0
                        fvg.status := "MITIGATED"
                        mitigated := true
                        
                if mitigated
                    array.set(g_fvg_registry, i, fvg)
                    array.set(g_fvg_state, i, "Full") 
                    array.set(g_fvg_mit_pct, i, 100.0)
                    
                    string obj_id = f_format_id("M7-FVG", i, array.get(g_fvg_ver, i))
                    string corr_id = "M7-FVG-MIT-" + str.tostring(bar_index)
                    _ = f_emit_engine_event(S, 0, corr_id, MOD_FVG, EVENT_INVALID, SEV_INFO, "MITIGATED", obj_id, "FVG Mitigated", "{}", true)
                    f_m7_record_audit(S, corr_id, obj_id, "FVG Mitigated")

f_m7_update_obs(EngineState S) =>
    bool bull_ob = close[1] > open[1] and close[2] < open[2] and close > high[1]
    bool bear_ob = close[1] < open[1] and close[2] > open[2] and close < low[1]
    
    string pd_zone = S.counters.pd_zone
    int mtf_bias = S.mtf.bias_1
    
    if bull_ob
        int new_id = S.counters.next_ob_id
        S.counters.next_ob_id += 1
        S.counters.ob_total_emitted += 1
        
        float top = high[2]
        float bot = low[2]
        
        string base_id = "OB_" + str.tostring(bar_index) + "_BULL"
        string inst_id = base_id + "_v1"
        
        OBInstance new_ob = OBInstance.new(base_id, inst_id, "", "OB", "M7", bar_index, "ACTIVE", true, "1.0", TD_LONG, top, bot, 0.0)
        
        f_push_ob(g_ob_registry, new_ob, MAX_OB_REGISTRY)
        f_push_string(g_ob_base_id, base_id, MAX_OB_REGISTRY)
        f_push_int(g_ob_ver, 1, MAX_OB_REGISTRY)
        f_push_int(g_ob_dir, TD_LONG, MAX_OB_REGISTRY)
        f_push_float(g_ob_high, top, MAX_OB_REGISTRY)
        f_push_float(g_ob_low, bot, MAX_OB_REGISTRY)
        f_push_string(g_ob_state, "ACTIVE", MAX_OB_REGISTRY)
        f_push_float(g_ob_mit_pct, 0.0, MAX_OB_REGISTRY)
        
        string obj_id = f_format_id("M7-OB", new_id, 1)
        string corr_id = "M7-OB-" + str.tostring(bar_index)
        _ = f_emit_engine_event(S, 0, corr_id, MOD_OB, EVENT_CREATE, SEV_INFO, "SUCCESS", obj_id, "Bullish OB Created", "{}", true)
        f_m7_record_audit(S, corr_id, obj_id, "Bullish OB Created")
        
    if bear_ob
        int new_id = S.counters.next_ob_id
        S.counters.next_ob_id += 1
        S.counters.ob_total_emitted += 1
        
        float top = high[2]
        float bot = low[2]
        
        string base_id = "OB_" + str.tostring(bar_index) + "_BEAR"
        string inst_id = base_id + "_v1"
        
        OBInstance new_ob = OBInstance.new(base_id, inst_id, "", "OB", "M7", bar_index, "ACTIVE", true, "1.0", TD_SHORT, top, bot, 0.0)
        
        f_push_ob(g_ob_registry, new_ob, MAX_OB_REGISTRY)
        f_push_string(g_ob_base_id, base_id, MAX_OB_REGISTRY)
        f_push_int(g_ob_ver, 1, MAX_OB_REGISTRY)
        f_push_int(g_ob_dir, TD_SHORT, MAX_OB_REGISTRY)
        f_push_float(g_ob_high, top, MAX_OB_REGISTRY)
        f_push_float(g_ob_low, bot, MAX_OB_REGISTRY)
        f_push_string(g_ob_state, "ACTIVE", MAX_OB_REGISTRY)
        f_push_float(g_ob_mit_pct, 0.0, MAX_OB_REGISTRY)
        
        string obj_id = f_format_id("M7-OB", new_id, 1)
        string corr_id = "M7-OB-" + str.tostring(bar_index)
        _ = f_emit_engine_event(S, 0, corr_id, MOD_OB, EVENT_CREATE, SEV_INFO, "SUCCESS", obj_id, "Bearish OB Created", "{}", true)
        f_m7_record_audit(S, corr_id, obj_id, "Bearish OB Created")

    if array.size(g_ob_registry) > 0
        for i = array.size(g_ob_registry) - 1 to 0
            OBInstance ob = array.get(g_ob_registry, i)
            INSTR.cur_obLoopIter += 1
            if ob.status == "ACTIVE"
                bool mitigated = false
                if ob.direction == TD_LONG
                    if low <= ob.obLow
                        ob.mitigationPercent := 100.0
                        ob.status := "MITIGATED"
                        mitigated := true
                else if ob.direction == TD_SHORT
                    if high >= ob.obHigh
                        ob.mitigationPercent := 100.0
                        ob.status := "MITIGATED"
                        mitigated := true
                        
                if mitigated
                    array.set(g_ob_registry, i, ob)
                    array.set(g_ob_state, i, "Full")
                    array.set(g_ob_mit_pct, i, 100.0)
                    
                    string obj_id = f_format_id("M7-OB", i, array.get(g_ob_ver, i))
                    string corr_id = "M7-OB-MIT-" + str.tostring(bar_index)
                    _ = f_emit_engine_event(S, 0, corr_id, MOD_OB, EVENT_INVALID, SEV_INFO, "MITIGATED", obj_id, "OB Mitigated", "{}", true)
                    f_m7_record_audit(S, corr_id, obj_id, "OB Mitigated")

f_m7_coordinator(EngineState S) =>
    f_m7_update_pd(S)
    f_m7_update_mtf(S)
    f_m7_update_fvgs(S)
    f_m7_update_obs(S)

