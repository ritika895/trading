// 13.2 Recommendation Management Logic
f_manage_recommendations(float h, float l, float c) =>
    string logs = ""
    if array.size(g_recommendations) > 0
        for i = 0 to array.size(g_recommendations) - 1
            Recommendation rec = array.get(g_recommendations, i)
            if rec.status == RS_ACTIVE
                // 1. Check Invalidation (Stop Loss hit)
                if rec.candidate.direction == TD_LONG and l <= rec.actualStop
                    rec.status := RS_INVALIDATED
                    logs += str.format("Rec {0} INVALIDATED (SL hit). ", rec.id)
                else if rec.candidate.direction == TD_SHORT and h >= rec.actualStop
                    rec.status := RS_INVALIDATED
                    logs += str.format("Rec {0} INVALIDATED (SL hit). ", rec.id)
                    
                // 2. Check Fulfillment (Take Profit hit)
                else if rec.candidate.direction == TD_LONG and h >= rec.candidate.takeProfit
                    rec.status := RS_FULFILLED
                    logs += str.format("Rec {0} FULFILLED (TP hit). ", rec.id)
                else if rec.candidate.direction == TD_SHORT and l <= rec.candidate.takeProfit
                    rec.status := RS_FULFILLED
                    logs += str.format("Rec {0} FULFILLED (TP hit). ", rec.id)
                    
                // 3. Check Expiration (Max bars active)
                else if bar_index - rec.createdBarIndex > 100
                    rec.status := RS_EXPIRED
                    logs += str.format("Rec {0} EXPIRED (Time limit). ", rec.id)
    logs

