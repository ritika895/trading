int LS_INVALIDATED = 4
int LS_EXPIRED     = 5

// Defines the type of liquidity
int LT_BUY_SIDE  = 0
int LT_SELL_SIDE = 1
int LT_INTERNAL  = 2
int LT_EXTERNAL  = 3

// Defines the active trading session
