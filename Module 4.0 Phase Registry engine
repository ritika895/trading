// =========================================================================
// MODULE 3: SESSION ENGINE
// =========================================================================

// 3.1 Helper: Check if current time is within a range (supports overnight crossing)
f_is_in_range(int cur_mins, int start_mins, int end_mins) =>
    if start_mins <= end_mins
        cur_mins >= start_mins and cur_mins < end_mins
    else
        cur_mins >= start_mins or cur_mins < end_mins

// 3.2 Session Engine Logic (Evaluates the bar's time for deterministic backtesting)
f_run_session_engine() =>
    int cur_hour = hour(time, "UTC")
    int cur_min  = minute(time, "UTC")
    int cur_mins = cur_hour * 60 + cur_min
    int cur_day  = dayofweek(time, "UTC")

    int asian_start  = ASIAN_START_HR * 60 + ASIAN_START_MIN
    int asian_end    = ASIAN_END_HR * 60 + ASIAN_END_MIN
    int london_start = LONDON_START_HR * 60 + LONDON_START_MIN
    int london_end   = LONDON_END_HR * 60 + LONDON_END_MIN
    int ny_start     = NY_START_HR * 60 + NY_START_MIN
    int ny_end       = NY_END_HR * 60 + NY_END_MIN

    bool is_weekend = false
    if cur_day == 7
        is_weekend := true
    else if cur_day == 1
        if cur_mins < (22 * 60)
            is_weekend := true
    else if cur_day == 6
        if cur_mins >= (22 * 60)
            is_weekend := true

    int session = ST_OFF_SESSION
    string status = "CLOSED"

    if not is_weekend
        status := "OPEN"
        if f_is_in_range(cur_mins, ny_start, ny_end)
            session := ST_NEW_YORK
        else if f_is_in_range(cur_mins, london_start, london_end)
            session := ST_LONDON
        else if f_is_in_range(cur_mins, asian_start, asian_end)
            session := ST_ASIAN
        else
            session := ST_OFF_SESSION
            status := "CLOSED"

    string h_str = cur_hour < 10 ? "0" + str.tostring(cur_hour) : str.tostring(cur_hour)
    string m_str = cur_min < 10 ? "0" + str.tostring(cur_min) : str.tostring(cur_min)
    string time_str = h_str + ":" + m_str
    
    [session, status, time_str]

// 3.3 Global State Variables
[g_current_session, g_market_status, g_current_time_str] = f_run_session_engine()

// 3.4 Dashboard Update 
if barstate.islast
    int now_hour = hour(timenow, "UTC")
    int now_min  = minute(timenow, "UTC")
    int now_mins = now_hour * 60 + now_min
    int now_day  = dayofweek(timenow, "UTC")
    
    bool is_weekend_now = false
    if now_day == 7
        is_weekend_now := true
    else if now_day == 1
        if now_mins < (22 * 60)
            is_weekend_now := true
    else if now_day == 6
        if now_mins >= (22 * 60)
            is_weekend_now := true
            
    string display_session_name = "Off Session"
    string display_status = "CLOSED"
    string display_time_str = g_current_time_str
    
    if is_weekend_now
        display_session_name := "Off Session"
        display_status := "CLOSED"
        string h_str = now_hour < 10 ? "0" + str.tostring(now_hour) : str.tostring(now_hour)
        string m_str = now_min < 10 ? "0" + str.tostring(now_min) : str.tostring(now_min)
        display_time_str := h_str + ":" + m_str + " (Wknd)"
    else
        if g_current_session == ST_ASIAN
            display_session_name := "Asian"
        else if g_current_session == ST_LONDON
            display_session_name := "London"
        else if g_current_session == ST_NEW_YORK
            display_session_name := "New York"
        display_status := g_market_status

    table.cell(dash_table, 1, 7, display_session_name, text_color=color.white, text_size=size.tiny)
    table.cell(dash_table, 1, 8, display_status, text_color=display_status == "OPEN" ? color.green : color.red, text_size=size.tiny)
    table.cell(dash_table, 1, 9, display_time_str, text_color=color.white, text_size=size.tiny)


// =========================================================================
// MODULE 4: REGISTRY ENGINE (FUNCTIONAL REDESIGN)
// =========================================================================

// 4.1 Registry State Variables
var array<LiquidityPool> g_registry = array.new<LiquidityPool>()
var int g_next_pool_id = 1
var array<string> g_event_log = array.new<string>()

// 4.2 Registry API: Add
// Pure Function: Computes the new ID and Pool object. Returns both.
// Global state mutation (incrementing ID, pushing to registry) happens in the main pipeline.
f_registry_add(float priceLevel, int poolType, float confidence) =>
    int newId = -1
    LiquidityPool newPool = na
    if array.size(g_registry) < MAX_POOLS
        newId := g_next_pool_id
        newPool := LiquidityPool.new(
             newId, poolType, LS_ACTIVE, priceLevel, 0, confidence, 
             false, bar_index, 0, 0, "INIT", array.new<SwingPoint>()
        )
    [newId, newPool]

// 4.3 Registry API: Get
// Pure Read: Returns the pool object reference.
f_registry_get(int poolId) =>
    LiquidityPool foundPool = na
    if array.size(g_registry) > 0
        for i = 0 to array.size(g_registry) - 1
            LiquidityPool p = array.get(g_registry, i)
            if p.id == poolId
                foundPool := p
                break
    foundPool

// 4.4 Registry API: Update State
// Pine v6 allows mutating UDT fields via reference. Returns the log string for the pipeline to append.
f_registry_update_state(LiquidityPool pool, int newState, string reason) =>
    string logEntry = ""
    if not na(pool)
        int prevState = pool.state
        pool.state := newState
        if newState == LS_SWEPT
            pool.isSwept := true
            pool.sweptAtBar := bar_index
        else if newState == LS_INVALIDATED
            pool.invalidatedAtBar := bar_index
        pool.sweepReasonCode := reason
        logEntry := str.format("{0} - Pool {1} Transition: {2} -> {3} ({4})", bar_index, pool.id, prevState, newState, reason)
    logEntry

// 4.5 Registry API: Find Index for Deletion
// Pure Function: Returns the array index of the pool to delete. Pipeline executes deletion.
f_registry_find_index(int poolId) =>
    int idx = -1
    if array.size(g_registry) > 0
        for i = 0 to array.size(g_registry) - 1
            if array.get(g_registry, i).id == poolId
                idx := i
                break
    idx

// 4.6 Registry Queries
// Counts pools by type (Buy/Sell side)
f_registry_count_by_type(int poolType) =>
    int count = 0
    if array.size(g_registry) > 0
        for i = 0 to array.size(g_registry) - 1
            if array.get(g_registry, i).poolType == poolType
                count += 1
    count

// Counts pools by state (Active, Swept, etc.)
f_registry_count_by_state(int state) =>
    int count = 0
    if array.size(g_registry) > 0
        for i = 0 to array.size(g_registry) - 1
            if array.get(g_registry, i).state == state
                count += 1
    count

// 4.7 Dashboard Integration
// Updates the Liquidity Status section (Rows 11-14) with live registry data.
if barstate.islast
    int bull_count = f_registry_count_by_type(LT_BUY_SIDE)
    int bear_count = f_registry_count_by_type(LT_SELL_SIDE)
    int active_count = f_registry_count_by_state(LS_ACTIVE)
    int swept_count = f_registry_count_by_state(LS_SWEPT)
    
    table.cell(dash_table, 1, 11, str.tostring(bull_count), text_color=color.white, text_size=size.tiny)
    table.cell(dash_table, 1, 12, str.tostring(bear_count), text_color=color.white, text_size=size.tiny)
    table.cell(dash_table, 1, 13, str.tostring(active_count), text_color=color.white, text_size=size.tiny)
    table.cell(dash_table, 1, 14, str.tostring(swept_count), text_color=color.white, text_size=size.tiny)

