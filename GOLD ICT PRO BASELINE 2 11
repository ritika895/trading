    S.mtf.hi_1 := hi1
    S.mtf.lo_1 := lo1
    S.mtf.hi_2 := hi2
    S.mtf.lo_2 := lo2
    S.mtf.hi_3 := hi3
    S.mtf.lo_3 := lo3
    S.mtf.t_1 := time
    S.mtf.t_2 := time
    S.mtf.t_3 := time
