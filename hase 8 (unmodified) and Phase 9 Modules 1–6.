f_get_htf_idx(string tf) =>
    int idx = -1
    if tf == P9_HTF_1
        idx := 0
    else if tf == P9_HTF_2
        idx := 1
    else if tf == P9_HTF_3
        idx := 2
    idx

f_get_htf_raw() =>
    ph = ta.pivothigh(high, SWING_LOOKBACK, SWING_LOOKBACK)
    pl = ta.pivotlow(low, SWING_LOOKBACK, SWING_LOOKBACK)
    [ph, pl, close, time]

// Top-level request.security to avoid conditional execution warnings
[ph1, pl1, c1, t1] = request.security(syminfo.tickerid, P9_HTF_1, f_get_htf_raw())
[ph2, pl2, c2, t2] = request.security(syminfo.tickerid, P9_HTF_2, f_get_htf_raw())
[ph3, pl3, c3, t3] = request.security(syminfo.tickerid, P9_HTF_3, f_get_htf_raw())

f_process_htf(int idx, string tf, float ph, float pl, float c, int t, bool integ) =>
    if not na(ph)
        array.set(g_mtf_last_hi, idx, ph)
    if not na(pl)
        array.set(g_mtf_last_lo, idx, pl)
        
    int prev_bias = array.get(g_mtf_bias, idx)
    int prev_bos = array.get(g_mtf_bos, idx)
    int prev_choch = array.get(g_mtf_choch, idx)
    bool prev_integ = array.get(g_mtf_integ, idx)
    
    int last_t = array.get(g_mtf_last_t, idx)
    if t != last_t
        float last_hi = array.get(g_mtf_last_hi, idx)
        float last_lo = array.get(g_mtf_last_lo, idx)
        
        if not na(last_hi) and c > last_hi
            if prev_bias == TD_SHORT
                array.set(g_mtf_choch, idx, TD_LONG)
            else
                array.set(g_mtf_bos, idx, TD_LONG)
            array.set(g_mtf_bias, idx, TD_LONG)
            
        if not na(last_lo) and c < last_lo
            if prev_bias == TD_LONG
                array.set(g_mtf_choch, idx, TD_SHORT)
            else
                array.set(g_mtf_bos, idx, TD_SHORT)
            array.set(g_mtf_bias, idx, TD_SHORT)
            
        array.set(g_mtf_last_t, idx, t)
        
    array.set(g_mtf_integ, idx, integ)
    
    if array.get(g_mtf_bias, idx) != prev_bias or array.get(g_mtf_bos, idx) != prev_bos or array.get(g_mtf_choch, idx) != prev_choch or array.get(g_mtf_integ, idx) != prev_integ or array.get(g_mtf_ver, idx) == 0
        int newVer = array.get(g_mtf_ver, idx) == 0 ? 1 : array.get(g_mtf_ver, idx) + 1
        array.set(g_mtf_ver, idx, newVer)
        
        string baseId = "MTF-" + tf
        string instId = baseId + "-v" + str.tostring(newVer)
        string prevId = newVer == 1 ? "" : baseId + "-v" + str.tostring(newVer - 1)
        
        MTFStructureInstance inst = MTFStructureInstance.new(
             baseId, instId, prevId,
             "MTFStructure", "MTFStructureAdapter",
             bar_index, "Active", integ,
             "MTFStructureContract-1.0",
             tf, array.get(g_mtf_bias, idx), array.get(g_mtf_bos, idx), array.get(g_mtf_choch, idx), time)
             
        array.push(g_mtf_registry, inst)
        f_p9_log("MTFStructureAdapter", "MTF_EMIT", instId, integ)
        
        if array.size(g_mtf_registry) > 100
            array.shift(g_mtf_registry)

f_compute_mtf_structure() =>
    bool integ = f_check_p8_integ()
    if integ
        f_process_htf(0, P9_HTF_1, ph1, pl1, c1, t1, integ)
        f_process_htf(1, P9_HTF_2, ph2, pl2, c2, t2, integ)
        f_process_htf(2, P9_HTF_3, ph3, pl3, c3, t3, integ)

f_compute_mtf_structure()

f_mtf_bias(string tf) =>
    int idx = f_get_htf_idx(tf)
    idx == -1 ? TD_NEUTRAL : array.get(g_mtf_bias, idx)

f_mtf_all_ok() =>
    bool ok = true
    if array.get(g_mtf_integ, 0) == false or array.get(g_mtf_integ, 1) == false or array.get(g_mtf_integ, 2) == false
        ok := false
    ok


