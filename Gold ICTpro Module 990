    int audit_id = st.audit.next_audit_id
    st.audit.next_audit_id += 1
    st.audit.audit_total_emitted += 1
    st.audit.lifetime_audit_passed += 1
    st.audit.m12_cycle_passed += 1
    st.audit.m12_last_summary := message

    AuditResultInstance audit_result = AuditResultInstance.new(
         audit_id,
         AUDIT_STRUCTURE,
         SEV_INFO,
         AUDIT_PASS,
         object_id,
         "Module 5",
         corr_id,
         message,
         "No action required",
         true,
         AUDIT_SCHEMA_VERSION,
         time,
         bar_index)

    f_push_audit(g_audit_registry, audit_result, MAX_AUDIT_REGISTRY)

f_m5_update_structure(EngineState st) =>
    if barstate.isnew
        st.analytics.val_evals += 1

    st.current_context.barIndex := bar_index
    st.current_context.timeMs := time
    st.current_context.currentPrice := close
    st.current_context.atr := ta.atr(ATR_LENGTH)

    float prior_swing_high = st.structure.last_swing_high_price
    float prior_swing_low = st.structure.last_swing_low_price
    int prior_trend = st.structure.current_trend

    bool bull_break = not na(prior_swing_high) and close > prior_swing_high and close[1] <= prior_swing_high
    bool bear_break = not na(prior_swing_low) and close < prior_swing_low and close[1] >= prior_swing_low

    float confirmed_swing_high = ta.pivothigh(high, SWING_LOOKBACK, SWING_LOOKBACK)
    float confirmed_swing_low = ta.pivotlow(low, SWING_LOOKBACK, SWING_LOOKBACK)

    if not na(confirmed_swing_high)
        st.structure.last_swing_high_price := confirmed_swing_high
        st.structure.last_swing_high_bar := bar_index - SWING_LOOKBACK

    if not na(confirmed_swing_low)
        st.structure.last_swing_low_price := confirmed_swing_low
        st.structure.last_swing_low_bar := bar_index - SWING_LOOKBACK

    if bull_break or bear_break
        int break_direction = bull_break ? TD_LONG : TD_SHORT
        bool is_choch = (break_direction == TD_LONG and prior_trend == TD_SHORT) or (break_direction == TD_SHORT and prior_trend == TD_LONG)
        string structure_type = is_choch ? "CHoCH" : "BOS"
        string object_id = f_format_id("M5-" + structure_type, bar_index, 0)
        string correlation_id = "M5-" + str.tostring(bar_index)
        string message = structure_type + " " + (break_direction == TD_LONG ? "BULLISH" : "BEARISH")

        st.structure.current_trend := break_direction
        st.current_context.marketBias := break_direction
        
        st.current_validation.trend := break_direction
        st.current_trace.trend_str := "PASS"
        
        st.diag.struct_logs := message

        if is_choch
            st.structure.last_choch_dir := break_direction
            if break_direction == TD_LONG
                st.analytics.val_bull_choch += 1
            else if break_direction == TD_SHORT
                st.analytics.val_bear_choch += 1
        else
            st.structure.last_bos_dir := break_direction

        _ = f_emit_engine_event(
             st,
             0,
             correlation_id,
             MOD_MSS,
             EVENT_CREATE,
             SEV_INFO,
             "SUCCESS",
             object_id,
             message,
             "{}",
             true)

        f_m5_record_structure_audit(st, correlation_id, object_id, message)

