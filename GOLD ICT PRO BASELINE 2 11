        f_table_cell(instr_table, 1, 21, str.tostring(INSTR.tot_m9lcPoiIdxScan) + " / " + str.tostring(INSTR.max_m9lcPoiIdxScan))

        f_table_header(instr_table, 0, 22, "M10")
        table.merge_cells(instr_table, 0, 22, 1, 22)
        f_table_cell(instr_table, 0, 23, "Stage-0/4 loop tot/max")
        f_table_cell(instr_table, 1, 23, str.tostring(INSTR.tot_m10s04LoopIter) + " / " + str.tostring(INSTR.max_m10s04LoopIter))
        f_table_cell_color(instr_table, 0, 24, "Dedup CALLS tot/max", color.orange)
        f_table_cell_color(instr_table, 1, 24, str.tostring(INSTR.tot_m10DedupScan) + " / " + str.tostring(INSTR.max_m10DedupScan), color.orange)
