f_bool_icon(bool cond) =>
    cond ? "✅" : "❌"

f_bool_color(bool cond) =>
    cond ? color.green : color.red

f_trace_icon_3way(string traceStr) =>
    str.contains(traceStr, "PASS") ? "✅" : str.contains(traceStr, "WAIT") ? "⏸" : "❌"

f_trace_color_3way(string traceStr) =>
    str.contains(traceStr, "PASS") ? color.green : str.contains(traceStr, "WAIT") ? color.gray : color.red

f_grade_color(string grade) =>
    grade == "A+" ? color.green : grade == "A" ? color.lime : grade == "B" ? color.yellow : color.orange

f_bias_color(int biasVal) =>
    biasVal == TD_LONG ? color.green : biasVal == TD_SHORT ? color.red : color.gray

f_bias_label(int biasVal) =>
    biasVal == TD_LONG ? "Bull" : biasVal == TD_SHORT ? "Bear" : "Neutral"

f_count_not_equal(array<string> arr, string excludeVal) =>
    int cnt = 0
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            if array.get(arr, i) != excludeVal
                cnt += 1
    cnt

f_count_equal(array<string> arr, string matchVal) =>
    int cnt = 0
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            if array.get(arr, i) == matchVal
                cnt += 1
    cnt

f_last_or_na(array<string> arr) =>
    array.size(arr) > 0 ? array.get(arr, array.size(arr) - 1) : "N/A"

// ── Dashboard Update — Main Entry Point ──
f_update_dashboards(EngineState state) =>
    EngineState st = state

    if barstate.isfirst
        table.cell(dash_table, 0, 0, "GOLD ICT PRO - PHASE 9", text_color=color.yellow, text_size=size.small, text_halign=text.align_center)
        table.merge_cells(dash_table, 0, 0, 1, 0)
        string[] headers = array.from(LBL_ENGINE_STAT, LBL_MKT_STRUCT, LBL_LIQ_STAT, LBL_STRAT_ARB, LBL_REC, LBL_PIPE_STAT, LBL_M8_POI, LBL_M9_HIST, LBL_M10_RATING, LBL_M11_EVENTS, LBL_M12_AUDIT, LBL_M13_ANALYTICS)
        int[] start_rows = array.from(1, 6, 14, 22, 31, 37, 44, 57, 63, 73, 83, 92)
        for i = 0 to array.size(headers) - 1
            f_table_header(dash_table, 0, array.get(start_rows, i), array.get(headers, i))
