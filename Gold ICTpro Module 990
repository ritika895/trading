        f_m7_record_audit(S, corr_id, obj_id, "Bullish OB Created")
        
    if bear_ob
        int new_id = S.counters.next_ob_id
        S.counters.next_ob_id += 1
        S.counters.ob_total_emitted += 1
        
        float top = high[2]
        float bot = low[2]
        
        string base_id = "OB_" + str.tostring(bar_index) + "_BEAR"
        string inst_id = base_id + "_v1"
        
        OBInstance new_ob = OBInstance.new(
            base_id, inst_id, "", "OB", "M7", bar_index, "ACTIVE", true, "1.0",
            TD_SHORT, top, bot, 0.0
        )
        
        f_push_ob(g_ob_registry, new_ob, MAX_OB_REGISTRY)
        f_push_string(g_ob_base_id, base_id, MAX_OB_REGISTRY)
        f_push_int(g_ob_ver, 1, MAX_OB_REGISTRY)
        f_push_int(g_ob_dir, TD_SHORT, MAX_OB_REGISTRY)
        f_push_float(g_ob_high, top, MAX_OB_REGISTRY)
        f_push_float(g_ob_low, bot, MAX_OB_REGISTRY)
        f_push_string(g_ob_state, "ACTIVE", MAX_OB_REGISTRY)
        f_push_float(g_ob_mit_pct, 0.0, MAX_OB_REGISTRY)
        
        string obj_id = f_format_id("M7-OB", new_id, 1)
        string corr_id = "M7-OB-" + str.tostring(bar_index)
        _ = f_emit_engine_event(S, 0, corr_id, MOD_OB, EVENT_CREATE, SEV_INFO, "SUCCESS", obj_id, "Bearish OB Created", "{}", true)
        f_m7_record_audit(S, corr_id, obj_id, "Bearish OB Created")

    // Lifecycle Management
    if array.size(g_ob_registry) > 0
        for i = array.size(g_ob_registry) - 1 to 0
            OBInstance ob = array.get(g_ob_registry, i)
            if ob.status == "ACTIVE"
                bool mitigated = false
                if ob.direction == TD_LONG
                    if low <= ob.obLow
                        ob.mitigationPercent := 100.0
                        ob.status := "MITIGATED"
                        mitigated := true
                else if ob.direction == TD_SHORT
                    if high >= ob.obHigh
                        ob.mitigationPercent := 100.0
                        ob.status := "MITIGATED"
                        mitigated := true
                        
                if mitigated
                    array.set(g_ob_registry, i, ob)
                    array.set(g_ob_state, i, "Full")
                    array.set(g_ob_mit_pct, i, 100.0)
                    
                    string obj_id = f_format_id("M7-OB", i, array.get(g_ob_ver, i))
                    string corr_id = "M7-OB-MIT-" + str.tostring(bar_index)
                    _ = f_emit_engine_event(S, 0, corr_id, MOD_OB, EVENT_INVALID, SEV_INFO, "MITIGATED", obj_id, "OB Mitigated", "{}", true)
                    f_m7_record_audit(S, corr_id, obj_id, "OB Mitigated")

// @function Module 7 Coordinator
f_m7_coordinator(EngineState S) =>
    f_m7_update_pd(S)
    f_m7_update_mtf(S)
    f_m7_update_fvgs(S)
    f_m7_update_obs(S)

// ============================================================================
// MODULE 8 — INSTITUTIONAL POI REGISTRY & LIFECYCLE ENGINE
// ============================================================================

// ── M8 Local Constants ──
string POI_ACTIVE          = "ACTIVE"
string POI_TOUCHED         = "TOUCHED"
string POI_MITIGATED       = "MITIGATED"
string POI_INVALIDATED     = "INVALIDATED"
string POI_ARCHIVED        = "ARCHIVED"
string POI_SRC_FVG         = "FVG"
string POI_SRC_OB          = "OB"
int    POI_EXPIRY_BARS     = 150

// ── M8 Extension UDT ──
// Holds fields not present on the frozen POIInstance contract (Module 2).
// Index-synchronized 1:1 with g_poi_registry — pushed/shifted ONLY via
// f_m8_push_poi_registry so the two arrays can never drift apart.
type POIExtension
    string poiBaseId
    int    touchCount
    int    stateChangedBar
    int    mitigatedBar
    int    invalidatedBar
    string invalidationReason
    string liqPoolLink

// ── M8 Owned Registries ──
var array<POIExtension> g_poi_ext_registry = array.new<POIExtension>()
var array<string> g_poi_dedup_keys = array.new<string>()

// ── M8 Helpers ──

f_push_poi_ext(array<POIExtension> registry, POIExtension value, int max_size) =>
    array.push(registry, value)
    POIExtension _shifted = na
    if array.size(registry) > max_size
        _shifted := array.shift(registry)
    _shifted

// @function Records an M8 audit entry. Independent of g_poi_registry — audit
// survives POI eviction because it writes to the shared g_audit_registry.
f_m8_record_audit(EngineState st, string corr_id, string object_id, string status, string message, string recommendation) =>
    int audit_id = st.audit.next_audit_id
    st.audit.next_audit_id += 1
    st.audit.audit_total_emitted += 1

    if status == AUDIT_PASS
        st.audit.lifetime_audit_passed += 1
        st.audit.m12_cycle_passed += 1
    else if status == AUDIT_WARNING
        st.audit.lifetime_audit_warnings += 1
        st.audit.m12_cycle_warnings += 1
    else if status == AUDIT_FAIL
        st.audit.lifetime_audit_failures += 1
        st.audit.m12_cycle_failures += 1
        st.audit.audit_last_failure_msg := message
    else if status == AUDIT_SKIPPED
        st.audit.m12_cycle_skipped += 1
    st.audit.m12_last_summary := message

    AuditResultInstance audit_result = AuditResultInstance.new(
         audit_id,
         AUDIT_REGISTRY,
         status == AUDIT_FAIL ? SEV_ERROR : status == AUDIT_WARNING ? SEV_WARNING : SEV_INFO,
         status,
         object_id,
         "Module 8",
         corr_id,
         message,
         recommendation,
         status != AUDIT_FAIL,
         AUDIT_SCHEMA_VERSION,
         time,
         bar_index)

    AuditResultInstance _shifted = f_push_audit(g_audit_registry, audit_result, MAX_AUDIT_REGISTRY)
    _shifted

// @function Idempotency check — never create two POIs from the same sourceType+sourceBaseId
f_m8_dedup_exists(string dedupKey) =>
    bool found = false
    if array.size(g_poi_dedup_keys) > 0
        for i = 0 to array.size(g_poi_dedup_keys) - 1
            if array.get(g_poi_dedup_keys, i) == dedupKey
                found := true
    found

// @function M8-owned session classification, computed off bar time (not timenow) for replay safety
f_m8_get_session(EngineState st) =>
    int cur_mins = hour(time, syminfo.timezone) * 60 + minute(time, syminfo.timezone)
    int sess = ST_OFF_SESSION
    if f_is_in_range(cur_mins, asian_start, asian_end)
        sess := ST_ASIAN
    if f_is_in_range(cur_mins, london_start, london_end)
        sess := ST_LONDON
    if f_is_in_range(cur_mins, ny_start, ny_end)
        sess := ST_NEW_YORK
    sess

// @function Best-effort correlation to a swept liquidity pool within the POI's price zone (read-only, Module 6 registry)
f_m8_find_liq_link(float zoneHigh, float zoneLow) =>
    string link = "N/A"
    if array.size(g_registry) > 0
        for i = 0 to array.size(g_registry) - 1
            LiquidityPool pool = array.get(g_registry, i)
            if pool.state == LS_SWEPT
                if pool.priceLevel <= zoneHigh and pool.priceLevel >= zoneLow
                    link := "POOL#" + str.tostring(pool.id)
    link

// @function Unified push — keeps g_poi_registry, g_poi_ext_registry, and g_poi_dedup_keys index-synchronized
f_m8_push_poi_registry(POIInstance inst, POIExtension ext, string dedupKey, string baseId, int ver, string state, float poiHigh, float poiLow, int dir, string poiTypeArg, string links, string rationale) =>
    f_push_poi_registry(inst, baseId, ver, state, poiHigh, poiLow, dir, 0, "UNSCORED", poiTypeArg, links, rationale)
    f_push_poi_ext(g_poi_ext_registry, ext, MAX_POI_REGISTRY)
    string _shifted = f_push_string(g_poi_dedup_keys, dedupKey, MAX_POI_REGISTRY)
    _shifted

// @function Validates and creates a POI from a Module 7 source object. No CREATED state —
// only pushed to the registry after validation passes; initial status is ACTIVE.
f_m8_push_poi(EngineState st, string sourceType, string sourceBaseId, int direction, float zoneHigh, float zoneLow, string fvgLink, string obLink) =>
    string dedupKey = sourceType + "|" + sourceBaseId
    bool is_dup = f_m8_dedup_exists(dedupKey)
    bool valid = zoneHigh > zoneLow and (direction == TD_LONG or direction == TD_SHORT) and not is_dup

    string corr_id = "M8-POI-" + str.tostring(bar_index)
    string obj_id_pre = "M8-POI-" + sourceType + "-" + sourceBaseId

    if valid
        int poi_id = st.counters.next_poi_id
        st.counters.next_poi_id += 1
        st.counters.poi_total_emitted += 1

        string base_id = "POI_" + str.tostring(bar_index) + "_" + sourceType + "_" + str.tostring(poi_id)
        string inst_id = base_id + "_v1"
        float center = (zoneHigh + zoneLow) / 2.0
        int sess = f_m8_get_session(st)
        string poi_type_str = sourceType + (direction == TD_LONG ? "_BULL" : "_BEAR")
        string liq_link = f_m8_find_liq_link(zoneHigh, zoneLow)
        string link_field = fvgLink != "" ? fvgLink : obLink

        POIInstance new_poi = POIInstance.new(
             base_id, inst_id, "", "POI", "M8", bar_index, POI_ACTIVE, true, "1.0",
             poi_type_str, direction, zoneHigh, zoneLow, center, sess, st.mtf.bias_1, st.counters.pd_zone,
             "N/A", fvgLink, obLink, "", "", 0, "UNSCORED", "Awaiting Module 10 scoring", corr_id)

        POIExtension new_ext = POIExtension.new(base_id, 0, bar_index, na, na, "", liq_link)

        f_m8_push_poi_registry(new_poi, new_ext, dedupKey, base_id, 1, POI_ACTIVE, zoneHigh, zoneLow, direction, poi_type_str, link_field, "Awaiting Module 10 scoring")

        st.diag.poi_latest_type := poi_type_str
        st.diag.poi_latest_dir := direction
        st.diag.poi_latest_grade := "UNSCORED"
        st.diag.poi_latest_score := 0
        st.diag.poi_latest_rationale := "Structural POI created from " + sourceType

        string msg = "POI Created: " + base_id + " (" + poi_type_str + ")"
        _ = f_emit_engine_event(st, 0, corr_id, MOD_POI, EVENT_CREATE, SEV_INFO, "SUCCESS", base_id, msg, "{}", true)
        _ = f_m8_record_audit(st, corr_id, base_id, AUDIT_PASS, msg, "No action required")
    else if is_dup
        _ = f_m8_record_audit(st, corr_id, obj_id_pre, AUDIT_SKIPPED, "Duplicate POI source rejected: " + dedupKey, "No action required")
    else
        _ = f_m8_record_audit(st, corr_id, obj_id_pre, AUDIT_WARNING, "POI validation failed for " + dedupKey, "Verify source geometry")
        _ = f_emit_engine_event(st, 0, corr_id, MOD_POI, EVENT_WARNING, SEV_WARNING, "REJECTED", obj_id_pre, "POI validation failed", "{}", false)

    valid

// @function Scans Module 7 outputs for objects created on the current confirmed bar and mints POIs.
// Read-only against g_fvg_registry / g_ob_registry — Module 7 is never written to.
f_m8_scan_new_sources(EngineState st) =>
    if barstate.isconfirmed
        if array.size(g_fvg_registry) > 0
            for i = 0 to array.size(g_fvg_registry) - 1
                FVGInstance fvg = array.get(g_fvg_registry, i)
                if fvg.createdAt == bar_index and fvg.status == "ACTIVE"
                    _ = f_m8_push_poi(st, POI_SRC_FVG, fvg.baseId, fvg.direction, fvg.gapTop, fvg.gapBottom, fvg.baseId, "")
        if array.size(g_ob_registry) > 0
            for i = 0 to array.size(g_ob_registry) - 1
                OBInstance ob = array.get(g_ob_registry, i)
                if ob.createdAt == bar_index and ob.status == "ACTIVE"
                    _ = f_m8_push_poi(st, POI_SRC_OB, ob.baseId, ob.direction, ob.obHigh, ob.obLow, "", ob.baseId)
    bool _done = true
    _done

// @function Lifecycle evaluation: touch detection (M8-owned), source-state sync (read-only from M7),
// time-based invalidation, and archival. Skips the creation bar per the one-bar delay guard.
// Gated on barstate.isconfirmed for replay-safe, non-duplicating transitions.
f_m8_evaluate_lifecycle(EngineState st) =>
    if barstate.isconfirmed and array.size(g_poi_registry) > 0
        map<string, int> fvgIdx = map.new<string, int>()
        if array.size(g_fvg_registry) > 0
            for i = 0 to array.size(g_fvg_registry) - 1
                map.put(fvgIdx, array.get(g_fvg_registry, i).baseId, i)

        map<string, int> obIdx = map.new<string, int>()
        if array.size(g_ob_registry) > 0
            for i = 0 to array.size(g_ob_registry) - 1
                map.put(obIdx, array.get(g_ob_registry, i).baseId, i)

        for i = 0 to array.size(g_poi_registry) - 1
            POIInstance poi = array.get(g_poi_registry, i)
            POIExtension ext = array.get(g_poi_ext_registry, i)

            if poi.status != POI_ARCHIVED and bar_index != poi.createdAt

                // ── Touch Detection (M8-owned, independent of Module 7) ──
                bool touched_now = low <= poi.poiHigh and high >= poi.poiLow
                if touched_now and (poi.status == POI_ACTIVE or poi.status == POI_TOUCHED)
                    ext.touchCount += 1
                    if poi.status == POI_ACTIVE
                        poi.status := POI_TOUCHED
                        ext.stateChangedBar := bar_index
                        string t_corr = "M8-LC-" + str.tostring(bar_index)
                        _ = f_emit_engine_event(st, 0, t_corr, MOD_POI, EVENT_EMIT, SEV_INFO, "TOUCHED", poi.baseId, "POI Touched: " + poi.baseId, "{}", true)
                        _ = f_m8_record_audit(st, t_corr, poi.baseId, AUDIT_PASS, "POI transitioned ACTIVE -> TOUCHED", "No action required")

                // ── Source Sync (reads Module 7 state; never mutates it) ──
                bool source_mitigated = false
                bool source_found = false
                if poi.fvgLink != ""
                    if map.contains(fvgIdx, poi.fvgLink)
                        source_found := true
                        FVGInstance src = array.get(g_fvg_registry, map.get(fvgIdx, poi.fvgLink))
                        source_mitigated := src.status == "MITIGATED"
                else if poi.obLink != ""
                    if map.contains(obIdx, poi.obLink)
                        source_found := true
                        OBInstance src = array.get(g_ob_registry, map.get(obIdx, poi.obLink))
                        source_mitigated := src.status == "MITIGATED"

                if not source_found and poi.integrity
                    poi.integrity := false
                    string lost_corr = "M8-LC-" + str.tostring(bar_index)
                    _ = f_emit_engine_event(st, 0, lost_corr, MOD_POI, EVENT_WARNING, SEV_WARNING, "SOURCE_LOST", poi.baseId, "Source object evicted from Module 7 registry", "{}", false)
                    _ = f_m8_record_audit(st, lost_corr, poi.baseId, AUDIT_WARNING, "POI source evicted prior to resolution: " + poi.baseId, "Confidence degraded; consider early archive")

                if source_mitigated and (poi.status == POI_ACTIVE or poi.status == POI_TOUCHED)
                    poi.status := POI_MITIGATED
                    ext.mitigatedBar := bar_index
                    ext.stateChangedBar := bar_index
                    string m_corr = "M8-LC-" + str.tostring(bar_index)
                    _ = f_emit_engine_event(st, 0, m_corr, MOD_POI, EVENT_INVALID, SEV_INFO, "MITIGATED", poi.baseId, "POI Mitigated via source sync: " + poi.baseId, "{}", true)
                    _ = f_m8_record_audit(st, m_corr, poi.baseId, AUDIT_PASS, "POI transitioned -> MITIGATED", "No action required")

                // ── Time-based invalidation for stale, never-touched POIs ──
                if poi.status == POI_ACTIVE and (bar_index - poi.createdAt) > POI_EXPIRY_BARS
                    poi.status := POI_INVALIDATED
                    ext.invalidatedBar := bar_index
                    ext.stateChangedBar := bar_index
                    ext.invalidationReason := "EXPIRED_NO_TOUCH"
                    string inv_corr = "M8-LC-" + str.tostring(bar_index)
                    _ = f_emit_engine_event(st, 0, inv_corr, MOD_POI, EVENT_INVALID, SEV_WARNING, "INVALIDATED", poi.baseId, "POI Invalidated: expired without touch", "{}", true)
                    _ = f_m8_record_audit(st, inv_corr, poi.baseId, AUDIT_PASS, "POI transitioned -> INVALIDATED (EXPIRED_NO_TOUCH)", "No action required")

                // ── Archival — one confirmed bar after MITIGATED/INVALIDATED ──
                if poi.status == POI_MITIGATED and not na(ext.mitigatedBar) and bar_index > ext.mitigatedBar
                    poi.status := POI_ARCHIVED
                    ext.stateChangedBar := bar_index
                    string a_corr = "M8-LC-" + str.tostring(bar_index)
                    _ = f_emit_engine_event(st, 0, a_corr, MOD_POI, EVENT_EMIT, SEV_INFO, "ARCHIVED", poi.baseId, "POI Archived (post-mitigation)", "{}", true)
                    _ = f_m8_record_audit(st, a_corr, poi.baseId, AUDIT_PASS, "POI transitioned MITIGATED -> ARCHIVED", "No action required")
                else if poi.status == POI_INVALIDATED and not na(ext.invalidatedBar) and bar_index > ext.invalidatedBar
                    poi.status := POI_ARCHIVED
                    ext.stateChangedBar := bar_index
                    string a_corr2 = "M8-LC-" + str.tostring(bar_index)
                    _ = f_emit_engine_event(st, 0, a_corr2, MOD_POI, EVENT_EMIT, SEV_INFO, "ARCHIVED", poi.baseId, "POI Archived (post-invalidation)", "{}", true)
                    _ = f_m8_record_audit(st, a_corr2, poi.baseId, AUDIT_PASS, "POI transitioned INVALIDATED -> ARCHIVED", "No action required")

    bool _done = true
    _done

// @function Module 8 Coordinator
f_m8_coordinator(EngineState st) =>
    _ = f_m8_scan_new_sources(st)
    _ = f_m8_evaluate_lifecycle(st)
    bool _done = true
    _done

// ============================================================================
// MODULE 9 — TRADE CANDIDATE QUALIFICATION & LIFECYCLE ENGINE
// (Architecture v1.4 — Frozen; v6-compliance patch: global mutation moved
//  into an M9-owned mutable object, per CE10088)
// ============================================================================

// ── M9 Local Constants ──
string M9_QUALIFIED   = "QUALIFIED"
string M9_CONFIRMED   = "CONFIRMED"
string M9_READY       = "READY"
string M9_TRIGGERED   = "TRIGGERED"
string M9_INVALIDATED = "INVALIDATED"
string M9_EXPIRED     = "EXPIRED"

int    M9_CANDIDATE_EXPIRY_BARS = 150
float  M9_READY_ATR_MULT        = 3.0
int    MAX_M9_REGISTRY          = 100

// ── M9 UDT ──
// §1: direction + structureConfirmed fully cover downstream needs;
// entryZoneHigh/entryZoneLow are snapshotted immutably at creation because
// Module 8 guarantees POI price boundaries do not change after POI_ACTIVE.
type TradeCandidate
    string  baseId
    int     direction
    float   entryZoneHigh
    float   entryZoneLow
    int     createdAt
    string  status
    float   qualificationScore
    bool    structureConfirmed
    string  invalidationReason

// ── M9 Runtime State (CE10088 fix) ──
// Bare `var int` globals cannot be reassigned with `:=` from inside a
// function body in Pine v6 — only fields on a referenced mutable object can.
// g_m9_total_emitted and m9_prev_trend are therefore consolidated into this
// single M9-owned object, mutated exactly where they were mutated before,
// just via field access instead of a bare-global assignment.
type M9RuntimeState
    int total_emitted
    int prev_trend

// ── M9 Owned Registries ──
var array<TradeCandidate> g_m9_registry = array.new<TradeCandidate>()
var array<string> g_m9_dedup_keys = array.new<string>()
var M9RuntimeState g_m9_rt = M9RuntimeState.new(0, TD_NEUTRAL)

// ── M9 Helpers ──

// @function Records an M9 audit entry into the shared audit bus.
f_m9_record_audit(EngineState st, string corr_id, string object_id, string status, string message, string recommendation) =>
    int audit_id = st.audit.next_audit_id
    st.audit.next_audit_id += 1
    st.audit.audit_total_emitted += 1

    if status == AUDIT_PASS
        st.audit.lifetime_audit_passed += 1
        st.audit.m12_cycle_passed += 1
    else if status == AUDIT_WARNING
        st.audit.lifetime_audit_warnings += 1
        st.audit.m12_cycle_warnings += 1
    else if status == AUDIT_FAIL
        st.audit.lifetime_audit_failures += 1
        st.audit.m12_cycle_failures += 1
        st.audit.audit_last_failure_msg := message
    else if status == AUDIT_SKIPPED
        st.audit.m12_cycle_skipped += 1
    st.audit.m12_last_summary := message

    AuditResultInstance audit_result = AuditResultInstance.new(
         audit_id,
         AUDIT_REGISTRY,
         status == AUDIT_FAIL ? SEV_ERROR : status == AUDIT_WARNING ? SEV_WARNING : SEV_INFO,
         status,
         object_id,
         "Module 9",
         corr_id,
         message,
         recommendation,
         status != AUDIT_FAIL,
         AUDIT_SCHEMA_VERSION,
         time,
         bar_index)

    AuditResultInstance _shifted = f_push_audit(g_audit_registry, audit_result, MAX_AUDIT_REGISTRY)
    _shifted

// @function Idempotency check — never create two TradeCandidates from the same source POI baseId
f_m9_dedup_exists(string dedupKey) =>
    bool found = false
    if array.size(g_m9_dedup_keys) > 0
        for i = 0 to array.size(g_m9_dedup_keys) - 1
            if array.get(g_m9_dedup_keys, i) == dedupKey
                found := true
    found

// @function §9 / §5: push a candidate into g_m9_registry, keeping g_m9_dedup_keys
// index-synchronized, and emitting the observable overflow-eviction record for
// any non-terminal candidate shifted out on FIFO overflow.
f_m9_push_candidate(EngineState st, TradeCandidate cand, string dedupKey) =>
    array.push(g_m9_registry, cand)
    array.push(g_m9_dedup_keys, dedupKey)
    if array.size(g_m9_registry) > MAX_M9_REGISTRY
        TradeCandidate evicted = array.shift(g_m9_registry)
        _ = array.shift(g_m9_dedup_keys)
        if evicted.status == M9_QUALIFIED or evicted.status == M9_CONFIRMED or evicted.status == M9_READY
            string ev_corr = "M9-EVICT-" + str.tostring(bar_index)
            _ = f_emit_engine_event(st, 0, ev_corr, MOD_TR, EVENT_WARNING, SEV_WARNING, "EVICTED_OVERFLOW", evicted.baseId, "TradeCandidate evicted on registry overflow (last status: " + evicted.status + ")", "{}", false)
            _ = f_m9_record_audit(st, ev_corr, evicted.baseId, AUDIT_WARNING, "TradeCandidate evicted on overflow, last known status: " + evicted.status, "No action required — registry at capacity")
    true

// @function Stage 1 — Qualification. Scans Module 8's POI registry for POIs created
// on the current confirmed bar and mints TradeCandidates. Read-only against
// g_poi_registry — Module 8 is never written to.
// rt (M9RuntimeState) is a reference to g_m9_rt, threaded in by the coordinator so
// total_emitted can be incremented via field mutation rather than a global reassignment.
f_m9_stage1_qualification(EngineState st, M9RuntimeState rt) =>
    if barstate.isconfirmed
        if array.size(g_poi_registry) > 0
            for i = 0 to array.size(g_poi_registry) - 1
                POIInstance poi = array.get(g_poi_registry, i)
                if poi.createdAt == bar_index and poi.status == POI_ACTIVE
                    string dedupKey = poi.baseId
                    bool is_dup = f_m9_dedup_exists(dedupKey)
                    string q_corr = "M9-Q-" + str.tostring(bar_index)

                    if is_dup
                        _ = f_m9_record_audit(st, q_corr, poi.baseId, AUDIT_SKIPPED, "Duplicate candidate source rejected: " + dedupKey, "No action required")
                    else
                        // Hard gates — both must pass
                        bool poi_valid = poi.status == POI_ACTIVE and poi.integrity == true
                        bool direction_ok = st.structure.current_trend != poi.direction

                        if poi_valid and direction_ok
                            // Soft-penalty scoring
                            bool htf_conflict = poi.direction != st.mtf.bias_1 and st.mtf.bias_1 != TD_NEUTRAL
                            bool pd_conflict  = (poi.direction == TD_LONG and st.counters.pd_zone == "Premium") or (poi.direction == TD_SHORT and st.counters.pd_zone == "Discount")
                            bool off_session  = f_m8_get_session(st) == ST_OFF_SESSION

                            float score = 100.0
                            if htf_conflict
                                score += P_HTF_CONF
                                _ = f_m9_record_audit(st, q_corr, poi.baseId, AUDIT_WARNING, "HTF conflict penalty applied to " + poi.baseId, "No action required")
                            if pd_conflict
                                score += P_PD_CONF
                                _ = f_m9_record_audit(st, q_corr, poi.baseId, AUDIT_WARNING, "PD-array conflict penalty applied to " + poi.baseId, "No action required")
                            if off_session
                                score += P_SESS
                                _ = f_m9_record_audit(st, q_corr, poi.baseId, AUDIT_WARNING, "Off-session penalty applied to " + poi.baseId, "No action required")
                            score := math.max(0.0, math.min(100.0, score))

                            TradeCandidate new_cand = TradeCandidate.new(poi.baseId, poi.direction, poi.poiHigh, poi.poiLow, bar_index, M9_QUALIFIED, score, false, "")
                            _ = f_m9_push_candidate(st, new_cand, dedupKey)
                            rt.total_emitted += 1

                            _ = f_emit_engine_event(st, 0, q_corr, MOD_TR, EVENT_CREATE, SEV_INFO, "SUCCESS", poi.baseId, "TradeCandidate Qualified from " + poi.baseId, "{}", true)
                            _ = f_m9_record_audit(st, q_corr, poi.baseId, AUDIT_PASS, "TradeCandidate Qualified: " + poi.baseId + " score=" + str.tostring(score, "#.#"), "No action required")
                        else
                            string fail_reason = not poi_valid ? "POI_INVALID" : "DIRECTION_FILTER_REJECTED"
                            _ = f_m9_record_audit(st, q_corr, poi.baseId, AUDIT_WARNING, "Candidate rejected: " + fail_reason, "No action required")
    bool _done = true
    _done

// @function Stages 2–4 plus expiry and source-loss handling, evaluated together
// per §3's fixed priority order so at most one state transition occurs per
// candidate per confirmed bar:
//   1) Trigger (CONFIRMED/READY -> TRIGGERED)
//   2) Readiness (CONFIRMED -> READY)
//   3) Confirmation (QUALIFIED -> CONFIRMED)
//   4) Expiry (any non-terminal -> EXPIRED)
//   5) Source-loss / source-resolved (any non-terminal -> INVALIDATED)
// rt.prev_trend is READ here (Stage 2 comparison) but only WRITTEN by the
// coordinator after this function returns — same ordering as before, just
// via a field instead of a bare global.
f_m9_evaluate_lifecycle(EngineState st, M9RuntimeState rt) =>
    if barstate.isconfirmed and array.size(g_m9_registry) > 0
        map<string, int> poiIdx = map.new<string, int>()
        if array.size(g_poi_registry) > 0
            for j = 0 to array.size(g_poi_registry) - 1
                map.put(poiIdx, array.get(g_poi_registry, j).baseId, j)

        for i = 0 to array.size(g_m9_registry) - 1
            TradeCandidate cand = array.get(g_m9_registry, i)
            bool transitioned = false
            bool is_non_terminal = cand.status == M9_QUALIFIED or cand.status == M9_CONFIRMED or cand.status == M9_READY

            // ── Priority 1 — Stage 4: Trigger ──
            if not transitioned and (cand.status == M9_CONFIRMED or cand.status == M9_READY)
                bool triggered = low <= cand.entryZoneHigh and high >= cand.entryZoneLow
                if triggered
                    cand.status := M9_TRIGGERED
                    transitioned := true
                    string t_corr = "M9-TRIG-" + str.tostring(bar_index)
                    _ = f_emit_engine_event(st, 0, t_corr, MOD_TR, EVENT_CREATE, SEV_INFO, "SUCCESS", cand.baseId, "TradeCandidate Triggered: " + cand.baseId, "{}", true)
                    _ = f_m9_record_audit(st, t_corr, cand.baseId, AUDIT_PASS, "TradeCandidate transitioned -> TRIGGERED", "No action required")

            // ── Priority 2 — Stage 3: Readiness ──
            if not transitioned and cand.status == M9_CONFIRMED
                float nearestEdge = cand.direction == TD_LONG ? cand.entryZoneHigh : cand.entryZoneLow
                float distance = cand.direction == TD_LONG ? (close - nearestEdge) : (nearestEdge - close)
                bool ready = distance >= 0 and distance <= (st.current_context.atr * M9_READY_ATR_MULT)
                if ready
                    cand.status := M9_READY
                    transitioned := true
                    string r_corr = "M9-READY-" + str.tostring(bar_index)
                    _ = f_emit_engine_event(st, 0, r_corr, MOD_TR, EVENT_EMIT, SEV_INFO, "READY", cand.baseId, "TradeCandidate Ready: " + cand.baseId, "{}", true)
                    _ = f_m9_record_audit(st, r_corr, cand.baseId, AUDIT_PASS, "TradeCandidate transitioned CONFIRMED -> READY", "No action required")

            // ── Priority 3 — Stage 2: Confirmation ──
            if not transitioned and cand.status == M9_QUALIFIED
                bool confirm = st.structure.current_trend != rt.prev_trend and st.structure.current_trend == cand.direction and bar_index != cand.createdAt
                if confirm
                    cand.status := M9_CONFIRMED
                    cand.structureConfirmed := true
                    transitioned := true
                    string c_corr = "M9-CONF-" + str.tostring(bar_index)
                    _ = f_emit_engine_event(st, 0, c_corr, MOD_TR, EVENT_EMIT, SEV_INFO, "CONFIRMED", cand.baseId, "TradeCandidate Confirmed: " + cand.baseId, "{}", true)
                    _ = f_m9_record_audit(st, c_corr, cand.baseId, AUDIT_PASS, "TradeCandidate transitioned QUALIFIED -> CONFIRMED", "No action required")

            // ── Priority 4 — Expiry ──
            if not transitioned and is_non_terminal
                if bar_index - cand.createdAt > M9_CANDIDATE_EXPIRY_BARS
                    cand.status := M9_EXPIRED
                    cand.invalidationReason := "EXPIRED_NO_TRIGGER"
                    transitioned := true
                    string e_corr = "M9-EXP-" + str.tostring(bar_index)
                    _ = f_emit_engine_event(st, 0, e_corr, MOD_TR, EVENT_INVALID, SEV_WARNING, "EXPIRED", cand.baseId, "TradeCandidate Expired: " + cand.baseId, "{}", true)
                    _ = f_m9_record_audit(st, e_corr, cand.baseId, AUDIT_PASS, "TradeCandidate transitioned -> EXPIRED (EXPIRED_NO_TRIGGER)", "No action required")

            // ── Priority 5 — Source Loss / Source Resolved ──
            // §6: mutually exclusive by construction — existence check first (SOURCE_LOST
            // if it fails), status check only if lookup succeeds (SOURCE_POI_RESOLVED).
            if not transitioned and is_non_terminal
                bool source_found = map.contains(poiIdx, cand.baseId)
                string source_status = source_found ? array.get(g_poi_registry, map.get(poiIdx, cand.baseId)).status : ""
                string inv_reason = ""
                if not source_found
                    inv_reason := "SOURCE_LOST"
                else if source_status == POI_MITIGATED or source_status == POI_INVALIDATED or source_status == POI_ARCHIVED
                    inv_reason := "SOURCE_POI_RESOLVED"

                if inv_reason != ""
                    cand.status := M9_INVALIDATED
                    cand.invalidationReason := inv_reason
                    transitioned := true
                    string inv_corr = "M9-INV-" + str.tostring(bar_index)
                    _ = f_emit_engine_event(st, 0, inv_corr, MOD_TR, EVENT_INVALID, SEV_WARNING, "INVALIDATED", cand.baseId, "TradeCandidate Invalidated: " + cand.baseId + " (" + inv_reason + ")", "{}", true)
                    _ = f_m9_record_audit(st, inv_corr, cand.baseId, AUDIT_WARNING, "TradeCandidate transitioned -> INVALIDATED (" + inv_reason + ")", "No action required")

            array.set(g_m9_registry, i, cand)
    bool _done = true
    _done

// @function Module 9 Coordinator. §7: runs immediately after Module 8, before the
// dashboard. rt.prev_trend is updated exactly once per confirmed bar, after
// lifecycle evaluation has used it for Stage 2's confirmation comparison —
// via field mutation on g_m9_rt instead of a bare-global reassignment.
f_m9_coordinator(EngineState st) =>
    _ = f_m9_stage1_qualification(st, g_m9_rt)
    _ = f_m9_evaluate_lifecycle(st, g_m9_rt)
    if barstate.isconfirmed
        g_m9_rt.prev_trend := st.structure.current_trend
    bool _done = true
    _done

