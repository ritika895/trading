        f_table_cell(instr_table, 1, 25, str.tostring(INSTR.tot_m10PoiIdxScan) + " / " + str.tostring(INSTR.max_m10PoiIdxScan))
        f_table_cell(instr_table, 0, 26, "Stage-5 loop tot/max")
        f_table_cell(instr_table, 1, 26, str.tostring(INSTR.tot_m10s5LoopIter) + " / " + str.tostring(INSTR.max_m10s5LoopIter))

        f_table_header(instr_table, 0, 27, "MAXIMUM OBSERVED REGISTRY SIZE")
        table.merge_cells(instr_table, 0, 27, 1, 27)
        f_table_cell_color(instr_table, 0, 28, "FVG / OB / POI (max size)", color.teal)
        f_table_cell_color(instr_table, 1, 28, str.tostring(INSTR.max_regSizeFvg) + " / " + str.tostring(INSTR.max_regSizeOb) + " / " + str.tostring(INSTR.max_regSizePoi), color.teal)
        f_table_cell_color(instr_table, 0, 29, "M9 cand. / Liq pool (max size)", color.teal)
        f_table_cell_color(instr_table, 1, 29, str.tostring(INSTR.max_regSizeM9) + " / " + str.tostring(INSTR.max_regSizePool), color.teal)
    true

