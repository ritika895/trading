// -------------------------------------------------------------------------
// 1.3 CORE TYPE DEFINITIONS
// -------------------------------------------------------------------------

// Represents a structural swing point on the chart
type SwingPoint
    float price
    int   barIndex
    int   timeMs   
    bool  isHigh

// Represents a liquidity pool in the Registry
type LiquidityPool
    int               id
    int               poolType         
    int               state            
    float             priceLevel
    int               touchCount
    float             confidence
    bool              isSwept
    int               createdAtBar
    int               sweptAtBar
    int               invalidatedAtBar
    string            sweepReasonCode 
    array<SwingPoint> mitigations      

// Represents an immutable snapshot of market context at evaluation time
type ContextSnapshot
    int   barIndex
    int   timeMs           
    float currentPrice
    float atr
    int   currentSession 
    int   marketBias     
    float premiumZone
    float discountZone

// Represents a candidate trade idea from a Strategy
type StrategyCandidate
    int             id
    LiquidityPool   sourcePool
    ContextSnapshot context
    int             direction       
    float           entryPrice
    float           stopLoss
    float           takeProfit
    string          strategyName

// Represents the final output of the pipeline
type Recommendation
    int               id
    StrategyCandidate candidate
    int               status          
    int               createdBarIndex
    float             actualEntry
    float             actualStop


