bool show_m10_debug = input.bool(false, "Show M10 Debug (TEMPORARY)", group="Debug — Remove After Use")

var table m10_debug_table = table.new(position.middle_right, 2, 5, bgcolor=color.new(color.black, 10), border_width=1, border_color=color.new(color.red, 40))

f_m10_debug_panel(EngineState st) =>
    if show_m10_debug
        if barstate.isfirst
            table.cell(m10_debug_table, 0, 0, "M10 DEBUG (TEMP)", text_color=color.red, text_size=size.tiny, bgcolor=color.new(color.maroon, 50))
            table.merge_cells(m10_debug_table, 0, 0, 1, 0)

        if barstate.islast
            int trig_count = 0
            if array.size(g_m9_registry) > 0
                for i = 0 to array.size(g_m9_registry) - 1
                    if array.get(g_m9_registry, i).status == M9_TRIGGERED
                        trig_count += 1

            table.cell(m10_debug_table, 0, 1, "M9 Triggered", text_color=color.white, text_size=size.tiny)
            table.cell(m10_debug_table, 1, 1, str.tostring(trig_count), text_color=color.yellow, text_size=size.tiny)

            table.cell(m10_debug_table, 0, 2, "M10 Dedup Size", text_color=color.white, text_size=size.tiny)
            table.cell(m10_debug_table, 1, 2, str.tostring(array.size(g_m10_dedup_keys)), text_color=color.yellow, text_size=size.tiny)

            table.cell(m10_debug_table, 0, 3, "Trade Rec Registry", text_color=color.white, text_size=size.tiny)
            table.cell(m10_debug_table, 1, 3, str.tostring(array.size(g_trade_rec_registry)), text_color=color.yellow, text_size=size.tiny)

            table.cell(m10_debug_table, 0, 4, "Reject Reason", text_color=color.white, text_size=size.tiny)
            table.cell(m10_debug_table, 1, 4, st.diag.m10_reject_reason, text_color=color.orange, text_size=size.tiny)

